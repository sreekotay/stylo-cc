/* CSS value cells. Plain C on purpose: the engine's @comptime block
 * includes this to bake initial values into struct literals, and the
 * runtime includes it to parse declarations and print computed values.
 * Three cells cover every longhand Stylo exposes to content:
 *   atom  - an interned text (keywords, and anything kept verbatim)
 *   len   - one number with a unit, or a keyword (auto / normal / none)
 *   color - rgba, or currentcolor / none / auto
 */
#ifndef STYLEBENCH_CSSVAL_H
#define STYLEBENCH_CSSVAL_H

#include <stdint.h>
#include <stdio.h>
#include <string.h>

enum { U_NUM = 0, U_PX, U_EM, U_REM, U_PCT, U_CALC };
enum { LKW_NONE = 0, LKW_AUTO, LKW_NORMAL, LKW_NONE_KW, LKW_MAX_CONTENT,
       LKW_MIN_CONTENT, LKW_FIT_CONTENT, LKW_BOLDER, LKW_LIGHTER, N_LKW };
static const char* const LKW_TEXT[N_LKW] = {
    "", "auto", "normal", "none", "max-content", "min-content", "fit-content",
    "bolder", "lighter"
};

/* Specified length is a linear combination of four bases (px / em / rem / %).
 * A plain `2em` is c_em=2; `calc(2em + 4px)` is mixed (unit U_CALC).
 * `v` is the single-basis specified number (same role as before); the c_*
 * coeffs are the specified tuple used to re-resolve. `px` is computed. */
typedef struct {
    float v;
    float px;
    float c_px, c_em, c_rem, c_pct;
    uint8_t unit;
    uint8_t kw;
} CssLen;

enum { CKW_RGB = 0, CKW_CURRENT, CKW_NONE, CKW_AUTO };
typedef struct {
    uint8_t r, g, b, a, kw;
} CssColor;

static const char* cssval_trim(const char* s, size_t* n) {
    while (*n && (s[0] == ' ' || s[0] == '\t' || s[0] == '\n' || s[0] == '\r')) { s++; (*n)--; }
    while (*n && (s[*n - 1] == ' ' || s[*n - 1] == '\t' || s[*n - 1] == '\n' || s[*n - 1] == '\r')) (*n)--;
    return s;
}

static int cssval_eq(const char* s, size_t n, const char* lit) {
    size_t m = strlen(lit);
    if (n != m) return 0;
    for (size_t i = 0; i < n; i++) {
        char a = s[i], b = lit[i];
        if (a >= 'A' && a <= 'Z') a = (char)(a - 'A' + 'a');
        if (a != b) return 0;
    }
    return 1;
}

typedef struct {
    float px, em, rem, pct;
    int is_len;
    int saw_pct;
} CssCalc;

static int cssval_calc_skip(const char* s, size_t n, size_t* i) {
    while (*i < n && (s[*i] == ' ' || s[*i] == '\t' || s[*i] == '\n' || s[*i] == '\r')) (*i)++;
    return *i < n;
}

static int cssval_calc_num(const char* s, size_t n, size_t* i, double* out) {
    size_t k = *i;
    int neg = 0, digits = 0;
    double v = 0;
    if (k < n && (s[k] == '-' || s[k] == '+')) { neg = s[k] == '-'; k++; }
    while (k < n && s[k] >= '0' && s[k] <= '9') { v = v * 10 + (s[k] - '0'); k++; digits++; }
    if (k < n && s[k] == '.') {
        k++;
        double f = 0.1;
        while (k < n && s[k] >= '0' && s[k] <= '9') { v += (s[k] - '0') * f; f *= 0.1; k++; digits++; }
    }
    if (!digits) return 0;
    *out = neg ? -v : v;
    *i = k;
    return 1;
}

static int cssval_calc_expr(const char* s, size_t n, size_t* i, CssCalc* out);

static int cssval_calc_leaf(const char* s, size_t n, size_t* i, CssCalc* out) {
    memset(out, 0, sizeof *out);
    if (!cssval_calc_skip(s, n, i)) return 0;
    int neg = 0;
    while (*i < n && (s[*i] == '+' || s[*i] == '-')) {
        if (s[*i] == '-') neg = !neg;
        (*i)++;
        if (!cssval_calc_skip(s, n, i)) return 0;
    }
    if (*i < n && s[*i] == '(') {
        (*i)++;
        if (!cssval_calc_expr(s, n, i, out)) return 0;
        if (!cssval_calc_skip(s, n, i) || s[*i] != ')') return 0;
        (*i)++;
        if (neg) { out->px = -out->px; out->em = -out->em; out->rem = -out->rem; out->pct = -out->pct; }
        return 1;
    }
    if (*i + 4 <= n &&
        (s[*i] == 'c' || s[*i] == 'C') && (s[*i + 1] == 'a' || s[*i + 1] == 'A') &&
        (s[*i + 2] == 'l' || s[*i + 2] == 'L') && (s[*i + 3] == 'c' || s[*i + 3] == 'C')) {
        *i += 4;
        if (!cssval_calc_skip(s, n, i) || s[*i] != '(') return 0;
        (*i)++;
        if (!cssval_calc_expr(s, n, i, out)) return 0;
        if (!cssval_calc_skip(s, n, i) || s[*i] != ')') return 0;
        (*i)++;
        if (neg) { out->px = -out->px; out->em = -out->em; out->rem = -out->rem; out->pct = -out->pct; }
        return 1;
    }
    double v;
    if (!cssval_calc_num(s, n, i, &v)) return 0;
    if (neg) v = -v;
    if (*i < n && s[*i] == '%') {
        (*i)++;
        out->pct = (float)v;
        out->is_len = 1;
        out->saw_pct = 1;
        return 1;
    }
    if (*i + 3 <= n && (s[*i] == 'r' || s[*i] == 'R') &&
        (s[*i + 1] == 'e' || s[*i + 1] == 'E') && (s[*i + 2] == 'm' || s[*i + 2] == 'M')) {
        *i += 3;
        out->rem = (float)v;
        out->is_len = 1;
        return 1;
    }
    if (*i + 2 <= n && (s[*i] == 'e' || s[*i] == 'E') &&
        (s[*i + 1] == 'm' || s[*i + 1] == 'M')) {
        *i += 2;
        out->em = (float)v;
        out->is_len = 1;
        return 1;
    }
    if (*i + 2 <= n && (s[*i] == 'p' || s[*i] == 'P') &&
        (s[*i + 1] == 'x' || s[*i + 1] == 'X')) {
        *i += 2;
        out->px = (float)v;
        out->is_len = 1;
        return 1;
    }
    out->px = (float)v;
    return 1;
}

static int cssval_calc_term(const char* s, size_t n, size_t* i, CssCalc* out) {
    if (!cssval_calc_leaf(s, n, i, out)) return 0;
    for (;;) {
        size_t save = *i;
        if (!cssval_calc_skip(s, n, i)) { *i = save; return 1; }
        char op = s[*i];
        if (op != '*' && op != '/') { *i = save; return 1; }
        (*i)++;
        CssCalc rhs;
        if (!cssval_calc_leaf(s, n, i, &rhs)) return 0;
        if (op == '*') {
            if (out->is_len && rhs.is_len) return 0;
            if (!out->is_len && rhs.is_len) {
                float k = out->px;
                *out = rhs;
                out->px *= k; out->em *= k; out->rem *= k; out->pct *= k;
            } else {
                if (rhs.is_len) return 0;
                float k = rhs.px;
                out->px *= k; out->em *= k; out->rem *= k; out->pct *= k;
            }
        } else {
            if (rhs.is_len || rhs.px == 0.0f) return 0;
            float k = 1.0f / rhs.px;
            out->px *= k; out->em *= k; out->rem *= k; out->pct *= k;
        }
    }
}

static int cssval_calc_expr(const char* s, size_t n, size_t* i, CssCalc* out) {
    if (!cssval_calc_term(s, n, i, out)) return 0;
    for (;;) {
        size_t save = *i;
        if (!cssval_calc_skip(s, n, i)) { *i = save; return 1; }
        char op = s[*i];
        if (op != '+' && op != '-') { *i = save; return 1; }
        (*i)++;
        CssCalc rhs;
        if (!cssval_calc_term(s, n, i, &rhs)) return 0;
        if (out->is_len != rhs.is_len) return 0;
        float sgn = op == '-' ? -1.0f : 1.0f;
        out->px += sgn * rhs.px;
        out->em += sgn * rhs.em;
        out->rem += sgn * rhs.rem;
        out->pct += sgn * rhs.pct;
        if (rhs.saw_pct) out->saw_pct = 1;
    }
}

static void cssval_len_from_calc(CssLen* o, const CssCalc* c) {
    o->c_px = c->px;
    o->c_em = c->em;
    o->c_rem = c->rem;
    o->c_pct = c->pct;
    int n = 0;
    if (c->px != 0.0f) n++;
    if (c->em != 0.0f) n++;
    if (c->rem != 0.0f) n++;
    if (c->pct != 0.0f) n++;
    if (!c->is_len) {
        o->unit = U_NUM;
        o->v = c->px;
        o->px = c->px;
        return;
    }
    if (n > 1) {
        o->unit = U_CALC;
        o->v = 0;
        o->px = c->px;
        return;
    }
    if (c->em != 0.0f) { o->unit = U_EM; o->v = c->em; }
    else if (c->rem != 0.0f) { o->unit = U_REM; o->v = c->rem; }
    else if (c->pct != 0.0f || (n == 0 && c->saw_pct)) { o->unit = U_PCT; o->v = c->pct; }
    else { o->unit = U_PX; o->v = c->px; o->px = c->px; }
}

static int cssval_parse_calc(const char* s, size_t n, CssLen* out) {
    size_t i = 0;
    CssCalc c;
    if (!cssval_calc_leaf(s, n, &i, &c)) return 0;
    if (!cssval_calc_skip(s, n, &i)) i = n;
    if (i != n) return 0;
    cssval_len_from_calc(out, &c);
    return 1;
}

static int cssval_parse_len(const char* s, size_t n, CssLen* out) {
    s = cssval_trim(s, &n);
    memset(out, 0, sizeof(*out));
    for (int k = 1; k < N_LKW; k++) {
        if (cssval_eq(s, n, LKW_TEXT[k])) {
            out->kw = (uint8_t)k;
            return 1;
        }
    }
    if (!n) return 0;
    if (n >= 4 && (s[0] == 'c' || s[0] == 'C') && (s[1] == 'a' || s[1] == 'A') &&
        (s[2] == 'l' || s[2] == 'L') && (s[3] == 'c' || s[3] == 'C'))
        return cssval_parse_calc(s, n, out);
    size_t i = 0;
    int neg = 0;
    if (s[i] == '-' || s[i] == '+') { neg = s[i] == '-'; i++; }
    double v = 0;
    int digits = 0;
    while (i < n && s[i] >= '0' && s[i] <= '9') { v = v * 10 + (s[i] - '0'); i++; digits++; }
    if (i < n && s[i] == '.') {
        i++;
        double f = 0.1;
        while (i < n && s[i] >= '0' && s[i] <= '9') { v += (s[i] - '0') * f; f *= 0.1; i++; digits++; }
    }
    if (!digits) return 0;
    if (neg) v = -v;
    const char* u = s + i;
    size_t un = n - i;
    if (un == 0) out->unit = U_NUM;
    else if (cssval_eq(u, un, "px")) out->unit = U_PX;
    else if (cssval_eq(u, un, "em")) out->unit = U_EM;
    else if (cssval_eq(u, un, "rem")) out->unit = U_REM;
    else if (un == 1 && u[0] == '%') out->unit = U_PCT;
    else return 0;
    out->v = (float)v;
    if (out->unit == U_PX) { out->c_px = (float)v; out->px = (float)v; }
    else if (out->unit == U_EM) out->c_em = (float)v;
    else if (out->unit == U_REM) out->c_rem = (float)v;
    else if (out->unit == U_PCT) out->c_pct = (float)v;
    else { out->c_px = (float)v; out->px = (float)v; }
    return 1;
}

/* em / rem resolve against a font size; % only on font-size (the caller
 * passes the parent's size as `fs` for that one field). Mixed calc folds
 * em/rem into px; leftover % on a non-font-size length stays for dump. */
static inline void cssval_resolve(CssLen* l, float fs, float root_fs, int pct_of_fs) {
    if (l->kw) return;
    switch (l->unit) {
    case U_EM:  l->px = l->c_em * fs; break;
    case U_REM: l->px = l->c_rem * root_fs; break;
    case U_PCT: if (pct_of_fs) l->px = l->c_pct * fs / 100.0f; break;
    case U_CALC:
        l->px = l->c_px + l->c_em * fs + l->c_rem * root_fs;
        if (pct_of_fs) l->px += l->c_pct * fs / 100.0f;
        break;
    default: break;
    }
}

static int cssval_hex(char c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

static int cssval_parse_num_at(const char* s, size_t n, size_t* i, double* out) {
    size_t k = *i;
    while (k < n && (s[k] == ' ' || s[k] == '\t')) k++;
    size_t start = k;
    double v = 0;
    int neg = 0, digits = 0;
    if (k < n && (s[k] == '-' || s[k] == '+')) { neg = s[k] == '-'; k++; }
    while (k < n && s[k] >= '0' && s[k] <= '9') { v = v * 10 + (s[k] - '0'); k++; digits++; }
    if (k < n && s[k] == '.') {
        k++;
        double f = 0.1;
        while (k < n && s[k] >= '0' && s[k] <= '9') { v += (s[k] - '0') * f; f *= 0.1; k++; digits++; }
    }
    if (!digits) { *i = start; return 0; }
    if (k < n && s[k] == '%') { v = v * 255.0 / 100.0; k++; }
    while (k < n && (s[k] == ' ' || s[k] == '\t')) k++;
    *out = neg ? -v : v;
    *i = k;
    return 1;
}

static uint8_t cssval_clamp255(double v) {
    if (v < 0) return 0;
    if (v > 255) return 255;
    return (uint8_t)(v + 0.5);
}

static int cssval_parse_color(const char* s, size_t n, CssColor* out) {
    s = cssval_trim(s, &n);
    memset(out, 0, sizeof(*out));
    if (cssval_eq(s, n, "currentcolor")) { out->kw = CKW_CURRENT; return 1; }
    if (cssval_eq(s, n, "none")) { out->kw = CKW_NONE; return 1; }
    if (cssval_eq(s, n, "auto")) { out->kw = CKW_AUTO; return 1; }
    if (cssval_eq(s, n, "transparent")) return 1;
    if (cssval_eq(s, n, "black")) { out->a = 255; return 1; }
    if (cssval_eq(s, n, "white")) { out->r = out->g = out->b = out->a = 255; return 1; }
    if (cssval_eq(s, n, "red")) { out->r = 255; out->a = 255; return 1; }
    if (n >= 4 && s[0] == '#') {
        int d[8];
        size_t m = n - 1;
        if (m != 3 && m != 4 && m != 6 && m != 8) return 0;
        for (size_t i = 0; i < m; i++) {
            d[i] = cssval_hex(s[1 + i]);
            if (d[i] < 0) return 0;
        }
        out->a = 255;
        if (m <= 4) {
            out->r = (uint8_t)(d[0] * 17);
            out->g = (uint8_t)(d[1] * 17);
            out->b = (uint8_t)(d[2] * 17);
            if (m == 4) out->a = (uint8_t)(d[3] * 17);
        } else {
            out->r = (uint8_t)(d[0] * 16 + d[1]);
            out->g = (uint8_t)(d[2] * 16 + d[3]);
            out->b = (uint8_t)(d[4] * 16 + d[5]);
            if (m == 8) out->a = (uint8_t)(d[6] * 16 + d[7]);
        }
        return 1;
    }
    if (n >= 5 && (s[0] == 'r' || s[0] == 'R') && (s[1] == 'g' || s[1] == 'G') &&
        (s[2] == 'b' || s[2] == 'B')) {
        size_t i = 3;
        if (i < n && (s[i] == 'a' || s[i] == 'A')) i++;
        while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
        if (i >= n || s[i] != '(') return 0;
        i++;
        double c[4] = { 0, 0, 0, 255 };
        int k = 0;
        for (; k < 4; k++) {
            if (!cssval_parse_num_at(s, n, &i, &c[k])) break;
            if (k == 3) break;
            if (i < n && (s[i] == ',' || s[i] == '/')) { i++; continue; }
            if (i < n && s[i] != ')') continue; /* space separated */
            k++;
            break;
        }
        if (k < 2) return 0;
        if (k == 3) {
            /* alpha given as 0..1 unless it came with % (already scaled) */
            if (c[3] <= 1.0 && !(i > 0 && s[i - 1] == '%')) c[3] = c[3] * 255.0;
        }
        while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
        if (i >= n || s[i] != ')') return 0;
        out->r = cssval_clamp255(c[0]);
        out->g = cssval_clamp255(c[1]);
        out->b = cssval_clamp255(c[2]);
        out->a = cssval_clamp255(c[3]);
        return 1;
    }
    return 0;
}

enum { VAR_CELL = 0, VAR_REF = 1, VAR_CUSTOM = 2 };
#define CSS_MAX_VARS 16

static int cssval_has_var(const char* s, size_t n) {
    for (size_t i = 0; i + 4 <= n; i++) {
        if ((s[i] == 'v' || s[i] == 'V') && (s[i + 1] == 'a' || s[i + 1] == 'A') &&
            (s[i + 2] == 'r' || s[i + 2] == 'R') && s[i + 3] == '(')
            return 1;
    }
    return 0;
}

typedef struct {
    const char* nptr;
    size_t nlen;
    const char* vptr;
    size_t vlen;
} CssVarRef;

static int cssval_var_eq(const char* a, size_t na, const char* b, size_t nb) {
    if (na != nb) return 0;
    return memcmp(a, b, na) == 0;
}

static int cssval_var_lookup(const CssVarRef* vars, int nvar, const char* n, size_t nl) {
    for (int i = 0; i < nvar; i++)
        if (cssval_var_eq(vars[i].nptr, vars[i].nlen, n, nl)) return i;
    return -1;
}

/* Replace each var() with the custom property or its fallback. Cycle
 * or a missing name with no fallback fails (invalid at computed time). */
static int cssval_subst_into(const char* s, size_t n, const CssVarRef* vars, int nvar,
                             const char** stack, size_t* slen, int nd,
                             char* out, size_t cap, size_t* w);

static int cssval_subst_var_call(const char* s, size_t n, size_t* i,
                                 const CssVarRef* vars, int nvar,
                                 const char** stack, size_t* slen, int nd,
                                 char* out, size_t cap, size_t* w) {
    *i += 4;
    while (*i < n && (s[*i] == ' ' || s[*i] == '\t' || s[*i] == '\n' || s[*i] == '\r')) (*i)++;
    size_t ns = *i;
    while (*i < n && s[*i] != ',' && s[*i] != ')' &&
           s[*i] != ' ' && s[*i] != '\t' && s[*i] != '\n' && s[*i] != '\r')
        (*i)++;
    size_t nl = *i - ns;
    while (*i < n && (s[*i] == ' ' || s[*i] == '\t' || s[*i] == '\n' || s[*i] == '\r')) (*i)++;
    const char* fb = 0;
    size_t fbn = 0;
    if (*i < n && s[*i] == ',') {
        (*i)++;
        size_t fs = *i, depth = 0, fe = *i;
        while (*i < n) {
            if (s[*i] == '(') depth++;
            else if (s[*i] == ')') {
                if (!depth) break;
                depth--;
            }
            (*i)++;
            fe = *i;
        }
        fb = s + fs;
        fbn = fe - fs;
        while (fbn && (fb[0] == ' ' || fb[0] == '\t' || fb[0] == '\n' || fb[0] == '\r')) { fb++; fbn--; }
        while (fbn && (fb[fbn - 1] == ' ' || fb[fbn - 1] == '\t' || fb[fbn - 1] == '\n' || fb[fbn - 1] == '\r')) fbn--;
    }
    if (*i >= n || s[*i] != ')') return 0;
    (*i)++;
    if (nl < 2 || s[ns] != '-' || s[ns + 1] != '-') return 0;
    for (int k = 0; k < nd; k++)
        if (cssval_var_eq(stack[k], slen[k], s + ns, nl)) return 0;
    int hit = cssval_var_lookup(vars, nvar, s + ns, nl);
    if (hit >= 0) {
        if (nd >= 8) return 0;
        stack[nd] = s + ns;
        slen[nd] = nl;
        return cssval_subst_into(vars[hit].vptr, vars[hit].vlen, vars, nvar,
                                 stack, slen, nd + 1, out, cap, w);
    }
    if (!fb) return 0;
    return cssval_subst_into(fb, fbn, vars, nvar, stack, slen, nd, out, cap, w);
}

static int cssval_subst_into(const char* s, size_t n, const CssVarRef* vars, int nvar,
                             const char** stack, size_t* slen, int nd,
                             char* out, size_t cap, size_t* w) {
    size_t i = 0;
    while (i < n) {
        if (i + 4 <= n &&
            (s[i] == 'v' || s[i] == 'V') && (s[i + 1] == 'a' || s[i + 1] == 'A') &&
            (s[i + 2] == 'r' || s[i + 2] == 'R') && s[i + 3] == '(') {
            if (!cssval_subst_var_call(s, n, &i, vars, nvar, stack, slen, nd, out, cap, w))
                return 0;
            continue;
        }
        if (*w >= cap) return 0;
        out[(*w)++] = s[i++];
    }
    return 1;
}

static int cssval_subst(const char* s, size_t n, const CssVarRef* vars, int nvar,
                        char* out, size_t cap, size_t* outn) {
    const char* stack[8];
    size_t slen[8];
    *outn = 0;
    if (!cssval_subst_into(s, n, vars, nvar, stack, slen, 0, out, cap, outn)) return 0;
    while (*outn && (out[0] == ' ' || out[0] == '\t' || out[0] == '\n' || out[0] == '\r')) {
        memmove(out, out + 1, --(*outn));
    }
    while (*outn && (out[*outn - 1] == ' ' || out[*outn - 1] == '\t' ||
                     out[*outn - 1] == '\n' || out[*outn - 1] == '\r'))
        (*outn)--;
    return 1;
}

/* One declaration in a rule: which longhand, its importance, and the
 * value in the cell for that longhand's kind. `wide` is a CSS-wide
 * keyword: 1 = initial (the cell is unused). `varkind` is a custom
 * property or a longhand whose specified text still has var(). */
typedef struct {
    uint16_t prop;
    uint8_t imp;
    uint8_t wide;
    uint8_t varkind;
    union {
        int atom;
        CssLen len;
        CssColor color;
    } v;
    CCSlice vname;
    CCSlice raw;
} CssDecl;

/* Output line builder: one computed-style row is a few KB. */
typedef struct {
    char* p;
    size_t n, cap;
} CssOut;

static inline void css_out_bytes(CssOut* o, const char* s, size_t n) {
    if (o->n + n > o->cap) n = o->cap > o->n ? o->cap - o->n : 0;
    memcpy(o->p + o->n, s, n);
    o->n += n;
}

static inline void css_out_str(CssOut* o, const char* s) { css_out_bytes(o, s, strlen(s)); }

static void css_out_num(CssOut* o, double v) {
    char buf[32];
    int n;
    if (v == (double)(long long)v && v > -1e15 && v < 1e15)
        n = snprintf(buf, sizeof buf, "%lld", (long long)v);
    else
        n = snprintf(buf, sizeof buf, "%g", v);
    if (n < 0) n = 0;
    css_out_bytes(o, buf, (size_t)n);
}

static void css_out_len(CssOut* o, const CssLen* l) {
    if (l->kw) { css_out_str(o, LKW_TEXT[l->kw]); return; }
    if (l->unit == U_CALC && l->c_pct != 0.0f) {
        /* Leftover % + folded absolute. Stylo ToCss: calc(% ± px). */
        css_out_str(o, "calc(");
        css_out_num(o, l->c_pct);
        css_out_str(o, "%");
        if (l->px != 0.0f) {
            css_out_str(o, l->px > 0.0f ? " + " : " - ");
            css_out_num(o, l->px > 0.0f ? l->px : -l->px);
            css_out_str(o, "px");
        }
        css_out_str(o, ")");
        return;
    }
    switch (l->unit) {
    case U_NUM: css_out_num(o, l->v); break;
    case U_PCT: css_out_num(o, l->v); css_out_str(o, "%"); break;
    default:    css_out_num(o, l->px); css_out_str(o, "px"); break;
    }
}

static void css_out_color(CssOut* o, const CssColor* c) {
    if (c->kw == CKW_CURRENT) { css_out_str(o, "currentcolor"); return; }
    if (c->kw == CKW_NONE) { css_out_str(o, "none"); return; }
    if (c->kw == CKW_AUTO) { css_out_str(o, "auto"); return; }
    char buf[64];
    int n;
    if (c->a == 255)
        n = snprintf(buf, sizeof buf, "rgb(%d, %d, %d)", c->r, c->g, c->b);
    else if (c->a == 0)
        n = snprintf(buf, sizeof buf, "rgba(%d, %d, %d, 0)", c->r, c->g, c->b);
    else
        n = snprintf(buf, sizeof buf, "rgba(%d, %d, %d, %g)", c->r, c->g, c->b, c->a / 255.0);
    if (n < 0) n = 0;
    css_out_bytes(o, buf, (size_t)n);
}

/* Stylo serializes a string `content` in double quotes. */
static void css_out_content(CssOut* o, const char* s, size_t n) {
    if (n >= 2 && s[0] == '\'' && s[n - 1] == '\'') {
        css_out_str(o, "\"");
        css_out_bytes(o, s + 1, n - 2);
        css_out_str(o, "\"");
        return;
    }
    css_out_bytes(o, s, n);
}

static inline int cssval_len_eq(const CssLen* a, const CssLen* b) {
    return a->kw == b->kw && a->unit == b->unit &&
           a->c_px == b->c_px && a->c_em == b->c_em &&
           a->c_rem == b->c_rem && a->c_pct == b->c_pct;
}

static inline int cssval_color_eq(const CssColor* a, const CssColor* b) {
    return a->kw == b->kw && a->r == b->r && a->g == b->g && a->b == b->b && a->a == b->a;
}

/* Slice-shaped entry points — same layout as CCSlice { const char*; size_t; }. */
static int cssval_parse_len_slice(const char* ptr, size_t len, CssLen* out) {
    return cssval_parse_len(ptr, len, out);
}
static int cssval_parse_color_slice(const char* ptr, size_t len, CssColor* out) {
    return cssval_parse_color(ptr, len, out);
}
static int cssval_has_var_slice(const char* ptr, size_t len) {
    return cssval_has_var(ptr, len);
}

#endif
