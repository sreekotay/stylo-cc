#!ccc ccs
/*
 * StyleBench restyle. Same fixture as stylo-runner.
 * Frame: @grammar + arena views. Packed compounds; subject maps;
 * tokens interned at fill (owned pool, pointer eq); ancestor bloom +
 * inverted parent>* and (subject, left) pair maps; match_from on the join.
 * Specified props match in @parallel for on share canons (same parent +
 * interned tag / id / classes / attrs + revalidation: which sibling-last
 * rules match, since + / ~ are not decided by the ancestor chain). Dirty
 * restyle re-resolves share
 * from the sibling list only. Inherited font-size / line-height /
 * font-weight / visibility / color hop the parent in one serial depth walk.
 * Mutations: redis_idiomatic hold_sorted on node shards; change log at
 * apply_mut; fan-out is the batch transition (all changes vs all undone).
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/stdio.cch>
#include <ccc/script/file.cch>
#include <ccc/cc_exclusive.cch>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_CLASS   32
#define MAX_ATTR    16
#define MAX_SELCOMP 16
#define MAX_ISNOT   4
#define MAX_ALTS    8
#define MAX_SHARDS  64
#define SIB_SLOTS   8

/* The property layer is generated at compile time from Stylo's own
 * longhand table (engine/longhands.cch, written by
 * scripts/gen-longhands.shcc from `stylo-runner --longhands`): one typed
 * struct per Stylo style struct, initial values, and the per-family
 * inherit / resolve / compare / dump code, all straight-line C spliced
 * here. See engine/sty_emit.cch. A node views one struct per family
 * (StyRefs) and owns a pool slot only for families a declaration wrote;
 * everything else is a pointer to the initial struct or to the parent's. */
#include "cssval.cch"
#include "sty_emit.cch"
@comptime {
    cc_emit_cstr(CC_EMIT_AT_COMPTIME_SITE, sty_build());
}

@grammar(rules) Css {~~~~
    top: stylesheet
    stylesheet: collect [any [comment | some wschar | media | rule]]

    wschar: charset [#' ' #'\t' #'\r' #'\n' #'\x0C']
    ws:     any wschar

    hexa:     charset [#'0' - #'9' #'a' - #'f' #'A' - #'F']
    notesc:   complement charset [#'0' - #'9' #'a' - #'f' #'A' - #'F' #'\t' #'\n' #'\r' #'\x0C']
    escape:   [#'\\' [notesc | hexa opt hexa opt hexa opt hexa opt hexa opt hexa]]
    nonascii: complement charset [#'\0' - #'\x7F']

    nmstart: charset [#'_' #'a' - #'z' #'A' - #'Z']
    nmchar:  charset [#'_' #'a' - #'z' #'A' - #'Z' #'0' - #'9' #'-']
    ident:   [opt #'-' nmstart any [nmchar | nonascii | escape]]
    name:    some [nmchar | nonascii | escape]
    digit:   charset [#'0' - #'9']
    number:  keep [opt [#'+' | #'-'] some digit]

    comment: [block_comment | html_comment]
    block_comment: ["/*" any [not "*/" skip] "*/"]
    html_comment:  ["<!--" any [not "-->" skip] "-->"]

    dstr: complement charset [#'"' #'\n' #'\r']
    sstr: complement charset [#'\'' #'\n' #'\r']
    string: [[#'"' keep [any [dstr | nonascii | escape]] #'"']
            | [#'\'' keep [any [sstr | nonascii | escape]] #'\'']]

    type_sel:   keep ident
    universal:  keep #'*'
    hash:       [#'#' keep name]
    class:      [#'.' keep ident]
    attr:       collect [#'[' ws keep ident ws opt [#'=' ws attr_val] ws #']']
    attr_val:   [string | keep ident]
    ; Balanced so :is(:not(.a)) keeps the inner parens. Quoted ')' in an
    ; attribute selector is not accepted (fixtures do not write that).
    parg_atom:  [#'(' parg_body #')' | complement charset [#'(' #')']]
    parg_body:  any parg_atom
    parg:       keep parg_body
    pseudo:     collect [#':' keep ident opt [#'(' parg #')']]
    pelem:      ["::" keep ident]

    compound: collect [
          [type_sel | universal] any [hash | class | attr | pelem | pseudo]
        | some [hash | class | attr | pelem | pseudo]
    ]
    combinator: keep [any wschar [#'>' | #'+' | #'~'] any wschar | some wschar]
    selector:   collect [compound any [combinator compound]]

    custom_prop: ["--" name]
    prop:      keep [ident | custom_prop]
    other_val: keep [some complement charset [#';' #'}' #'!']]
    rgb:       collect ["rgb" ws #'(' ws number ws #',' ws number ws #',' ws number ws #')']
    decl_val:  other_val
    important: collect [#'!' ws "important"]
    ; pad lives on decls — a leading ws on decl is hoisted out of FIRST,
    ; so `any decl` would miss a space after `{`.
    decl:      collect [prop ws #':' ws decl_val ws opt important ws opt #';']
    decls:     collect [ws any [decl ws]]
    rule:      collect [selector ws #'{' decls #'}']
    ; @media (min-width: Npx) { rules } — the one form StyleBench emits.
    ; The sheet may end inside a block; CSS closes it at EOF.
    mq_feat:   keep ident
    mq_px:     keep [some digit]
    media:     collect ["@media" ws #'(' ws mq_feat ws #':' ws mq_px "px" ws #')' ws #'{'
                        any [comment | some wschar | rule] opt #'}']
~~~~}

@grammar(rules) Fixture {~~~~
    top: collect [preamble base_sec css_sec tree_sec opt mut_sec]
    preamble: any [file_comment | blank]
    file_comment: [#'#' charset [#' ' #'\t'] any complement charset [#'\n'] #'\n']
    blank: [any charset [#' ' #'\t'] #'\n']
    base_sec: ["---base---" opt #'\n' keep [any [not "---" skip]]]
    css_sec:  ["---css---"  opt #'\n' keep [any [not "---" skip]]]
    tree_sec: ["---tree---" opt #'\n' keep [any [not "---" skip]]]
    mut_sec:  ["---mut---"  opt #'\n' keep [any skip]]
~~~~}

@grammar(schema) TreeRow {~~~~
    rules [
        digit: charset [#'0' - #'9']
        num:   keep [opt #'-' some digit]
        cell:  keep [any complement charset [#'\t' #'\n']]
        nl:    opt #'\n'
    ]
    idx:     int num #'\t'
    parent:  int num #'\t'
    tag:     cell #'\t'
    dom_id:  cell #'\t'
    classes: cell #'\t'
    attrs:   cell
    nl
~~~~}

typedef struct {
    CCSlice name;
    CCSlice value;
    int equals;
} Attr;

typedef enum {
    MUT_ADD_CLASS = 0,
    MUT_REMOVE_CLASS,
    MUT_SET_ATTR,
    MUT_REMOVE_ATTR,
    MUT_ADD_LEAF,
    MUT_REMOVE_LEAF,
    MUT_RESIZE,
    MUT_RESTYLE
} MutKind;

typedef struct {
    MutKind kind;
    int id, parent, at;
    CCSlice a, b;
    CCSlice classes, attrs;
} MutOp;

/* One filter for both axes (ancestors, preceding siblings). 256 bits:
 * a sibling list of ~20 with ~4 atoms each would saturate 64. */
#define BLOOM_WORDS 4
typedef struct {
    uint64_t w[BLOOM_WORDS];
} Bloom;

typedef struct Rule Rule;

typedef struct {
    int parent;
    int nclass, nattr;
    int cap_class, cap_attr;
    int dead;
    int dirty;
    /* Clean node whose parent's inherited struct changed this restyle:
     * re-inherit only, no match. */
    int inh_dirty;
    int inv_gen;
    int bloom_gen;
    unsigned pos;
    int sib_n;
    int sib_hit[SIB_SLOTS];
    int first_child, last_child, next_sib, prev_sib;
    int depth;
    /* Which longhands a declaration set on this node (holes inherit). */
    uint64_t specified[PS_WORDS];
    /* One struct per family: initial, the parent's, or this node's own
     * pool slot (bit set in `own`). */
    StyRefs sty;
    unsigned own;
    /* The style attribute, parsed once when set. */
    Rule* inline_rule;
    CCSlice tag;
    CCSlice dom_id;
    CCSlice* classes;
    Attr* attrs;
    Bloom self, anc, prevs;
} Node;

/* Unused CSS must stay off the restyle hop. Putting var() tables on Node
 * (~1.3 KB × every element and pseudo box) blew inherit and MUT_BLOOMS
 * on StyleBench sheets that never mention a custom property: same dirty
 * set, fatter stride. Wrapping every compound in an :is walker did the
 * same to TIME_MATCH. So:
 *   has_vars / vtab  — allocated at parse only when a --* or var() is
 *                      seen; inherit / copy / apply no-op while NULL.
 *   has_lists        — set when a compound takes :is / :not / :where;
 *                      match_from is Node_match_compound plus one
 *                      predicted-false branch.
 * calc() is parse-time only (U_CALC never taken on StyleBench lengths).
 * Do not put optional state back on Node or on the unguarded match hop. */
typedef struct {
    CCSlice var_n[CSS_MAX_VARS];
    CCSlice var_v[CSS_MAX_VARS];
    CCSlice var_spec_n[CSS_MAX_VARS];
    CCSlice var_spec_v[CSS_MAX_VARS];
    uint16_t pvar_prop[CSS_MAX_VARS];
    CCSlice pvar_raw[CSS_MAX_VARS];
    int nvar, nvar_spec, npvar;
    int changed;
} NodeVars;

/* Position predicates: a fact about the node's place in its sibling list.
 * Each distinct pseudo the sheet uses is one row — which count it reads
 * (index from the front / back, among all siblings / same type) and the
 * an+b it must satisfy. `first-child` is the row (child, 0n+1); the
 * structural names are the degenerate rows of the same table. Node.pos
 * carries one bit per row, so a compound test is one AND, and a row's
 * interned atom lets the change log / left_rules key on a position flip
 * the same way they key on a class flip. */
enum { PK_CHILD, PK_LAST_CHILD, PK_OF_TYPE, PK_LAST_OF_TYPE, PK_ONLY_OF_TYPE, PK_EMPTY };
typedef struct {
    int kind, a, b;
    CCSlice atom;
} PosPred;
#define MAX_POS 32

/* pelem: 0 none, PE_BEFORE / PE_AFTER — the compound is the subject and
 * the rule's target is that pseudo box of the matched element. */
enum { PE_NONE = 0, PE_BEFORE = 1, PE_AFTER = 2 };
typedef enum { COMB_DESC, COMB_CHILD, COMB_NEXT, COMB_SUBSEQ } Comb;
typedef struct Compound Compound;
/* One alternative of :is() / :not() / :where() — the same compound /
 * combinator walk as a rule, packed on the store. */
typedef struct {
    Compound* c;
    Comb* comb;
    int n, sa, sb, sc;
} InnerSel;
enum { LIST_IS = 0, LIST_NOT = 1, LIST_WHERE = 2 };
/* One :is() / :not() / :where() on a compound: alternatives are OR,
 * lists on the same compound are AND. :is / :not take max specificity
 * of the alts; :where is zero. */
typedef struct {
    int kind, n;
    InnerSel* alts;
} IsList;
typedef struct Compound {
    int star, nclass, nattr;
    int sa, sb, sc;
    unsigned pseudo;
    int pelem;
    CCSlice type;
    CCSlice id;
    CCSlice* classes;
    CCSlice* attr_n;
    CCSlice* attr_v;
    int* attr_eq;
    Bloom need;
    int open;
    IsList* lists;
    int nlist;
} Compound;

typedef struct {
    int star, nclass, nattr;
    int sa, sb, sc;
    unsigned pseudo;
    int pelem;
    CCSlice type;
    CCSlice id;
    CCSlice classes[MAX_CLASS];
    CCSlice attr_n[MAX_ATTR];
    CCSlice attr_v[MAX_ATTR];
    int attr_eq[MAX_ATTR];
    IsList lists[MAX_ISNOT];
    int nlist;
} CompoundScratch;

typedef struct {
    char* subj;
    char* left;
} AtomPair;

static size_t cc_map_key_hash_AtomPair(AtomPair k) {
    uint64_t a = (uint64_t)(uintptr_t)k.subj;
    uint64_t b = (uint64_t)(uintptr_t)k.left;
    uint64_t h = a * 0x9E3779B97F4A7C15ULL ^ b;
    h ^= h >> 33;
    return (size_t)h;
}

static int cc_map_key_eq_AtomPair(AtomPair a, AtomPair b) {
    return a.subj == b.subj && a.left == b.left;
}

enum { ORIGIN_UA = 0, ORIGIN_AUTHOR = 1, ORIGIN_STYLE = 2 };

struct Rule {
    int n, sa, sb, sc, order, origin;
    /* The declaration block: longhands only (shorthands expanded at
     * parse), each with its value cell and importance. */
    CssDecl* decls;
    int ndecl;
    int has_imp;
    Compound* c;
    Comb* comb;
    /* Union of the needs of the trailing run of ancestor compounds (those
     * joined to the subject by ` ` / `>` only): one test against the
     * subject's anc bloom rejects most non-matches before any walk. */
    Bloom anc_need;
    int anc_open;
    /* Target: the element (PE_NONE) or one of its pseudo boxes. */
    int pelem;
    /* Media block the rule sits in (-1 none) and whether that block is
     * currently false for the viewport: an off rule matches nothing. */
    int mq;
    int off;
};

/* One matched rule on its way into the cascade: origin, specificity and
 * order packed so a sort puts the declarations in cascade order. */
typedef struct {
    uint64_t key;
    int rule;
} Hit;
#define HIT_CAP 4096
typedef struct {
    Hit* h[3];
    int n[3];
    int dropped;
} Hits;

/* One `@media (min|max-width: Npx)` condition; rules point at a row. */
typedef struct {
    int is_min;
    int px;
} MqCond;
#define MAX_MQ 64

typedef struct {
    uint64_t h;
    int i;
} ShareEnt;

/* One rule in a changed node's invalidation set: subject key for the
 * per-candidate lookup, reach mask for which candidates it applies to. */
typedef struct {
    const char* key;
    int k;
    int grp;
} InvRule;

/* One changed node's share of a staged invalidation batch: its rule table
 * (a range of fo_rules, sorted, keyless run first). */
typedef struct {
    int rb, re, nopen;
} SrcJob;

/* Smallest fact from apply_mut: this interned atom changed on this node.
 * CH_POS: a sibling's position bits flipped (atom is the row's atom). */
enum { CH_ADD_CLASS = 0, CH_DEL_CLASS = 1, CH_SET_ATTR = 2, CH_DEL_ATTR = 3, CH_POS = 4 };
typedef struct {
    int node;
    int how;
    CCSlice atom;
    CCSlice prev;
    CCSlice next;
    unsigned pos_prev, pos_next;
    /* Class changes: the slot touched. Removal takes classes[0], so order
     * is part of the state and undo / redo must restore it exactly. */
    int idx;
} Change;

typedef struct {
    CCArena store;
    Node* nodes;
    int nnodes, cap_nodes;
    Rule* rules;
    int nrules, cap_rules;
    Map::[CCSlice, CCSlice] pool;
    Map::[CCSlice, Vec::[int]] by_id;
    Map::[CCSlice, Vec::[int]] by_class;
    Map::[CCSlice, Vec::[int]] by_type;
    Map::[CCSlice, Vec::[int]] by_parent_id;
    Map::[CCSlice, Vec::[int]] by_parent_class;
    Map::[CCSlice, Vec::[int]] by_parent_type;
    Map::[AtomPair, Vec::[int]] child_pairs;
    Map::[AtomPair, Vec::[int]] desc_pairs;
    Map::[CCSlice, Vec::[int]] left_rules;
    PosPred preds[MAX_POS];
    int npred;
    MqCond mqs[MAX_MQ];
    int nmq;
    int viewport_w;
    int resized;
    /* Pseudo boxes: two Node records per element slot (2*i + pelem - 1),
     * cascaded like a node, inheriting from the element, never matched
     * as a subject themselves. Their pools sit after the elements' at
     * cap_nodes + 2*i + p. */
    Node* pnodes;
    Vec::[int] universal;
    Map::[CCSlice, Vec::[int]] sib_by_id;
    Map::[CCSlice, Vec::[int]] sib_by_class;
    Map::[CCSlice, Vec::[int]] sib_by_type;
    Vec::[int] sib_universal;
    Change* changes;
    uint64_t* chg_order;
    int nchanges, cap_changes;
    int* inv_ids;
    int* inv_off;
    uint64_t* inv_sig;
    int* rule_gen;
    int* rule_slot;
    InvRule* inv_rules;
    int bloom_stamp;
    /* Staged invalidation batch (see Engine_stage_src). */
    int* fo_ids;
    int* fo_off;
    int* fo_job;
    uint64_t* fo_sig;
    int fo_n, fo_cap;
    InvRule* fo_rules;
    int fo_rn, fo_rcap;
    SrcJob* fo_jobs;
    int fo_njobs, fo_jcap;
    int* leaf_ops;
    int* leaf_op_parent;
    int nleaf_ops, cap_leaf_ops;
    MutOp* muts;
    int nmuts, cap_muts;
    int* level_ids;
    int* level_off;
    int max_depth;
    int levels_stale;
    int has_sib_comb;
    /* Sheet-global: stay 0 / NULL on StyleBench. See NodeVars. */
    int has_vars;
    int has_lists;
    NodeVars* vtab;
    unsigned pseudo_used;
    int inv_stamp;
    int* share_of;
    ShareEnt* share_ents;
    int ncanon;
    /* Atoms: interned value texts; ids below N_STATIC_ATOMS are the
     * compile-time constants (A_block, ...). */
    CCSlice* atoms;
    int natoms, cap_atoms;
    Map::[CCSlice, int] atom_id;
    /* One pool per family the sheet declares: 3 * cap_nodes slots
     * (element, ::before, ::after). Undeclared families stay NULL. */
    void* fpool[N_FAM];
    unsigned fam_used;
    /* `div` without a display declaration is a block: the one UA fact. */
    Sty_box box_block;
    CCSlice ident_div;
    int root;
    /* Per-arm match scratch (Hits) and per-dirty-node inherited-struct
     * snapshots for the changed-children test. */
    Hit* hit_scratch;
    int max_arms;
    StySnap* snaps;
    int* snap_of;
    long cnt_hits_dropped;
    double t_levels, t_share, t_match, t_inherit;
    int last_dirty, sum_dirty;
    double sum_sig, sum_canon, sum_match, sum_copy, sum_inherit;
    double sum_fanout, sum_blooms;
    long cnt_src, cnt_cand, cnt_rules;
    double t0_levels, t0_share, t0_match, t0_inherit;
} Engine;

/* Redis Encode shape: restyle cannot mutate the tree; mut under hold
 * cannot restyle. Same object, narrower names.
 * https://github.com/sreekotay/concurrent-c/blob/main/docs/typehooks-typeviews.md */
@typeview Match on Engine {
    r: intern, match_from, match_lists, match_inner_from, apply_rule, apply_bucket, apply_pair,
       apply_pairs, apply_pairs_other, style_one, cascade, inherit_one,
       inherit_pseudo, mark_children, paint_levels,
       paint_blooms, copy_specified, box_block, ident_div, root, fpool, atoms, atom,
       hit_scratch, snaps, snap_of, has_lists, has_vars, vtab,
       nnodes, nrules, rules, share_of, cap_nodes, pnodes,
       by_id, by_class, by_type, by_parent_id, by_parent_class, by_parent_type,
       child_pairs, desc_pairs, universal, level_ids, level_off, max_depth;
    rw: nodes;
};

@typeview Mutate on Engine {
    r: intern, fill_node, insert_child, dirty_following, ensure_class_cap,
       ensure_attr_cap, apply_mut, log_change, log_pos, repos_family,
       note_leaf_op, push_bucket, set_inline_rule, store, cap_nodes, cap_changes,
       has_sib_comb, pseudo_used;
    rw: nodes, nnodes, nchanges, changes, levels_stale, leaf_ops, leaf_op_parent,
        nleaf_ops, cap_leaf_ops;
};

typedef @typeview(Match) Engine* EngineMatch;
typedef @typeview(Mutate) Engine* EngineMut;

static void !>(CCError) Engine_ingest_muts(Engine* e, char[:] text);
static int Node_match_compound(Node* n, const Compound* c);
static int Engine_match_lists(Engine* e, int idx, const Compound* c);
static int Engine_match_inner_from(Engine* e, int idx, const InnerSel* s, int ci);
static int hop_compound(Engine* e, int idx, const Compound* c);
static int fill_selector(Engine* e, CssNode* nd, Rule* r);
static int fill_inner_sel(Engine* e, CCSlice sel, InnerSel* out);
static int Engine_ensure_class_cap(Engine* e, Node* n, int need);
static int Engine_ensure_attr_cap(Engine* e, Node* n, int need);
static void Engine_insert_child(Engine* e, int parent, int at, int id);
static void Engine_dirty_desc(Engine* e, int src);
static void Engine_dirty_following(Engine* e, int src);
static void Engine_reset_pseudo(Engine* e, int i);
static void Engine_inherit_pseudo(Engine* e, int i, int p);
static void Engine_set_inline_rule(Engine* e, Node* n);
static CCSlice Engine_intern(Engine* e, CCSlice src);
static int fill_rule(Engine* e, CssNode* nd, Rule* r);
static void !>(CCError) Engine_alloc_pools(Engine* e);

/* Relocate {ptr,len} headers on grow. POD — use memcpy, not char[:].copy
 * (that path is non-deterministic under parallel fan-out). */
static int copy_ccslice_arr(CCSlice* dst, const CCSlice* src, int n) {
    if (n > 0) memcpy(dst, src, sizeof(CCSlice) * (size_t)n);
    return 1;
}

/* Value texts interned to small ids; the first N_STATIC_ATOMS are fixed. */
static int Engine_atom(Engine* e, CCSlice text) {
    text = text.trim();
    if (!text.len) text = @slice("normal");
    int* hit = e->atom_id->get_ptr(text);
    if (hit) return *hit;
    CCSlice owned = e->intern(text);
    if (e->natoms >= e->cap_atoms) {
        int cap = e->cap_atoms ? e->cap_atoms * 2 : 1024;
        CCSlice* p = e->store.allocT::[CCSlice](cap);
        if (!p) return A_normal;
        if (e->natoms && !copy_ccslice_arr(p, e->atoms, e->natoms)) return A_normal;
        e->atoms = p;
        e->cap_atoms = cap;
    }
    int id = e->natoms;
    e->atoms[e->natoms++] = owned;
    e->atom_id->insert(owned, id);
    return id;
}

static void Node_reset_style(Node* n) {
    memset(n->specified, 0, sizeof(n->specified));
    n->sty = STY_INIT_REFS;
    n->own = 0;
}

static void nv_reset_spec(NodeVars* v) {
    if (!v) return;
    v->nvar_spec = 0;
    v->npvar = 0;
}

static int Engine_ensure_vars(Engine* e) {
    if (e->vtab) return 1;
    if (!e->cap_nodes) return 1;
    e->vtab = e->store.allocT::[NodeVars](3 * e->cap_nodes);
    if (!e->vtab) return 0;
    memset(e->vtab, 0, sizeof(NodeVars) * (size_t)(3 * e->cap_nodes));
    return 1;
}

static void Engine_note_vars(Engine* e) {
    e->has_vars = 1;
    Engine_ensure_vars(e);
}

static NodeVars* nv_at(Engine* e, int slot) {
    return e->vtab ? &e->vtab[slot] : 0;
}

static CCSlice !>(CCError) CCSlice_read_path(CCSlice* path, CCArena arena) {
    return cc_file_read_path(*path, arena);
}

static CCSlice CssNode_span(CssNode* nd) {
    CCSlice v = cc_slice_empty();
    if (nd) nd->slice(&v);
    return v;
}

static Comb comb_from_span(CCSlice s) {
    @for (ch in s) {
        if (ch == '>') return COMB_CHILD;
        if (ch == '+') return COMB_NEXT;
        if (ch == '~') return COMB_SUBSEQ;
    }
    return COMB_DESC;
}

static size_t find_eq(CCSlice a) {
    @for (i, ch in a) {
        if (ch == '=') return (size_t)i;
    }
    return a.len;
}

static void split_eq(CCSlice a, CCSlice* name, CCSlice* val) {
    size_t eq = find_eq(a);
    *name = a.sub(0, eq);
    *val = eq < a.len ? a.sub(eq + 1, a.len) : cc_slice_empty();
}

static int split_on(CCSlice cell, char delim, int skip_empty, CCSlice* out, int cap) {
    int n = 0;
    size_t i = 0;
    for (;;) {
        if (skip_empty && i >= cell.len) break;
        if (n >= cap) break;
        size_t step = 0;
        int hit = 0;
        @for (ch in cell.sub(i, cell.len)) {
            if (ch == delim) { hit = 1; break; }
            step++;
        }
        size_t j = hit ? i + step : cell.len;
        if (!skip_empty || j > i)
            out[n++] = cell.sub(i, j);
        if (j >= cell.len) break;
        i = j + 1;
    }
    return n;
}

static int split_commas(CCSlice cell, CCSlice* out, int cap) {
    return split_on(cell, ',', 1, out, cap);
}

static int split_tabs(CCSlice line, CCSlice* out, int cap) {
    return split_on(line, '\t', 0, out, cap);
}

static void ingest_skip_line_breaks(CCSlice text, size_t* pos) {
    size_t n = 0;
    @for (ch in text.sub(*pos, text.len)) {
        if (ch != '\n' && ch != '\r') break;
        n++;
    }
    *pos += n;
}

static void ingest_skip_to_eol(CCSlice text, size_t* pos) {
    size_t n = 0;
    @for (ch in text.sub(*pos, text.len)) {
        if (ch == '\n') break;
        n++;
    }
    *pos += n;
}

/* Advance past CR/LF (and # comment lines when skip_hash). Return 0 at EOF. */
static int ingest_skip_blank(CCSlice text, size_t* pos, int skip_hash) {
    for (;;) {
        ingest_skip_line_breaks(text, pos);
        if (*pos >= text.len) return 0;
        if (skip_hash) {
            char first = 0;
            @for (ch in text.sub(*pos, text.len)) {
                first = ch;
                break;
            }
            if (first == '#') {
                ingest_skip_to_eol(text, pos);
                continue;
            }
        }
        return 1;
    }
}

static CCSlice ingest_take_line(CCSlice text, size_t* pos) {
    size_t start = *pos;
    ingest_skip_to_eol(text, pos);
    return text.sub(start, *pos);
}

static int cssval_len_cs(CCSlice s, CssLen* out) {
    return cssval_parse_len_slice(s.ptr, s.len, out);
}
static int cssval_color_cs(CCSlice s, CssColor* out) {
    return cssval_parse_color_slice(s.ptr, s.len, out);
}
static int cssval_has_var_cs(CCSlice s) {
    return cssval_has_var_slice(s.ptr, s.len);
}

/* Top-level commas only — :is(span:nth-child(odd), .a) is two alts. */
static int split_sel_list(CCSlice cell, CCSlice* out, int cap) {
    int n = 0;
    size_t i = 0;
    while (i < cell.len && n < cap) {
        while (i < cell.len && (cell.ptr[i] == ' ' || cell.ptr[i] == '\t' ||
                                cell.ptr[i] == '\n' || cell.ptr[i] == '\r'))
            i++;
        if (i >= cell.len) break;
        size_t start = i;
        int depth = 0;
        while (i < cell.len) {
            char ch = cell.ptr[i];
            if (ch == '(') depth++;
            else if (ch == ')') { if (depth) depth--; }
            else if (ch == ',' && depth == 0) break;
            i++;
        }
        size_t end = i;
        while (end > start && (cell.ptr[end - 1] == ' ' || cell.ptr[end - 1] == '\t' ||
                               cell.ptr[end - 1] == '\n' || cell.ptr[end - 1] == '\r'))
            end--;
        if (end > start) out[n++] = cell.sub(start, end);
        if (i < cell.len && cell.ptr[i] == ',') i++;
    }
    return n;
}

static CCSlice Engine_intern(Engine* e, CCSlice src) {
    if (!src.len || !src.ptr) return cc_slice_empty();
    CCSlice* hit = e->pool->get_ptr(src);
    if (hit) return *hit;
    CCSlice owned = src.clone_into(e->store) !>(err) { return cc_slice_empty(); };
    if (e->pool->insert(owned, owned) != 0) return cc_slice_empty();
    return owned;
}

static int fill_attr(Engine* e, CssNode* nd, CompoundScratch* c) {
    if (c->nattr >= MAX_ATTR) return 0;
    CssNode* name = nd->first();
    if (!name) return 0;
    CCSlice raw_n = name->span();
    c->attr_n[c->nattr] = e->intern(raw_n);
    CssNode* val = name->next(nd);
    if (val) {
        CCSlice raw_v = val->span();
        c->attr_v[c->nattr] = e->intern(raw_v);
        c->attr_eq[c->nattr] = 1;
    } else {
        c->attr_v[c->nattr] = cc_slice_empty();
        c->attr_eq[c->nattr] = 0;
    }
    c->nattr++;
    c->sb++;
    return 1;
}

/* `an+b` as CSS spells it: `2n+1`, `3n`, `-n+3`, `n`, `4`, `odd`, `even`.
 * Whitespace is not drawn by the generator, so none is accepted. */
static int parse_nth(CCSlice s, int* a, int* b) {
    if (s.eq_cstr("odd")) { *a = 2; *b = 1; return 1; }
    if (s.eq_cstr("even")) { *a = 2; *b = 0; return 1; }
    size_t i = 0;
    int sign = 1;
    if (i < s.len) {
        CCSlice head = s.sub(i, s.len);
        if (head.len && (head.ptr[0] == '+' || head.ptr[0] == '-')) {
            sign = head.ptr[0] == '-' ? -1 : 1;
            i++;
        }
    }
    int num = 0, digits = 0;
    while (i < s.len) {
        CCSlice ch = s.sub(i, i + 1);
        if (!ch.len || ch.ptr[0] < '0' || ch.ptr[0] > '9') break;
        num = num * 10 + (ch.ptr[0] - '0');
        digits++;
        i++;
    }
    if (i < s.len) {
        CCSlice head = s.sub(i, s.len);
        if (head.len && head.ptr[0] == 'n') {
            i++;
            *a = sign * (digits ? num : 1);
            if (i == s.len) { *b = 0; return 1; }
            head = s.sub(i, s.len);
            if (!head.len || (head.ptr[0] != '+' && head.ptr[0] != '-')) return 0;
            int bs = head.ptr[0] == '-' ? -1 : 1;
            i++;
            int bn = 0, bd = 0;
            while (i < s.len) {
                CCSlice ch = s.sub(i, i + 1);
                if (!ch.len || ch.ptr[0] < '0' || ch.ptr[0] > '9') break;
                bn = bn * 10 + (ch.ptr[0] - '0');
                bd++;
                i++;
            }
            if (!bd || i != s.len) return 0;
            *b = bs * bn;
            return 1;
        }
    }
    if (!digits || i != s.len) return 0;
    *a = 0;
    *b = sign * num;
    return 1;
}

/* Row of the predicate table for this pseudo, adding it on first sight.
 * -1 when the name is not a position fact this engine knows. */
static int Engine_pos_row(Engine* e, CCSlice name, CCSlice arg) {
    int kind, a = 0, b = 1;
    if (name.eq_cstr("first-child")) kind = PK_CHILD;
    else if (name.eq_cstr("last-child")) kind = PK_LAST_CHILD;
    else if (name.eq_cstr("first-of-type")) kind = PK_OF_TYPE;
    else if (name.eq_cstr("last-of-type")) kind = PK_LAST_OF_TYPE;
    else if (name.eq_cstr("only-of-type")) kind = PK_ONLY_OF_TYPE;
    else if (name.eq_cstr("empty")) kind = PK_EMPTY;
    else if (name.eq_cstr("nth-child")) kind = PK_CHILD;
    else if (name.eq_cstr("nth-last-child")) kind = PK_LAST_CHILD;
    else if (name.eq_cstr("nth-of-type")) kind = PK_OF_TYPE;
    else if (name.eq_cstr("nth-last-of-type")) kind = PK_LAST_OF_TYPE;
    else return -1;
    int nth = name.len > 4 && memcmp(name.ptr, "nth-", 4) == 0;
    if (nth != (arg.len > 0)) return -1;
    if (nth && !parse_nth(arg, &a, &b)) return -1;
    for (int p = 0; p < e->npred; p++)
        if (e->preds[p].kind == kind && e->preds[p].a == a && e->preds[p].b == b) return p;
    if (e->npred >= MAX_POS) return -1;
    char buf[64];
    int len = arg.len
        ? snprintf(buf, sizeof buf, ":%.*s(%.*s)", (int)name.len, name.ptr, (int)arg.len, arg.ptr)
        : snprintf(buf, sizeof buf, ":%.*s", (int)name.len, name.ptr);
    PosPred* pp = &e->preds[e->npred];
    pp->kind = kind;
    pp->a = a;
    pp->b = b;
    pp->atom = e->intern(cc_slice_from_buffer(buf, (size_t)len));
    return e->npred++;
}

/* Wrap `S` as `S{}` and fill it with the sheet grammar — one alternative
 * of :is / :not / :where. Nested lists recurse through fill_pseudo. */
static int fill_inner_sel(Engine* e, CCSlice sel, InnerSel* out) {
    sel = sel.trim();
    if (!sel.len) return 0;
    CCSlice wrap = e->store.alloc_slice_bytes(sel.len + 2);
    if (!wrap.ptr) return 0;
    wrap.sub(0, sel.len).copy(sel) !>(err) { return 0; };
    wrap.sub(sel.len, wrap.len).copy(@slice("{}")) !>(err) { return 0; };
    CssNode* root = Css.parse(wrap.ptr, wrap.len, e->store);
    if (!root) return 0;
    CssNode* sheet = root->first();
    if (sheet && sheet->is_list() && sheet->id() == Css_KEEP_stylesheet)
        root = sheet;
    if (!root || !root->is_list()) return 0;
    CssNode* ch = root->first();
    while (ch) {
        if (ch->is_list() && ch->id() == Css_KEEP_rule) {
            Rule tmp;
            memset(&tmp, 0, sizeof tmp);
            if (!fill_selector(e, ch->first(), &tmp)) return 0;
            if (tmp.pelem) return 0;
            out->c = tmp.c;
            out->comb = tmp.comb;
            out->n = tmp.n;
            out->sa = tmp.sa;
            out->sb = tmp.sb;
            out->sc = tmp.sc;
            return 1;
        }
        ch = ch->next(root);
    }
    return 0;
}

static int spec_gt(int a0, int b0, int c0, int a1, int b1, int c1) {
    if (a0 != a1) return a0 > a1;
    if (b0 != b1) return b0 > b1;
    return c0 > c1;
}

static int fill_pseudo(Engine* e, CssNode* nd, CompoundScratch* c) {
    CssNode* name = nd->first();
    if (!name) return 0;
    CssNode* arg = name->next(nd);
    CCSlice name_s = name->span();
    CCSlice arg_s = cc_slice_empty();
    if (arg) arg_s = arg->span();
    int kind = -1;
    if (name_s.eq_cstr("is")) kind = LIST_IS;
    else if (name_s.eq_cstr("not")) kind = LIST_NOT;
    else if (name_s.eq_cstr("where")) kind = LIST_WHERE;
    if (kind >= 0) {
        if (c->nlist >= MAX_ISNOT) return 0;
        CCSlice alts[MAX_ALTS];
        int na = split_sel_list(arg_s, alts, MAX_ALTS);
        if (na <= 0) return 0;
        InnerSel* packed = e->store.allocT::[InnerSel](na);
        if (!packed) return 0;
        int max_sa = 0, max_sb = 0, max_sc = 0;
        for (int i = 0; i < na; i++) {
            if (!fill_inner_sel(e, alts[i], &packed[i])) return 0;
            if (spec_gt(packed[i].sa, packed[i].sb, packed[i].sc, max_sa, max_sb, max_sc)) {
                max_sa = packed[i].sa;
                max_sb = packed[i].sb;
                max_sc = packed[i].sc;
            }
        }
        IsList* L = &c->lists[c->nlist++];
        e->has_lists = 1;
        L->kind = kind;
        L->n = na;
        L->alts = packed;
        if (kind != LIST_WHERE) {
            c->sa += max_sa;
            c->sb += max_sb;
            c->sc += max_sc;
        }
        return 1;
    }
    int row = e->pos_row(name_s, arg_s);
    if (row < 0) return 0;
    c->pseudo |= 1u << row;
    c->sb++;
    return 1;
}

static int fill_compound(Engine* e, CssNode* nd, CompoundScratch* c) {
    memset(c, 0, sizeof(*c));
    if (!nd || !nd->is_list()) return 0;
    CssNode* ch = nd->first();
    while (ch) {
        int id = ch->id();
        if (ch->is_list()) {
            if (id == Css_KEEP_attr && !fill_attr(e, ch, c)) return 0;
            if (id == Css_KEEP_pseudo && !fill_pseudo(e, ch, c)) return 0;
        } else {
            CCSlice raw = ch->span();
            CCSlice s = e->intern(raw);
            if (id == Css_KEEP_pelem) {
                if (raw.eq_cstr("before")) c->pelem = PE_BEFORE;
                else if (raw.eq_cstr("after")) c->pelem = PE_AFTER;
                else return 0;
                c->sc++;
            } else if (id == Css_KEEP_type_sel) {
                c->type = s;
                c->sc++;
            } else if (id == Css_KEEP_universal) {
                c->star = 1;
            } else if (id == Css_KEEP_hash) {
                c->id = s;
                c->sa++;
            } else if (id == Css_KEEP_class) {
                if (c->nclass >= MAX_CLASS) return 0;
                c->classes[c->nclass++] = s;
                c->sb++;
            }
        }
        ch = ch->next(nd);
    }
    return c->star || c->type.len || c->id.len || c->nclass || c->nattr || c->pseudo || c->pelem || c->nlist;
}

/* Hash the bytes, not the interned pointer: arena addresses change per
 * run, and the pointer hash made the false-positive rate a dice roll. */
static void bloom_add(Bloom* b, CCSlice s) {
    if (!s.ptr || !s.len) return;
    uint64_t h = 0xcbf29ce484222325ULL;
    @for (c in s) {
        h ^= (uint64_t)(unsigned char)c;
        h *= 0x100000001b3ULL;
    }
    h ^= h >> 30;
    h *= 0xbf58476d1ce4e5b9ULL;
    h ^= h >> 27;
    unsigned a = (unsigned)(h & 255u);
    unsigned c = (unsigned)((h >> 8) & 255u);
    b->w[a >> 6] |= 1ULL << (a & 63u);
    b->w[c >> 6] |= 1ULL << (c & 63u);
}

static void bloom_or(Bloom* dst, const Bloom* src) {
    for (int i = 0; i < BLOOM_WORDS; i++)
        dst->w[i] |= src->w[i];
}

static int bloom_empty(const Bloom* b) {
    for (int i = 0; i < BLOOM_WORDS; i++)
        if (b->w[i]) return 0;
    return 1;
}

/* Every bit of need is in have. */
static int bloom_has(const Bloom* have, const Bloom* need) {
    for (int i = 0; i < BLOOM_WORDS; i++)
        if ((have->w[i] & need->w[i]) != need->w[i]) return 0;
    return 1;
}

/* Once per compound at fill; match_from reads it on every hop.
 * :is / :not / :where atoms stay off need — bloom is AND, those lists
 * are OR / negation. */
static void compound_paint_need(Compound* c) {
    Bloom n = {0};
    bloom_add(&n, c->type);
    bloom_add(&n, c->id);
    for (int i = 0; i < c->nclass; i++)
        bloom_add(&n, c->classes[i]);
    for (int i = 0; i < c->nattr; i++)
        bloom_add(&n, c->attr_n[i]);
    c->need = n;
    c->open = bloom_empty(&n);
}

static int pack_compound(CCArena store, CompoundScratch* s, Compound* d) {
    d->star = s->star;
    d->nclass = s->nclass;
    d->nattr = s->nattr;
    d->sa = s->sa;
    d->sb = s->sb;
    d->sc = s->sc;
    d->pseudo = s->pseudo;
    d->pelem = s->pelem;
    d->type = s->type;
    d->id = s->id;
    d->classes = 0;
    d->attr_n = 0;
    d->attr_v = 0;
    d->attr_eq = 0;
    d->nlist = s->nlist;
    d->lists = 0;
    if (s->nlist) {
        d->lists = store.allocT::[IsList](s->nlist);
        if (!d->lists) return 0;
        memcpy(d->lists, s->lists, sizeof(IsList) * (size_t)s->nlist);
    }
    if (s->nclass) {
        d->classes = store.allocT::[CCSlice](s->nclass);
        if (!d->classes) return 0;
        if (!copy_ccslice_arr(d->classes, s->classes, s->nclass)) return 0;
    }
    if (s->nattr) {
        d->attr_n = store.allocT::[CCSlice](s->nattr);
        d->attr_v = store.allocT::[CCSlice](s->nattr);
        d->attr_eq = store.allocT::[int](s->nattr);
        if (!d->attr_n || !d->attr_v || !d->attr_eq) return 0;
        if (!copy_ccslice_arr(d->attr_n, s->attr_n, s->nattr)) return 0;
        if (!copy_ccslice_arr(d->attr_v, s->attr_v, s->nattr)) return 0;
        memcpy(d->attr_eq, s->attr_eq, sizeof(int) * (size_t)s->nattr);
    }
    compound_paint_need(d);
    return 1;
}

static int fill_selector(Engine* e, CssNode* nd, Rule* r) {
    CompoundScratch tmpc[MAX_SELCOMP];
    Comb tmpcomb[MAX_SELCOMP];
    r->n = 0;
    r->sa = r->sb = r->sc = 0;
    r->c = 0;
    r->comb = 0;
    if (!nd || !nd->is_list()) return 0;
    Comb pending = COMB_DESC;
    int have_comb = 0;
    CssNode* ch = nd->first();
    while (ch) {
        int id = ch->id();
        if (ch->is_list() && id == Css_KEEP_compound) {
            if (r->n >= MAX_SELCOMP) return 0;
            if (r->n > 0)
                tmpcomb[r->n - 1] = have_comb ? pending : COMB_DESC;
            if (!fill_compound(e, ch, &tmpc[r->n])) return 0;
            r->sa += tmpc[r->n].sa;
            r->sb += tmpc[r->n].sb;
            r->sc += tmpc[r->n].sc;
            r->n++;
            have_comb = 0;
        } else if (id == Css_KEEP_combinator) {
            pending = comb_from_span(ch->span());
            have_comb = 1;
        }
        ch = ch->next(nd);
    }
    if (r->n <= 0) return 0;
    r->c = e->store.allocT::[Compound](r->n);
    if (!r->c) return 0;
    if (r->n > 1) {
        r->comb = e->store.allocT::[Comb](r->n - 1);
        if (!r->comb) return 0;
        memcpy(r->comb, tmpcomb, sizeof(Comb) * (size_t)(r->n - 1));
    }
    for (int i = 0; i < r->n; i++)
        if (!pack_compound(e->store, &tmpc[i], &r->c[i])) return 0;
    for (int i = 0; i + 1 < r->n; i++)
        if (r->c[i].pelem) return 0; /* a pseudo-element is always last */
    r->pelem = r->c[r->n - 1].pelem;
    return 1;
}

static CCSlice trim_slice(CCSlice s) {
    return s.trim();
}

static int cascade_rank(int origin, int imp) {
    if (imp) {
        if (origin == ORIGIN_UA) return 5;
        if (origin == ORIGIN_STYLE) return 4;
        return 3;
    }
    if (origin == ORIGIN_UA) return 0;
    if (origin == ORIGIN_STYLE) return 2;
    return 1;
}

static int decl_important(CssNode* d, CssNode* val) {
    CssNode* n = val ? val->next(d) : 0;
    if (!n) return 0;
    if (n->is_list() && n->id() == Css_KEEP_important) return 1;
    CCSlice s = trim_slice(n->span());
    return s.eq_cstr("important") || s.eq_cstr("!important");
}

#define DECL_SCRATCH 256
typedef struct {
    CssDecl d[DECL_SCRATCH];
    int n;
} DeclScratch;

/* One longhand declaration into the scratch block. The value is read by
 * the longhand's cell kind; a CSS-wide keyword is `initial` (kept as a
 * flag) or inherit / unset, which for an inherited longhand is the same
 * as saying nothing. A value that does not parse is dropped, as a parser
 * would drop an invalid declaration. */
static int Engine_fill_cell(Engine* e, int prop, CCSlice val, CssDecl* d) {
    val = trim_slice(val);
    if (val.eq_cstr("initial")) {
        d->wide = 1;
        return 1;
    }
    if (val.eq_cstr("inherit") || val.eq_cstr("unset")) {
        if (PROP_INHERITED[prop]) return 0;
        if (val.eq_cstr("unset")) { d->wide = 1; return 1; }
        return 0;
    }
    if (PROP_KIND[prop] == LH_LEN) {
        if (prop == P_font_weight && val.eq_cstr("normal")) val = @slice("400");
        else if (prop == P_font_weight && val.eq_cstr("bold")) val = @slice("700");
        return cssval_len_cs(val, &d->v.len);
    }
    if (PROP_KIND[prop] == LH_COLOR)
        return cssval_color_cs(val, &d->v.color);
    d->v.atom = e->atom(val);
    return 1;
}

static int Engine_take_longhand(Engine* e, DeclScratch* ds, int prop, CCSlice val, int imp) {
    if (prop < 0 || ds->n >= DECL_SCRATCH) return 0;
    CssDecl d;
    memset(&d, 0, sizeof d);
    d.prop = (uint16_t)prop;
    d.imp = (uint8_t)imp;
    val = trim_slice(val);
    if (val.eq_cstr("inherit") && PROP_INHERITED[prop]) return 1;
    if (val.eq_cstr("unset") && PROP_INHERITED[prop]) return 1;
    /* Atoms accept any text, so `overflow: var(--x)` would otherwise stick
     * as the literal. Pending until inherit_one substitutes. */
    if (cssval_has_var_cs(val)) {
        d.varkind = VAR_REF;
        d.raw = e->intern(val);
        Engine_note_vars(e);
        ds->d[ds->n++] = d;
        return 1;
    }
    if (!Engine_fill_cell(e, prop, val, &d)) return 0;
    ds->d[ds->n++] = d;
    return 1;
}

static int bg_is_space(CCSlice c) {
    return c.len && (c.ptr[0] == ' ' || c.ptr[0] == '\t' || c.ptr[0] == '\n' || c.ptr[0] == '\r');
}

static void bg_skip_ws(CCSlice val, size_t* i) {
    while (*i < val.len && bg_is_space(val.sub(*i, *i + 1))) (*i)++;
}

/* One component: whitespace-separated, but `calc()` / `var()` / `rgb()`
 * stay whole (balanced parens). */
static int take_css_token(CCSlice val, size_t* i, CCSlice* tok) {
    bg_skip_ws(val, i);
    if (*i >= val.len) return 0;
    size_t j = *i;
    int depth = 0;
    while (j < val.len) {
        char c = val.ptr[j];
        if (c == '(') depth++;
        else if (c == ')') { if (depth) depth--; }
        else if (depth == 0 && (c == ' ' || c == '\t' || c == '\n' || c == '\r')) break;
        j++;
    }
    *tok = val.sub(*i, j);
    *i = j;
    return 1;
}

static int take_css_tokens(CCSlice val, CCSlice* tok, int cap, int* leftover) {
    size_t i = 0;
    int n = 0;
    while (n < cap && take_css_token(val, &i, &tok[n])) n++;
    bg_skip_ws(val, &i);
    *leftover = i < val.len;
    return n;
}

static CCSlice map_border_width(CCSlice tok) {
    if (tok.eq_cstr("thin")) return @slice("1px");
    if (tok.eq_cstr("medium")) return @slice("3px");
    if (tok.eq_cstr("thick")) return @slice("5px");
    return tok;
}

static int is_border_style_tok(CCSlice tok) {
    return tok.eq_cstr("none") || tok.eq_cstr("hidden") || tok.eq_cstr("dotted") ||
           tok.eq_cstr("dashed") || tok.eq_cstr("solid") || tok.eq_cstr("double") ||
           tok.eq_cstr("groove") || tok.eq_cstr("ridge") || tok.eq_cstr("inset") ||
           tok.eq_cstr("outset");
}

/* Apply n longhands or none — a shorthand is one declaration. */
static int Engine_take_sides(Engine* e, DeclScratch* ds, int* props, CCSlice* toks, int n, int imp) {
    int save = ds->n;
    for (int k = 0; k < n; k++) {
        if (!Engine_take_longhand(e, ds, props[k], toks[k], imp)) {
            ds->n = save;
            return 0;
        }
    }
    return 1;
}

/* 1–4 tokens → top / right / bottom / left. 1 copies to all; 2 is TB / RL;
 * 3 is T / RL / B. Extra tokens drop the shorthand. */
static void Engine_expand_trbl(Engine* e, DeclScratch* ds, CCSlice val, int imp,
                               int t, int r, int b, int l, int map_bw) {
    CCSlice tok[4];
    int leftover = 0;
    int n = take_css_tokens(val, tok, 4, &leftover);
    if (!n || leftover) return;
    if (map_bw)
        for (int k = 0; k < n; k++) tok[k] = map_border_width(tok[k]);
    CCSlice T = tok[0], R = tok[0], B = tok[0], L = tok[0];
    if (n == 2) { R = L = tok[1]; }
    else if (n == 3) { R = L = tok[1]; B = tok[2]; }
    else if (n == 4) { R = tok[1]; B = tok[2]; L = tok[3]; }
    int props[4];
    CCSlice toks[4];
    props[0] = t; toks[0] = T;
    props[1] = r; toks[1] = R;
    props[2] = b; toks[2] = B;
    props[3] = l; toks[3] = L;
    Engine_take_sides(e, ds, props, toks, 4, imp);
}

/* 1–2 tokens of the same cell: one copies to both. */
static void Engine_expand_pair(Engine* e, DeclScratch* ds, CCSlice val, int imp,
                               int first, int second) {
    CCSlice tok[2];
    int leftover = 0;
    int n = take_css_tokens(val, tok, 2, &leftover);
    if (!n || leftover) return;
    if (n == 1) tok[1] = tok[0];
    int props[2];
    props[0] = first;
    props[1] = second;
    Engine_take_sides(e, ds, props, tok, 2, imp);
}

enum { BT_FAIL = 0, BT_W, BT_S, BT_C, BT_VAR };

static int border_tok_kind(CCSlice tok) {
    if (is_border_style_tok(tok)) return BT_S;
    if (tok.eq_cstr("thin") || tok.eq_cstr("medium") || tok.eq_cstr("thick")) return BT_W;
    CssLen ln;
    if (cssval_len_cs(tok, &ln) && !ln.kw) return BT_W;
    CssColor c;
    if (cssval_color_cs(tok, &c) && c.kw != CKW_NONE && c.kw != CKW_AUTO) return BT_C;
    if (cssval_has_var_cs(tok)) return BT_VAR;
    return BT_FAIL;
}

/* width / style / color for one side. Missing pieces are medium / none /
 * currentcolor. A lone `var()` is dropped (cannot tell which cell). */
static int Engine_parse_border_triple(CCSlice val, CCSlice* w, CCSlice* s, CCSlice* c) {
    CCSlice tok[4];
    int leftover = 0;
    int n = take_css_tokens(val, tok, 4, &leftover);
    if (!n || leftover) return 0;
    int got_w = 0, got_s = 0, got_c = 0;
    *w = @slice("3px");
    *s = @slice("none");
    *c = @slice("currentcolor");
    for (int k = 0; k < n; k++) {
        int kind = border_tok_kind(tok[k]);
        if (kind == BT_VAR) {
            int miss = !got_w + !got_s + !got_c;
            if (miss != 1) return 0;
            if (!got_w) { *w = tok[k]; got_w = 1; }
            else if (!got_s) { *s = tok[k]; got_s = 1; }
            else { *c = tok[k]; got_c = 1; }
            continue;
        }
        if (kind == BT_W && !got_w) { *w = map_border_width(tok[k]); got_w = 1; continue; }
        if (kind == BT_S && !got_s) { *s = tok[k]; got_s = 1; continue; }
        if (kind == BT_C && !got_c) { *c = tok[k]; got_c = 1; continue; }
        return 0;
    }
    return 1;
}

static void Engine_expand_border_side(Engine* e, DeclScratch* ds, CCSlice val, int imp,
                                      int wp, int sp, int cp) {
    CCSlice w, s, c;
    if (!Engine_parse_border_triple(val, &w, &s, &c)) return;
    int props[3];
    CCSlice toks[3];
    props[0] = wp; toks[0] = w;
    props[1] = sp; toks[1] = s;
    props[2] = cp; toks[2] = c;
    Engine_take_sides(e, ds, props, toks, 3, imp);
}

/* `border`: the triple on every side, and border-image-* back to initial. */
static void Engine_expand_border(Engine* e, DeclScratch* ds, CCSlice val, int imp) {
    CCSlice w, s, c;
    if (!Engine_parse_border_triple(val, &w, &s, &c)) return;
    int wp[4], sp[4], cp[4];
    wp[0] = P_border_top_width;    wp[1] = P_border_right_width;
    wp[2] = P_border_bottom_width; wp[3] = P_border_left_width;
    sp[0] = P_border_top_style;    sp[1] = P_border_right_style;
    sp[2] = P_border_bottom_style; sp[3] = P_border_left_style;
    cp[0] = P_border_top_color;    cp[1] = P_border_right_color;
    cp[2] = P_border_bottom_color; cp[3] = P_border_left_color;
    CCSlice wt[4], st[4], ct[4];
    for (int k = 0; k < 4; k++) { wt[k] = w; st[k] = s; ct[k] = c; }
    if (!Engine_take_sides(e, ds, wp, wt, 4, imp)) return;
    if (!Engine_take_sides(e, ds, sp, st, 4, imp)) return;
    if (!Engine_take_sides(e, ds, cp, ct, 4, imp)) return;
    Engine_take_longhand(e, ds, P_border_image_outset, @slice("initial"), imp);
    Engine_take_longhand(e, ds, P_border_image_repeat, @slice("initial"), imp);
    Engine_take_longhand(e, ds, P_border_image_slice, @slice("initial"), imp);
    Engine_take_longhand(e, ds, P_border_image_source, @slice("initial"), imp);
    Engine_take_longhand(e, ds, P_border_image_width, @slice("initial"), imp);
}

/* `background`: every background longhand resets, the color comes from
 * the first color token (hex / rgb() / currentcolor / transparent). */
static void Engine_expand_background(Engine* e, DeclScratch* ds, CCSlice val, int imp) {
    for (int p = 0; p < NPROP; p++) {
        if (PROP_FAM[p] != FAM_background) continue;
        if (p == P_background_color) continue;
        Engine_take_longhand(e, ds, p, @slice("initial"), imp);
    }
    val = trim_slice(val);
    size_t i = 0;
    int got = 0;
    CCSlice tok;
    while (!got && take_css_token(val, &i, &tok)) {
        CssColor c;
        if (cssval_color_cs(tok, &c) && c.kw != CKW_NONE && c.kw != CKW_AUTO) {
            Engine_take_longhand(e, ds, P_background_color, tok, imp);
            got = 1;
        }
    }
    if (!got) Engine_take_longhand(e, ds, P_background_color, @slice("initial"), imp);
}

static void Engine_take_decl(Engine* e, DeclScratch* ds, CCSlice name, CCSlice val, int imp) {
    name = trim_slice(name);
    if (name.len >= 2 && name.ptr[0] == '-' && name.ptr[1] == '-') {
        if (ds->n >= DECL_SCRATCH) return;
        CssDecl d;
        memset(&d, 0, sizeof d);
        d.varkind = VAR_CUSTOM;
        d.imp = (uint8_t)imp;
        d.vname = e->intern(name);
        d.raw = e->intern(trim_slice(val));
        ds->d[ds->n++] = d;
        Engine_note_vars(e);
        return;
    }
    if (name.eq_cstr("background")) {
        Engine_expand_background(e, ds, val, imp);
        return;
    }
    if (name.eq_cstr("margin")) {
        Engine_expand_trbl(e, ds, val, imp, P_margin_top, P_margin_right,
                           P_margin_bottom, P_margin_left, 0);
        return;
    }
    if (name.eq_cstr("padding")) {
        Engine_expand_trbl(e, ds, val, imp, P_padding_top, P_padding_right,
                           P_padding_bottom, P_padding_left, 0);
        return;
    }
    if (name.eq_cstr("border-width")) {
        Engine_expand_trbl(e, ds, val, imp, P_border_top_width, P_border_right_width,
                           P_border_bottom_width, P_border_left_width, 1);
        return;
    }
    if (name.eq_cstr("border-style")) {
        Engine_expand_trbl(e, ds, val, imp, P_border_top_style, P_border_right_style,
                           P_border_bottom_style, P_border_left_style, 0);
        return;
    }
    if (name.eq_cstr("border-color")) {
        Engine_expand_trbl(e, ds, val, imp, P_border_top_color, P_border_right_color,
                           P_border_bottom_color, P_border_left_color, 0);
        return;
    }
    if (name.eq_cstr("inset")) {
        Engine_expand_trbl(e, ds, val, imp, P_top, P_right, P_bottom, P_left, 0);
        return;
    }
    if (name.eq_cstr("overflow")) {
        Engine_expand_pair(e, ds, val, imp, P_overflow_x, P_overflow_y);
        return;
    }
    if (name.eq_cstr("gap")) {
        Engine_expand_pair(e, ds, val, imp, P_row_gap, P_column_gap);
        return;
    }
    if (name.eq_cstr("border")) {
        Engine_expand_border(e, ds, val, imp);
        return;
    }
    if (name.eq_cstr("border-top")) {
        Engine_expand_border_side(e, ds, val, imp, P_border_top_width,
                                  P_border_top_style, P_border_top_color);
        return;
    }
    if (name.eq_cstr("border-right")) {
        Engine_expand_border_side(e, ds, val, imp, P_border_right_width,
                                  P_border_right_style, P_border_right_color);
        return;
    }
    if (name.eq_cstr("border-bottom")) {
        Engine_expand_border_side(e, ds, val, imp, P_border_bottom_width,
                                  P_border_bottom_style, P_border_bottom_color);
        return;
    }
    if (name.eq_cstr("border-left")) {
        Engine_expand_border_side(e, ds, val, imp, P_border_left_width,
                                  P_border_left_style, P_border_left_color);
        return;
    }
    Engine_take_longhand(e, ds, prop_by_name(name.ptr, name.len), val, imp);
}

static int Engine_fill_decls(Engine* e, CssNode* decls, Rule* r) {
    DeclScratch ds;
    ds.n = 0;
    r->decls = 0;
    r->ndecl = 0;
    r->has_imp = 0;
    if (decls && decls->is_list()) {
        CssNode* d = decls->first();
        while (d) {
            if (d->is_list()) {
                CssNode* prop = d->first();
                CssNode* val = prop ? prop->next(d) : 0;
                if (prop && val)
                    Engine_take_decl(e, &ds, prop->span(), val->span(), decl_important(d, val));
            }
            d = d->next(decls);
        }
    }
    if (!ds.n) return 0;
    r->decls = e->store.allocT::[CssDecl](ds.n);
    if (!r->decls) return 0;
    memcpy(r->decls, ds.d, sizeof(CssDecl) * (size_t)ds.n);
    r->ndecl = ds.n;
    for (int k = 0; k < ds.n; k++)
        if (ds.d[k].imp) r->has_imp = 1;
    return 1;
}

static int fill_rule(Engine* e, CssNode* nd, Rule* r) {
    memset(r, 0, sizeof(*r));
    r->mq = -1;
    if (!nd || !nd->is_list()) return 0;
    CssNode* sel = nd->first();
    CssNode* decls = sel ? sel->next(nd) : 0;
    if (!fill_selector(e, sel, r)) return 0;
    return Engine_fill_decls(e, decls, r);
}

static int count_char(char[:] s, char c) {
    int n = 0;
    @for (ch in s)
        if (ch == c) n++;
    return n;
}

/* Row of the media table for `(min|max-width: Npx)`, adding on first sight. */
static int Engine_mq_row(Engine* e, CCSlice feat, CCSlice px) {
    int is_min;
    if (feat.eq_cstr("min-width")) is_min = 1;
    else if (feat.eq_cstr("max-width")) is_min = 0;
    else return -1;
    int v = (int)(px.to_i64() ?> -1);
    if (v < 0) return -1;
    for (int m = 0; m < e->nmq; m++)
        if (e->mqs[m].is_min == is_min && e->mqs[m].px == v) return m;
    if (e->nmq >= MAX_MQ) return -1;
    e->mqs[e->nmq].is_min = is_min;
    e->mqs[e->nmq].px = v;
    return e->nmq++;
}

/* Is media row m true for the current viewport? */
static int Engine_mq_on(Engine* e, int m) {
    if (m < 0) return 1;
    return e->mqs[m].is_min ? e->viewport_w >= e->mqs[m].px : e->viewport_w <= e->mqs[m].px;
}

static void !>(CCError) Engine_take_rule(Engine* e, CssNode* nd, int origin, int mq) {
    if (e->nrules >= e->cap_rules)
        return cc_err(CC_ERR_INVALID_ARG, "too many rules");
    Rule* r = &e->rules[e->nrules];
    if (fill_rule(e, nd, r)) {
        r->origin = origin;
        r->order = e->nrules;
        r->mq = mq;
        r->off = !e->mq_on(mq);
        e->nrules++;
    }
    return cc_ok();
}

static void !>(CCError) Engine_ingest_css(Engine* e, char[:] css, int origin) {
    if (!css.len) return cc_ok();
    CssNode* root = Css.parse(css.ptr, css.len, e->store);
    if (!root) {
        return cc_err(CC_ERR_PARSE, "css grammar");
    }
    CssNode* sheet = root->first();
    if (sheet && sheet->is_list() && sheet->id() == Css_KEEP_stylesheet)
        root = sheet;
    if (!root->is_list()) return cc_ok();
    CssNode* ch = root->first();
    while (ch) {
        if (ch->is_list() && ch->id() == Css_KEEP_rule) {
            e->take_rule(ch, origin, -1) !>(err) { return cc_err(err); };
        } else if (ch->is_list() && ch->id() == Css_KEEP_media) {
            CssNode* feat = ch->first();
            CssNode* px = feat ? feat->next(ch) : 0;
            if (!feat || !px) return cc_err(CC_ERR_PARSE, "media condition");
            int mq = e->mq_row(feat->span(), px->span());
            if (mq < 0) return cc_err(CC_ERR_PARSE, "media feature");
            CssNode* rr = px->next(ch);
            while (rr) {
                if (rr->is_list() && rr->id() == Css_KEEP_rule)
                    e->take_rule(rr, origin, mq) !>(err) { return cc_err(err); };
                rr = rr->next(ch);
            }
        }
        ch = ch->next(root);
    }
    return cc_ok();
}

static int Engine_fill_node(Engine* e, Node* nd, int parent, CCSlice tag, CCSlice dom_id,
                            CCSlice classes, CCSlice attrs) {
    memset(nd, 0, sizeof(*nd));
    nd->parent = parent;
    nd->tag = e->intern(tag);
    if (!(dom_id.len == 1 && dom_id.eq_cstr("-")))
        nd->dom_id = e->intern(dom_id);
    CCSlice class_buf[MAX_CLASS];
    int nc = split_commas(classes, class_buf, MAX_CLASS);
    nd->cap_class = nc > MAX_CLASS ? nc : MAX_CLASS;
    nd->classes = e->store.allocT::[CCSlice](nd->cap_class);
    if (nd->classes) {
        for (int i = 0; i < nc; i++)
            nd->classes[i] = e->intern(class_buf[i]);
        nd->nclass = nc;
    }
    CCSlice attr_buf[MAX_ATTR];
    int na = split_commas(attrs, attr_buf, MAX_ATTR);
    nd->cap_attr = na > MAX_ATTR ? na : MAX_ATTR;
    nd->attrs = e->store.allocT::[Attr](nd->cap_attr);
    if (nd->attrs) {
        for (int i = 0; i < na; i++) {
            CCSlice a = attr_buf[i];
            size_t eq = find_eq(a);
            nd->attrs[i].name = e->intern(a.sub(0, eq));
            if (eq < a.len)
                nd->attrs[i].value = e->intern(a.sub(eq + 1, a.len));
            else
                nd->attrs[i].value = cc_slice_empty();
            nd->nattr++;
        }
    }
    Node_reset_style(nd);
    e->set_inline_rule(nd);
    int id = (int)(nd - e->nodes);
    nv_reset_spec(nv_at(e, id));
    nd->first_child = -1;
    nd->last_child = -1;
    nd->next_sib = -1;
    nd->prev_sib = -1;
    if (parent >= 0)
        e->insert_child(parent, -1, id);
    return 1;
}

static void Engine_insert_child(Engine* e, int parent, int at, int id) {
    if (parent < 0 || id < 0) return;
    Node* p = &e->nodes[parent];
    Node* n = &e->nodes[id];
    n->parent = parent;
    n->next_sib = -1;
    n->prev_sib = -1;
    int before = -1;
    if (at >= 0) {
        int k = 0;
        for (int c = p->first_child; c >= 0; c = e->nodes[c].next_sib) {
            if (e->nodes[c].dead) continue;
            if (k == at) {
                before = c;
                break;
            }
            k++;
        }
    }
    if (before < 0) {
        n->prev_sib = p->last_child;
        if (p->last_child >= 0)
            e->nodes[p->last_child].next_sib = id;
        else
            p->first_child = id;
        p->last_child = id;
        return;
    }
    int prev = e->nodes[before].prev_sib;
    n->next_sib = before;
    n->prev_sib = prev;
    e->nodes[before].prev_sib = id;
    if (prev >= 0)
        e->nodes[prev].next_sib = id;
    else
        p->first_child = id;
}

static void Engine_add_tree_row(Engine* e, TreeRow* row) {
    if (e->nnodes >= e->cap_nodes) return;
    Node* nd = &e->nodes[e->nnodes];
    e->fill_node(nd, (int)row->parent, row->tag, row->dom_id, row->classes, row->attrs);
    e->nnodes++;
}

static void !>(CCError) Engine_ingest_tree(Engine* e, char[:] tree) {
    size_t pos = 0;
    while (ingest_skip_blank(tree, &pos, 1)) {
        TreeRow row;
        if (!TreeRow.read(tree.ptr, tree.len, &pos, e->store, &row))
            return cc_err(CC_ERR_PARSE, "tree row");
        e->add_tree_row(&row);
    }
    return cc_ok();
}

static int Engine_push_bucket(Engine* e, Map::[CCSlice, Vec::[int]] m, CCSlice key, int rule) {
    if (!m || !key.len) return 0;
    Vec::[int]* b = m->get_ptr(key);
    if (!b) {
        Vec::[int] v = vec_new::[int](e->store);
        if (m->insert(key, v) != 0) return 0;
        b = m->get_ptr(key);
        if (!b) return 0;
    }
    return b->push(rule) == 0;
}

static int compound_open(const Compound* s) {
    return !s->id.len && !s->nclass && !s->type.len && !s->nattr && !s->pseudo;
}

static int Engine_push_keyed(Engine* e, Compound* s, int k,
                             Map::[CCSlice, Vec::[int]] ids,
                             Map::[CCSlice, Vec::[int]] classes,
                             Map::[CCSlice, Vec::[int]] types) {
    if (s->id.len) return e->push_bucket(ids, s->id, k);
    if (s->nclass) {
        CCSlice cls = s->classes[0];
        return e->push_bucket(classes, cls, k);
    }
    if (s->type.len) return e->push_bucket(types, s->type, k);
    return 0;
}

static CCSlice compound_key(const Compound* s) {
    if (s->id.len) return s->id;
    if (s->nclass) return s->classes[0];
    return s->type;
}

/* left_rules entries are (rule << LEFT_SHIFT) | compound index, so the
 * invalidation walk lands on the compound that holds the atom directly. */
enum { LEFT_SHIFT = 4, LEFT_MASK = 15 };

static int Engine_push_left_rule(Engine* e, CCSlice a, int k, int ci) {
    if (ci > LEFT_MASK) return 0;
    return e->push_bucket(e->left_rules, a, (k << LEFT_SHIFT) | ci);
}

/* Every atom of one left compound, keyed to (rule, compound). Inner
 * :is / :not / :where atoms count too — adding .foo under :not(.foo)
 * must restyle the descendants. */
static void Engine_note_left(Engine* e, const Compound* c, int k, int ci) {
    if (c->type.len) e->push_left_rule(c->type, k, ci);
    if (c->id.len) e->push_left_rule(c->id, k, ci);
    if (c->classes) {
        for (int i = 0; i < c->nclass; i++)
            e->push_left_rule(c->classes[i], k, ci);
    }
    if (c->attr_n) {
        for (int i = 0; i < c->nattr; i++)
            e->push_left_rule(c->attr_n[i], k, ci);
    }
    for (int p = 0; p < e->npred; p++)
        if (c->pseudo & (1u << p))
            e->push_left_rule(e->preds[p].atom, k, ci);
    for (int i = 0; i < c->nlist; i++) {
        IsList* L = &c->lists[i];
        for (int a = 0; a < L->n; a++)
            for (int j = 0; j < L->alts[a].n; j++)
                e->note_left(&L->alts[a].c[j], k, ci);
    }
}

/* Structural rows inside :is / :not still need Node.pos bits. */
static void Engine_note_pseudos(Engine* e, const Compound* c) {
    e->pseudo_used |= c->pseudo;
    for (int i = 0; i < c->nlist; i++) {
        IsList* L = &c->lists[i];
        for (int a = 0; a < L->n; a++)
            for (int j = 0; j < L->alts[a].n; j++)
                e->note_pseudos(&L->alts[a].c[j]);
    }
}

static int Engine_push_pair(Engine* e, Map::[AtomPair, Vec::[int]] m, CCSlice subj, CCSlice left, int rule) {
    if (!m || !subj.ptr || !left.ptr) return 0;
    AtomPair key;
    key.subj = subj.ptr;
    key.left = left.ptr;
    Vec::[int]* b = m->get_ptr(key);
    if (!b) {
        Vec::[int] v = vec_new::[int](e->store);
        if (m->insert(key, v) != 0) return 0;
        b = m->get_ptr(key);
        if (!b) return 0;
    }
    return b->push(rule) == 0;
}

static void !>(CCError) Engine_index_rules(Engine* e) {
    for (int k = 0; k < e->nrules; k++) {
        Rule* r = &e->rules[k];
        if (!r->n || !r->c)
            continue;
        for (int ci = 0; ci + 1 < r->n; ci++) {
            e->note_left(&r->c[ci], k, ci);
            if (r->comb[ci] == COMB_NEXT || r->comb[ci] == COMB_SUBSEQ)
                e->has_sib_comb = 1;
        }
        Bloom z = {0};
        r->anc_need = z;
        r->anc_open = 1;
        for (int ci = r->n - 2; ci >= 0; ci--) {
            if (r->comb[ci] != COMB_DESC && r->comb[ci] != COMB_CHILD) break;
            if (r->c[ci].open) continue;
            bloom_or(&r->anc_need, &r->c[ci].need);
            r->anc_open = 0;
        }
        for (int ci = 0; ci < r->n; ci++)
            e->note_pseudos(&r->c[ci]);
        Compound* s = &r->c[r->n - 1];
        int ok = 0;
        /* Sibling-last: decided by the subject's own siblings, so it lives
         * in the revalidation set only. style_one applies the recorded hits. */
        if (r->n >= 2 &&
            (r->comb[r->n - 2] == COMB_NEXT || r->comb[r->n - 2] == COMB_SUBSEQ)) {
            if (!r->ndecl) continue;
            ok = !compound_open(s) &&
                 e->push_keyed(s, k, e->sib_by_id, e->sib_by_class, e->sib_by_type);
            if (!ok) {
                Vec::[int]* su = &e->sib_universal;
                ok = su->push(k) == 0;
            }
            if (!ok) return cc_err(CC_ERR_OUT_OF_MEMORY, "index sib rule");
            continue;
        }
        int child_star = compound_open(s) && r->n >= 2 &&
                         r->comb[r->n - 2] == COMB_CHILD;
        if (child_star) {
            Compound* left = &r->c[r->n - 2];
            ok = e->push_keyed(left, k, e->by_parent_id, e->by_parent_class, e->by_parent_type);
        } else if (compound_open(s)) {
            ok = 0;
        } else if (r->n == 1 || compound_open(&r->c[r->n - 2])) {
            ok = e->push_keyed(s, k, e->by_id, e->by_class, e->by_type);
        } else {
            CCSlice sk = compound_key(s);
            CCSlice lk = compound_key(&r->c[r->n - 2]);
            if (!sk.len || !lk.len) {
                ok = e->push_keyed(s, k, e->by_id, e->by_class, e->by_type);
            } else if (r->comb[r->n - 2] == COMB_CHILD) {
                ok = e->push_pair(e->child_pairs, sk, lk, k);
            } else {
                ok = e->push_pair(e->desc_pairs, sk, lk, k);
            }
        }
        if (!ok) {
            Vec::[int]* u = &e->universal;
            ok = u->push(k) == 0;
        }
        if (!ok) return cc_err(CC_ERR_OUT_OF_MEMORY, "index rule");
    }
    return cc_ok();
}

static void Engine_paint_blooms(Engine* e) {
    for (int i = 0; i < e->nnodes; i++) {
        Node* n = &e->nodes[i];
        Bloom z = {0};
        n->self = z;
        n->anc = z;
        n->prevs = z;
        if (n->dead) continue;
        bloom_add(&n->self, n->tag);
        bloom_add(&n->self, n->dom_id);
        for (int c = 0; c < n->nclass; c++)
            bloom_add(&n->self, n->classes[c]);
        for (int a = 0; a < n->nattr; a++)
            bloom_add(&n->self, n->attrs[a].name);
    }
    for (int i = 0; i < e->nnodes; i++) {
        Node* n = &e->nodes[i];
        if (n->dead) continue;
        int p = n->parent;
        while (p >= 0) {
            if (!e->nodes[p].dead)
                bloom_or(&n->anc, &e->nodes[p].self);
            p = e->nodes[p].parent;
        }
    }
    /* Same filter on the sibling axis: union of preceding siblings. */
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead || e->nodes[i].first_child < 0) continue;
        Bloom acc = {0};
        for (int c = e->nodes[i].first_child; c >= 0; c = e->nodes[c].next_sib) {
            if (e->nodes[c].dead) continue;
            e->nodes[c].prevs = acc;
            bloom_or(&acc, &e->nodes[c].self);
        }
    }
}

/* Does 1-based index i sit on an+b for some n >= 0? */
static int nth_hit(int a, int b, int i) {
    if (a == 0) return i == b;
    int d = i - b;
    if (d % a) return 0;
    return d / a >= 0;
}

/* Position bits for one node: its four sibling counts against every row
 * of the table, masked to the rows rules use so unused facts never split
 * a share group. A node with no parent has no siblings: index 1 of 1. */
static unsigned Engine_pos_of(Engine* e, int i) {
    Node* n = &e->nodes[i];
    if (!e->pseudo_used) return 0;
    int before = 0, after = 0, before_t = 0, after_t = 0;
    for (int s = n->prev_sib; s >= 0; s = e->nodes[s].prev_sib) {
        if (e->nodes[s].dead) continue;
        before++;
        if (e->nodes[s].tag.ptr == n->tag.ptr) before_t++;
    }
    for (int s = n->next_sib; s >= 0; s = e->nodes[s].next_sib) {
        if (e->nodes[s].dead) continue;
        after++;
        if (e->nodes[s].tag.ptr == n->tag.ptr) after_t++;
    }
    int kid = n->first_child;
    while (kid >= 0 && e->nodes[kid].dead) kid = e->nodes[kid].next_sib;
    unsigned pos = 0;
    for (int p = 0; p < e->npred; p++) {
        const PosPred* pp = &e->preds[p];
        int hit;
        switch (pp->kind) {
        case PK_CHILD: hit = nth_hit(pp->a, pp->b, before + 1); break;
        case PK_LAST_CHILD: hit = nth_hit(pp->a, pp->b, after + 1); break;
        case PK_OF_TYPE: hit = nth_hit(pp->a, pp->b, before_t + 1); break;
        case PK_LAST_OF_TYPE: hit = nth_hit(pp->a, pp->b, after_t + 1); break;
        case PK_ONLY_OF_TYPE: hit = before_t == 0 && after_t == 0; break;
        default: hit = kid < 0; break;
        }
        if (hit) pos |= 1u << p;
    }
    return pos & e->pseudo_used;
}

static void Engine_pos_arm(Engine* e, int n, int arm, int sz) {
    int lo = arm * sz;
    int hi = lo + sz < n ? lo + sz : n;
    for (int i = lo; i < hi; i++)
        if (!e->nodes[i].dead) e->nodes[i].pos = Engine_pos_of(e, i);
}

static void Engine_note_leaf_op(Engine* e, int id, int parent) {
    if (e->nleaf_ops >= e->cap_leaf_ops) return;
    e->leaf_ops[e->nleaf_ops] = id;
    e->leaf_op_parent[e->nleaf_ops] = parent;
    e->nleaf_ops++;
}

/* Position flips log like class flips: one Change per flipped bit, keyed
 * by that pseudo's atom, so left_rules needs no new path. */
static void Engine_log_pos(Engine* e, int node, unsigned prev, unsigned next) {
    unsigned diff = prev ^ next;
    for (int p = 0; p < e->npred; p++) {
        if (!(diff & (1u << p))) continue;
        if (e->nchanges >= e->cap_changes || !e->changes) return;
        Change* ch = &e->changes[e->nchanges++];
        ch->node = node;
        ch->how = CH_POS;
        ch->atom = e->preds[p].atom;
        ch->prev = cc_slice_empty();
        ch->next = cc_slice_empty();
        ch->pos_prev = prev;
        ch->pos_next = next;
    }
}

/* A leaf entered or left `parent`'s list: the parent (:empty) and every
 * live child may have moved. Movers are dirty and logged. */
static void Engine_repos_family(Engine* e, int parent) {
    if (!e->pseudo_used || parent < 0) return;
    unsigned was = e->nodes[parent].pos;
    unsigned now = Engine_pos_of(e, parent);
    if (was != now) {
        e->nodes[parent].pos = now;
        e->nodes[parent].dirty = 1;
        e->log_pos(parent, was, now);
    }
    for (int c = e->nodes[parent].first_child; c >= 0; c = e->nodes[c].next_sib) {
        if (e->nodes[c].dead) continue;
        was = e->nodes[c].pos;
        now = Engine_pos_of(e, c);
        if (was == now) continue;
        e->nodes[c].pos = now;
        e->nodes[c].dirty = 1;
        e->log_pos(c, was, now);
    }
}

static void Engine_paint_self(Engine* e, int i) {
    Node* n = &e->nodes[i];
    Bloom z = {0};
    n->self = z;
    bloom_add(&n->self, n->tag);
    bloom_add(&n->self, n->dom_id);
    for (int c = 0; c < n->nclass; c++)
        bloom_add(&n->self, n->classes[c]);
    for (int a = 0; a < n->nattr; a++)
        bloom_add(&n->self, n->attrs[a].name);
}

static void Engine_paint_anc_subtree(Engine* e, int i) {
    for (int c = e->nodes[i].first_child; c >= 0; c = e->nodes[c].next_sib) {
        if (e->nodes[c].dead) continue;
        e->nodes[c].anc = e->nodes[i].anc;
        bloom_or(&e->nodes[c].anc, &e->nodes[i].self);
        e->paint_anc_subtree(c);
    }
}

static void Engine_paint_prevs_list(Engine* e, int parent) {
    if (parent < 0) return;
    Bloom acc = {0};
    for (int c = e->nodes[parent].first_child; c >= 0; c = e->nodes[c].next_sib) {
        if (e->nodes[c].dead) continue;
        e->nodes[c].prevs = acc;
        bloom_or(&acc, &e->nodes[c].self);
    }
}

/* Repaint only what the batch moved: changed nodes' self (as a superset
 * of both states, so the invalidation join can prune with it in the
 * undone state too), their subtrees' anc, their lists' prevs, new leaves. */
static void Engine_paint_blooms_dirty(Engine* e) {
    e->bloom_stamp++;
    /* New leaves first: self and anc from the parent. A new leaf also logs
     * a CH_POS change, so the change loop below must not shadow this. */
    for (int i = 0; i < e->nleaf_ops; i++) {
        int id = e->leaf_ops[i];
        if (id < 0 || id >= e->nnodes || e->nodes[id].dead) continue;
        e->nodes[id].bloom_gen = e->bloom_stamp;
        e->paint_self(id);
        int p = e->nodes[id].parent;
        Bloom z = {0};
        e->nodes[id].anc = p >= 0 ? e->nodes[p].anc : z;
        if (p >= 0) bloom_or(&e->nodes[id].anc, &e->nodes[p].self);
    }
    /* Position bits are not bloom atoms: a CH_POS moves nothing here. */
    for (int i = 0; i < e->nchanges; i++) {
        Change* ch = &e->changes[i];
        int id = ch->node;
        if (ch->how == CH_POS) continue;
        if (id < 0 || id >= e->nnodes || e->nodes[id].dead) continue;
        if (e->nodes[id].bloom_gen != e->bloom_stamp) {
            e->nodes[id].bloom_gen = e->bloom_stamp;
            e->paint_self(id);
        }
        if (ch->how == CH_DEL_CLASS || ch->how == CH_DEL_ATTR)
            bloom_add(&e->nodes[id].self, ch->atom);
    }
    for (int i = 0; i < e->nchanges; i++) {
        int id = e->changes[i].node;
        if (e->changes[i].how == CH_POS) continue;
        if (id < 0 || id >= e->nnodes || e->nodes[id].dead) continue;
        if (e->nodes[id].bloom_gen != e->bloom_stamp) continue;
        e->nodes[id].bloom_gen = -e->bloom_stamp;
        e->paint_anc_subtree(id);
        e->paint_prevs_list(e->nodes[id].parent);
    }
    for (int i = 0; i < e->nleaf_ops; i++) {
        int id = e->leaf_ops[i];
        if (id < 0 || id >= e->nnodes) continue;
        e->paint_prevs_list(e->nodes[id].dead ? e->leaf_op_parent[i] : e->nodes[id].parent);
    }
    e->nleaf_ops = 0;
}

static void !>(CCError) Engine_load_fixture(Engine* e, char[:] text) {
    FixtureNode* root = Fixture.parse(text.ptr, text.len, e->store);
    if (!root || !root->is_list())
        return cc_err(CC_ERR_PARSE, "fixture");
    FixtureNode* file = root->first();
    if (file && file->is_list())
        root = file;
    FixtureNode* base = root->first();
    FixtureNode* css = base ? base->next(root) : 0;
    FixtureNode* tree = css ? css->next(root) : 0;
    FixtureNode* mut = tree ? tree->next(root) : 0;
    if (!base || !css || !tree)
        return cc_err(CC_ERR_PARSE, "fixture sections");
    CCSlice base_s, css_s, tree_s, mut_s = cc_slice_empty();
    base->slice(&base_s);
    css->slice(&css_s);
    tree->slice(&tree_s);
    if (mut) mut->slice(&mut_s);

    size_t nlines = 1;
    @for (ch in tree_s)
        if (ch == '\n') nlines++;
    int extra = 0;
    {
        size_t mpos = 0;
        while (ingest_skip_blank(mut_s, &mpos, 0)) {
            CCSlice line = ingest_take_line(mut_s, &mpos);
            if (line.len > 5) {
                char c0 = 0, c1 = 0;
                int k = 0;
                @for (ch in line) {
                    if (k == 0) c0 = ch;
                    else if (k == 1) { c1 = ch; break; }
                    k++;
                }
                if (c0 == '+' && c1 == 'l') extra++;
            }
        }
    }
    e->cap_nodes = (int)nlines + extra + 8;
    e->cap_rules = count_char(base_s, '{') + count_char(css_s, '{') + 8;
    e->nodes = e->store.allocT::[Node](e->cap_nodes);
    e->rules = e->store.allocT::[Rule](e->cap_rules);
    e->pool = map_new::[CCSlice, CCSlice](e->store);
    e->by_id = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_class = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_type = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_parent_id = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_parent_class = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_parent_type = map_new::[CCSlice, Vec::[int]](e->store);
    e->child_pairs = map_new::[AtomPair, Vec::[int]](e->store);
    e->desc_pairs = map_new::[AtomPair, Vec::[int]](e->store);
    e->left_rules = map_new::[CCSlice, Vec::[int]](e->store);
    e->universal = vec_new::[int](e->store);
    e->sib_by_id = map_new::[CCSlice, Vec::[int]](e->store);
    e->sib_by_class = map_new::[CCSlice, Vec::[int]](e->store);
    e->sib_by_type = map_new::[CCSlice, Vec::[int]](e->store);
    e->sib_universal = vec_new::[int](e->store);
    size_t mut_lines = 1;
    @for (ch in mut_s)
        if (ch == '\n') mut_lines++;
    e->cap_muts = (int)mut_lines + 8;
    e->muts = e->store.allocT::[MutOp](e->cap_muts);
    /* Class / attr: one change per op. Position: a leaf op can move every
     * sibling by several bits. */
    /* One restyle's log: its class/attr flips plus, per leaf op, a position
     * flip for every sibling an nth predicate moves — bounded by the tree. */
    e->cap_changes = e->cap_muts * 4 + e->cap_nodes * 2 + 64;
    e->changes = e->store.allocT::[Change](e->cap_changes);
    e->chg_order = e->store.allocT::[uint64_t](e->cap_changes);
    e->nchanges = 0;
    e->inv_ids = e->store.allocT::[int](e->cap_nodes);
    e->inv_off = e->store.allocT::[int](e->cap_nodes);
    e->inv_sig = e->store.allocT::[uint64_t](e->cap_nodes);
    e->rule_gen = e->store.allocT::[int](e->cap_rules);
    e->rule_slot = e->store.allocT::[int](e->cap_rules);
    e->inv_rules = e->store.allocT::[InvRule](e->cap_rules);
    if (e->rule_gen) memset(e->rule_gen, 0, sizeof(int) * (size_t)e->cap_rules);
    e->inv_stamp = 1;
    e->bloom_stamp = 1;
    /* Candidates repeat across sources (a node under two changed
     * ancestors), so give the batch a few trees' worth; overflow falls
     * back to the serial per-source path. */
    e->fo_cap = 4 * e->cap_nodes;
    e->fo_ids = e->store.allocT::[int](e->fo_cap);
    e->fo_off = e->store.allocT::[int](e->fo_cap);
    e->fo_job = e->store.allocT::[int](e->fo_cap);
    e->fo_sig = e->store.allocT::[uint64_t](e->fo_cap);
    e->fo_rcap = 8 * e->cap_rules;
    e->fo_rules = e->store.allocT::[InvRule](e->fo_rcap);
    e->fo_jcap = e->cap_changes + 8;
    e->fo_jobs = e->store.allocT::[SrcJob](e->fo_jcap);
    e->fo_n = e->fo_rn = e->fo_njobs = 0;
    e->cap_leaf_ops = e->cap_muts + 8;
    e->leaf_ops = e->store.allocT::[int](e->cap_leaf_ops);
    e->leaf_op_parent = e->store.allocT::[int](e->cap_leaf_ops);
    e->nleaf_ops = 0;
    e->level_ids = e->store.allocT::[int](e->cap_nodes);
    e->level_off = e->store.allocT::[int](64);
    e->share_of = e->store.allocT::[int](e->cap_nodes);
    e->share_ents = e->store.allocT::[ShareEnt](e->cap_nodes);
    e->pnodes = e->store.allocT::[Node](2 * e->cap_nodes);
    e->snaps = e->store.allocT::[StySnap](e->cap_nodes);
    e->snap_of = e->store.allocT::[int](e->cap_nodes);
    e->max_arms = 0;
    e->hit_scratch = 0;
    e->atom_id = map_new::[CCSlice, int](e->store);
    e->cap_atoms = N_STATIC_ATOMS + 4 * e->cap_rules + 1024;
    e->atoms = e->store.allocT::[CCSlice](e->cap_atoms);
    e->natoms = 0;
    e->viewport_w = 800;
    if (!e->nodes || !e->rules || !e->pool || !e->by_id || !e->by_class || !e->by_type ||
        !e->by_parent_id || !e->by_parent_class || !e->by_parent_type ||
        !e->child_pairs || !e->desc_pairs ||
        !e->left_rules || !e->muts || !e->changes || !e->inv_ids || !e->inv_off ||
        !e->inv_sig || !e->rule_gen || !e->rule_slot || !e->inv_rules ||
        !e->leaf_ops || !e->leaf_op_parent || !e->fo_ids || !e->fo_off ||
        !e->fo_job || !e->fo_sig || !e->fo_rules || !e->fo_jobs ||
        !e->level_ids || !e->level_off ||
        !e->share_of || !e->share_ents || !e->pnodes || !e->snaps || !e->snap_of ||
        !e->atom_id || !e->atoms)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "engine tables");
    /* Static atoms first, in table order, so A_* ids hold at runtime. */
    Sty_init_values();
    for (int k = 0; k < N_STATIC_ATOMS; k++) {
        CCSlice t = cc_slice_from_buffer((void*)ATOM_TEXT[k], strlen(ATOM_TEXT[k]));
        if (e->atom(t) != k) return cc_err(CC_ERR_INVALID_ARG, "atom table order");
    }
    e->ident_div = e->intern(@slice("div"));
    e->box_block = Sty_box_INIT;
    e->box_block.display = A_block;
    e->npred = 0;
    e->root = 0;

    e->ingest_css(base_s, ORIGIN_UA) !>(err) { return cc_err(err); };
    e->ingest_css(css_s, ORIGIN_AUTHOR) !>(err) { return cc_err(err); };
    e->index_rules() !>(err) { return cc_err(err); };
    e->ingest_tree(tree_s) !>(err) { return cc_err(err); };
    if (mut_s.len) e->ingest_muts(mut_s) !>(err) { return cc_err(err); };
    e->alloc_pools() !>(err) { return cc_err(err); };
    e->paint_blooms();
    for (int i = 0; i < e->cap_nodes; i++) e->reset_pseudo(i);
    return cc_ok();
}

/* Families any declaration can reach: sheet rules, style attributes on
 * the tree, style attributes the mutations will set. A pool per family,
 * three slots per element (the element and its two pseudo boxes). */
static void !>(CCError) Engine_alloc_pools(Engine* e) {
    unsigned used = 0;
    for (int k = 0; k < e->nrules; k++)
        for (int d = 0; d < e->rules[k].ndecl; d++)
            used |= 1u << PROP_FAM[e->rules[k].decls[d].prop];
    for (int i = 0; i < e->nnodes; i++) {
        Rule* r = e->nodes[i].inline_rule;
        if (!r) continue;
        for (int d = 0; d < r->ndecl; d++)
            used |= 1u << PROP_FAM[r->decls[d].prop];
    }
    for (int m = 0; m < e->nmuts; m++) {
        MutOp* op = &e->muts[m];
        CCSlice style = cc_slice_empty();
        if (op->kind == MUT_SET_ATTR && op->a.eq_cstr("style")) style = op->b;
        if (op->kind == MUT_ADD_LEAF && op->attrs.len) {
            CCSlice attr_buf[MAX_ATTR];
            int na = split_commas(op->attrs, attr_buf, MAX_ATTR);
            for (int k = 0; k < na; k++) {
                CCSlice a = attr_buf[k];
                size_t eq = find_eq(a);
                CCSlice an = a.sub(0, eq);
                if (an.eq_cstr("style") && eq < a.len)
                    style = a.sub(eq + 1, a.len);
            }
        }
        if (!style.len) continue;
        Node tmp;
        memset(&tmp, 0, sizeof tmp);
        Attr at = { @slice("style"), style, 1 };
        tmp.attrs = &at;
        tmp.nattr = 1;
        e->set_inline_rule(&tmp);
        if (tmp.inline_rule)
            for (int d = 0; d < tmp.inline_rule->ndecl; d++)
                used |= 1u << PROP_FAM[tmp.inline_rule->decls[d].prop];
    }
    e->fam_used = used;
    size_t slots = 3u * (size_t)e->cap_nodes;
    for (int f = 0; f < N_FAM; f++) {
        e->fpool[f] = 0;
        if (!(used & (1u << f))) continue;
        e->fpool[f] = cc_arena_alloc(e->store, FAM_SIZEOF[f] * slots, 16);
        if (!e->fpool[f]) return cc_err(CC_ERR_OUT_OF_MEMORY, "family pool");
    }
    return cc_ok();
}

static int slices_eq(const CCSlice* a, const CCSlice* b) {
    return a->ptr == b->ptr;
}

static int Node_has_class(Node* n, const CCSlice* c) {
    for (int i = 0; i < n->nclass; i++)
        if (slices_eq(&n->classes[i], c)) return 1;
    return 0;
}

static int Node_has_attr(Node* n, const CCSlice* name, const CCSlice* val, int equals) {
    for (int i = 0; i < n->nattr; i++) {
        if (!slices_eq(&n->attrs[i].name, name)) continue;
        if (!equals) return 1;
        if (slices_eq(&n->attrs[i].value, val)) return 1;
    }
    return 0;
}

static int hop_compound(Engine* e, int idx, const Compound* c) {
    if (idx < 0) return 0;
    if (!e->nodes[idx].match_compound(c)) return 0;
    if (!e->has_lists || !c->nlist) return 1;
    return Engine_match_lists(e, idx, c);
}

static int Node_match_compound(Node* n, const Compound* c) {
    if (c->type.len && !slices_eq(&n->tag, &c->type))
        return 0;
    if (c->id.len) {
        if (!n->dom_id.len || !slices_eq(&n->dom_id, &c->id))
            return 0;
    }
    for (int i = 0; i < c->nclass; i++)
        if (!n->has_class(&c->classes[i]))
            return 0;
    for (int i = 0; i < c->nattr; i++)
        if (!n->has_attr(&c->attr_n[i], &c->attr_v[i], c->attr_eq[i]))
            return 0;
    if ((n->pos & c->pseudo) != c->pseudo)
        return 0;
    return 1;
}

static int Engine_match_inner_from(Engine* e, int idx, const InnerSel* s, int ci) {
    if (idx < 0) return 0;
    if (!hop_compound(e, idx, &s->c[ci]))
        return 0;
    if (ci == 0)
        return 1;
    Comb comb = s->comb[ci - 1];
    Node* n = &e->nodes[idx];
    int p = n->parent;
    if (comb == COMB_CHILD) {
        if (p < 0) return 0;
        return e->match_inner_from(p, s, ci - 1);
    }
    if (comb == COMB_NEXT) {
        int prev = n->prev_sib;
        while (prev >= 0 && e->nodes[prev].dead)
            prev = e->nodes[prev].prev_sib;
        if (prev < 0) return 0;
        return e->match_inner_from(prev, s, ci - 1);
    }
    if (comb == COMB_SUBSEQ) {
        int sib = n->prev_sib;
        while (sib >= 0) {
            if (!e->nodes[sib].dead && e->match_inner_from(sib, s, ci - 1))
                return 1;
            sib = e->nodes[sib].prev_sib;
        }
        return 0;
    }
    while (p >= 0) {
        if (e->match_inner_from(p, s, ci - 1))
            return 1;
        p = e->nodes[p].parent;
    }
    return 0;
}

static int Engine_match_lists(Engine* e, int idx, const Compound* c) {
    for (int i = 0; i < c->nlist; i++) {
        IsList* L = &c->lists[i];
        int hit = 0;
        for (int a = 0; a < L->n; a++) {
            InnerSel* s = &L->alts[a];
            if (s->n > 0 && Engine_match_inner_from(e, idx, s, s->n - 1)) {
                hit = 1;
                break;
            }
        }
        if (L->kind == LIST_NOT) {
            if (hit) return 0;
        } else if (!hit) {
            return 0;
        }
    }
    return 1;
}

static int Engine_match_from(Engine* e, int idx, const Rule* r, int ci) {
    if (idx < 0) return 0;
    Node* n = &e->nodes[idx];
    /* has_lists is 0 unless the sheet parsed :is / :not / :where. */
    if (!n->match_compound(&r->c[ci]))
        return 0;
    if (e->has_lists && r->c[ci].nlist && !Engine_match_lists(e, idx, &r->c[ci]))
        return 0;
    if (ci == 0)
        return 1;
    if (ci == r->n - 1 && !r->anc_open && !bloom_has(&n->anc, &r->anc_need))
        return 0;
    Comb comb = r->comb[ci - 1];
    const Compound* left = &r->c[ci - 1];
    const Bloom* need = &left->need;
    int open = left->open;
    int p = e->nodes[idx].parent;
    if (comb == COMB_CHILD) {
        if (p < 0) return 0;
        if (!open && !bloom_has(&e->nodes[p].self, need))
            return 0;
        return e->match_from(p, r, ci - 1);
    }
    if (comb == COMB_NEXT) {
        int prev = n->prev_sib;
        while (prev >= 0 && e->nodes[prev].dead)
            prev = e->nodes[prev].prev_sib;
        if (prev < 0) return 0;
        if (!open && !bloom_has(&e->nodes[prev].self, need))
            return 0;
        return e->match_from(prev, r, ci - 1);
    }
    if (comb == COMB_SUBSEQ) {
        if (!open && !bloom_has(&n->prevs, need))
            return 0;
        int s = n->prev_sib;
        while (s >= 0) {
            if (!e->nodes[s].dead &&
                (open || bloom_has(&e->nodes[s].self, need)) &&
                e->match_from(s, r, ci - 1))
                return 1;
            s = e->nodes[s].prev_sib;
        }
        return 0;
    }
    if (!open && !bloom_has(&n->anc, need))
        return 0;
    while (p >= 0) {
        if (e->match_from(p, r, ci - 1))
            return 1;
        p = e->nodes[p].parent;
    }
    return 0;
}

static int Engine_match_from_join(Engine* e, int idx, const Rule* r, int ci) {
    if (idx < 0) return 0;
    Node* n = &e->nodes[idx];
    if (!n->match_compound(&r->c[ci]))
        return 0;
    if (e->has_lists && r->c[ci].nlist && !Engine_match_lists(e, idx, &r->c[ci]))
        return 0;
    if (ci == 0)
        return 1;
    Comb comb = r->comb[ci - 1];
    int p = e->nodes[idx].parent;
    if (comb == COMB_CHILD) {
        if (p < 0) return 0;
        return e->match_from_join(p, r, ci - 1);
    }
    if (comb == COMB_NEXT) {
        int prev = n->prev_sib;
        while (prev >= 0 && e->nodes[prev].dead)
            prev = e->nodes[prev].prev_sib;
        if (prev < 0) return 0;
        return e->match_from_join(prev, r, ci - 1);
    }
    if (comb == COMB_SUBSEQ) {
        int s = n->prev_sib;
        while (s >= 0) {
            if (!e->nodes[s].dead && e->match_from_join(s, r, ci - 1))
                return 1;
            s = e->nodes[s].prev_sib;
        }
        return 0;
    }
    while (p >= 0) {
        if (e->match_from_join(p, r, ci - 1))
            return 1;
        p = e->nodes[p].parent;
    }
    return 0;
}

/* A ::before / ::after exists only with effective content (Stylo drops
 * the box otherwise). Every generated pseudo rule sets `content: ''`. */
static int content_effective(CCSlice c) {
    return c.len && !c.eq_cstr("none") && !c.eq_cstr("normal");
}

static int Engine_pseudo_live(Engine* e, int i, int p) {
    Node* pn = &e->pnodes[2 * i + p];
    return PS_HAS(pn->specified, P_content) &&
           content_effective(e->atoms[pn->sty.counters->content]);
}

/* Fresh cascade state for one pseudo box: nothing specified, protos. */
static void Engine_reset_pseudo(Engine* e, int i) {
    for (int p = 0; p < 2; p++) {
        Node_reset_style(&e->pnodes[2 * i + p]);
        nv_reset_spec(nv_at(e, e->cap_nodes + 2 * i + p));
    }
}

/* The style attribute, parsed when set; applied as an origin-STYLE rule. */
static void Engine_set_inline_rule(Engine* e, Node* n) {
    n->inline_rule = 0;
    CCSlice style = cc_slice_empty();
    for (int a = 0; a < n->nattr; a++) {
        if (n->attrs[a].name.eq_cstr("style")) {
            style = n->attrs[a].value;
            break;
        }
    }
    if (!style.len) return;
    CCSlice wrap = e->store.alloc_slice_bytes(style.len + 3);
    if (!wrap.ptr) return;
    CCSlice head = wrap.sub(0, 2);
    CCSlice mid = wrap.sub(2, 2 + style.len);
    CCSlice tail = wrap.sub(2 + style.len, wrap.len);
    head.copy(@slice("x{")) !>(err) { return; };
    mid.copy(style) !>(err) { return; };
    tail.copy(@slice("}")) !>(err) { return; };
    CssNode* root = Css.parse(wrap.ptr, wrap.len, e->store);
    if (!root) return;
    CssNode* sheet = root->first();
    if (sheet && sheet->is_list() && sheet->id() == Css_KEEP_stylesheet)
        root = sheet;
    if (!root->is_list()) return;
    CssNode* ch = root->first();
    while (ch) {
        if (ch->is_list() && ch->id() == Css_KEEP_rule) {
            Rule* r = e->store.allocT::[Rule](1);
            if (!r || !fill_rule(e, ch, r)) return;
            r->origin = ORIGIN_STYLE;
            r->sa = 1;
            r->sb = 0;
            r->sc = 0;
            r->n = 0;
            r->order = 1 << 20;
            n->inline_rule = r;
            return;
        }
        ch = ch->next(root);
    }
}

static uint64_t rule_key(const Rule* r) {
    uint64_t sa = r->sa > 255 ? 255 : (uint64_t)r->sa;
    uint64_t sb = r->sb > 255 ? 255 : (uint64_t)r->sb;
    uint64_t sc = r->sc > 255 ? 255 : (uint64_t)r->sc;
    return ((uint64_t)r->origin << 56) | (sa << 48) | (sb << 40) | (sc << 32) |
           (uint64_t)(uint32_t)r->order;
}

/* A matched rule joins the target's hit list (the element, or one of its
 * pseudo boxes). Order is decided once, at cascade. */
static void Engine_hit(Engine* e, Hits* hs, const Rule* r, int k) {
    int t = r->pelem;
    if (hs->n[t] >= HIT_CAP) {
        hs->dropped++;
        return;
    }
    hs->h[t][hs->n[t]].key = rule_key(r);
    hs->h[t][hs->n[t]].rule = k;
    hs->n[t]++;
}

static void Engine_apply_rule(Engine* e, int i, Node* n, Hits* hs, int k) {
    Rule* r = &e->rules[k];
    if (!r->n || !r->ndecl || r->off || !e->match_from(i, r, r->n - 1))
        return;
    Engine_hit(e, hs, r, k);
}

static void Engine_apply_bucket(Engine* e, int i, Node* n, Hits* hs, Map::[CCSlice, Vec::[int]] m, CCSlice key) {
    if (!m || !key.len) return;
    Vec::[int]* b = m->get_ptr(key);
    if (!b || !b->data) return;
    Vec::[int] rules = *b;
    @for (rule_idx in rules)
        e->apply_rule(i, n, hs, rule_idx);
}

static void Engine_apply_pair(Engine* e, int i, Node* n, Hits* hs, Map::[AtomPair, Vec::[int]] m, CCSlice subj, CCSlice left) {
    if (!m || !subj.ptr || !left.ptr) return;
    AtomPair key;
    key.subj = subj.ptr;
    key.left = left.ptr;
    Vec::[int]* b = m->get_ptr(key);
    if (!b || !b->data) return;
    Vec::[int] rules = *b;
    @for (rule_idx in rules)
        e->apply_rule(i, n, hs, rule_idx);
}

static void Engine_apply_pairs_other(Engine* e, int i, Node* n, Hits* hs, Map::[AtomPair, Vec::[int]] m, CCSlice subj, Node* other) {
    if (!subj.len) return;
    if (other->dom_id.len)
        e->apply_pair(i, n, hs, m, subj, other->dom_id);
    for (int c = 0; c < other->nclass; c++)
        e->apply_pair(i, n, hs, m, subj, other->classes[c]);
    e->apply_pair(i, n, hs, m, subj, other->tag);
}

static void Engine_apply_pairs(Engine* e, int i, Node* n, Hits* hs, Map::[AtomPair, Vec::[int]] m, Node* other) {
    if (n->dom_id.len)
        e->apply_pairs_other(i, n, hs, m, n->dom_id, other);
    for (int c = 0; c < n->nclass; c++)
        e->apply_pairs_other(i, n, hs, m, n->classes[c], other);
    e->apply_pairs_other(i, n, hs, m, n->tag, other);
}

/* Revalidation. Parent + identity proves two nodes match the same rules
 * only when every rule is decided by the ancestor chain. A rule whose last
 * combinator is + / ~ is decided by preceding siblings, so match those
 * directly and put the result in the share key. Twins that agree share
 * everything; twins that disagree are separate canons. Same walk order for
 * twins, so the hit list compares exactly. Overflow means "never share". */
static void Engine_sib_hits(Engine* e, int i, Node* n, Vec::[int]* b) {
    if (!b || !b->data) return;
    Vec::[int] rules = *b;
    @for (k in rules) {
        if (n->sib_n < 0) return;
        Rule* r = &e->rules[k];
        if (!r->n || r->off || !e->match_from(i, r, r->n - 1)) continue;
        if (n->sib_n >= SIB_SLOTS) {
            n->sib_n = -1;
            return;
        }
        n->sib_hit[n->sib_n++] = k;
    }
}

static void Engine_sib_sig(Engine* e, int i) {
    Node* n = &e->nodes[i];
    n->sib_n = 0;
    if (n->dead) return;
    if (n->dom_id.len)
        e->sib_hits(i, n, e->sib_by_id->get_ptr(n->dom_id));
    for (int c = 0; c < n->nclass; c++)
        e->sib_hits(i, n, e->sib_by_class->get_ptr(n->classes[c]));
    e->sib_hits(i, n, e->sib_by_type->get_ptr(n->tag));
    e->sib_hits(i, n, &e->sib_universal);
}

/* Overflowed revalidation: no recorded list, match the buckets here. */
static void Engine_apply_sib_bucket(Engine* e, int i, Node* n, Hits* hs, Vec::[int]* b) {
    if (!b || !b->data) return;
    Vec::[int] rules = *b;
    @for (k in rules)
        e->apply_rule(i, n, hs, k);
}

static void Engine_apply_sib(Engine* e, int i, Node* n, Hits* hs) {
    if (n->sib_n >= 0) {
        for (int k = 0; k < n->sib_n; k++)
            Engine_hit(e, hs, &e->rules[n->sib_hit[k]], n->sib_hit[k]);
        return;
    }
    if (n->dom_id.len)
        Engine_apply_sib_bucket(e, i, n, hs, e->sib_by_id->get_ptr(n->dom_id));
    for (int c = 0; c < n->nclass; c++)
        Engine_apply_sib_bucket(e, i, n, hs, e->sib_by_class->get_ptr(n->classes[c]));
    Engine_apply_sib_bucket(e, i, n, hs, e->sib_by_type->get_ptr(n->tag));
    Engine_apply_sib_bucket(e, i, n, hs, &e->sib_universal);
}

static void hits_sort(Hit* h, int n) {
    for (int i = 1; i < n; i++) {
        Hit x = h[i];
        int j = i - 1;
        while (j >= 0 && h[j].key > x.key) {
            h[j + 1] = h[j];
            j--;
        }
        h[j + 1] = x;
    }
}

static void node_set_var(CCSlice* ns, CCSlice* vs, int* n, CCSlice name, CCSlice val) {
    for (int i = 0; i < *n; i++) {
        if (ns[i].ptr == name.ptr) { vs[i] = val; return; }
    }
    if (*n >= CSS_MAX_VARS) return;
    ns[*n] = name;
    vs[*n] = val;
    (*n)++;
}

static void node_set_pvar(NodeVars* v, uint16_t prop, CCSlice raw) {
    for (int i = 0; i < v->npvar; i++) {
        if (v->pvar_prop[i] == prop) { v->pvar_raw[i] = raw; return; }
    }
    if (v->npvar >= CSS_MAX_VARS) return;
    v->pvar_prop[v->npvar] = prop;
    v->pvar_raw[v->npvar] = raw;
    v->npvar++;
}

static void Engine_apply_decls(Engine* e, Node* n, int slot, const Rule* r, int imp) {
    NodeVars* v = nv_at(e, slot);
    for (int d = 0; d < r->ndecl; d++) {
        const CssDecl* dc = &r->decls[d];
        if ((int)dc->imp != imp) continue;
        if (dc->varkind == VAR_CUSTOM) {
            if (v) node_set_var(v->var_spec_n, v->var_spec_v, &v->nvar_spec, dc->vname, dc->raw);
            continue;
        }
        if (dc->varkind == VAR_REF) {
            if (v) node_set_pvar(v, dc->prop, dc->raw);
            continue;
        }
        Sty_apply(&n->sty, &n->own, e->fpool, slot, dc);
        PS_SET(n->specified, dc->prop);
    }
}

/* The cascade for one target: matched rules in (origin, specificity,
 * order); normal declarations UA < author < style, then important ones
 * author < style < UA. Later writes win, so each field is assigned in
 * cascade order and the last assignment stands. */
static void Engine_cascade(Engine* e, Node* n, int slot, Hit* h, int nh, const Rule* inl) {
    hits_sort(h, nh);
    for (int k = 0; k < nh; k++)
        e->apply_decls(n, slot, &e->rules[h[k].rule], 0);
    if (inl) e->apply_decls(n, slot, inl, 0);
    for (int k = 0; k < nh; k++) {
        const Rule* r = &e->rules[h[k].rule];
        if (r->has_imp && r->origin == ORIGIN_AUTHOR) e->apply_decls(n, slot, r, 1);
    }
    if (inl && inl->has_imp) e->apply_decls(n, slot, inl, 1);
    for (int k = 0; k < nh; k++) {
        const Rule* r = &e->rules[h[k].rule];
        if (r->has_imp && r->origin == ORIGIN_UA) e->apply_decls(n, slot, r, 1);
    }
}

static void Engine_style_one(Engine* e, int i, Hits* hs) {
    Node* n = &e->nodes[i];
    if (n->dead) return;
    hs->n[0] = hs->n[1] = hs->n[2] = 0;
    if (n->dom_id.len)
        e->apply_bucket(i, n, hs, e->by_id, n->dom_id);
    for (int c = 0; c < n->nclass; c++)
        e->apply_bucket(i, n, hs, e->by_class, n->classes[c]);
    e->apply_bucket(i, n, hs, e->by_type, n->tag);
    if (n->parent >= 0) {
        Node* par = &e->nodes[n->parent];
        if (par->dom_id.len)
            e->apply_bucket(i, n, hs, e->by_parent_id, par->dom_id);
        for (int c = 0; c < par->nclass; c++)
            e->apply_bucket(i, n, hs, e->by_parent_class, par->classes[c]);
        e->apply_bucket(i, n, hs, e->by_parent_type, par->tag);
        e->apply_pairs(i, n, hs, e->child_pairs, par);
        int p = par->parent;
        while (p >= 0) {
            e->apply_pairs(i, n, hs, e->desc_pairs, &e->nodes[p]);
            p = e->nodes[p].parent;
        }
        e->apply_pairs(i, n, hs, e->desc_pairs, par);
    }
    Vec::[int]* u = &e->universal;
    if (u->data) {
        Vec::[int] rules = *u;
        @for (rule_idx in rules)
            e->apply_rule(i, n, hs, rule_idx);
    }
    Engine_apply_sib(e, i, n, hs);
    e->cascade(n, i, hs->h[0], hs->n[0], n->inline_rule);
    for (int p = 0; p < 2; p++)
        e->cascade(&e->pnodes[2 * i + p], e->cap_nodes + 2 * i + p, hs->h[1 + p], hs->n[1 + p], 0);
}


static void Engine_paint_levels(Engine* e) {
    int maxd = 0;
    int root = -1;
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead) {
            e->nodes[i].depth = -1;
            continue;
        }
        if (root < 0 && e->nodes[i].parent < 0) root = i;
        int d = 0, p = e->nodes[i].parent;
        while (p >= 0) {
            d++;
            p = e->nodes[p].parent;
        }
        e->nodes[i].depth = d;
        if (d > maxd) maxd = d;
    }
    e->max_depth = maxd;
    e->root = root < 0 ? 0 : root;
    for (int d = 0; d <= maxd + 1 && d < 64; d++)
        e->level_off[d] = 0;
    for (int i = 0; i < e->nnodes; i++)
        if (!e->nodes[i].dead && e->nodes[i].depth + 1 < 64)
            e->level_off[e->nodes[i].depth + 1]++;
    for (int d = 0; d <= maxd && d + 1 < 64; d++)
        e->level_off[d + 1] += e->level_off[d];
    int cur[64];
    for (int d = 0; d <= maxd && d < 64; d++)
        cur[d] = e->level_off[d];
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead) continue;
        int d = e->nodes[i].depth;
        if (d < 0 || d >= 64) continue;
        e->level_ids[cur[d]++] = i;
    }
}

/* Inheritance and resolution for one element, from its parent's structs.
 * Idempotent: a clean node whose parent's inherited struct changed runs
 * the same code to re-inherit. */
static int node_vars_eq(const NodeVars* n, const CCSlice* on, const CCSlice* ov, int onv) {
    if (n->nvar != onv) return 0;
    for (int i = 0; i < onv; i++)
        if (n->var_n[i].ptr != on[i].ptr || n->var_v[i].ptr != ov[i].ptr) return 0;
    return 1;
}

static void node_merge_vars(NodeVars* n, const NodeVars* from) {
    n->nvar = 0;
    if (from) {
        for (int i = 0; i < from->nvar && n->nvar < CSS_MAX_VARS; i++) {
            n->var_n[n->nvar] = from->var_n[i];
            n->var_v[n->nvar] = from->var_v[i];
            n->nvar++;
        }
    }
    for (int i = 0; i < n->nvar_spec; i++)
        node_set_var(n->var_n, n->var_v, &n->nvar, n->var_spec_n[i], n->var_spec_v[i]);
}

static void node_apply_pending(Engine* e, Node* n, NodeVars* v, int slot) {
    if (!v->npvar) return;
    CssVarRef refs[CSS_MAX_VARS];
    for (int i = 0; i < v->nvar; i++) {
        refs[i].nptr = v->var_n[i].ptr;
        refs[i].nlen = v->var_n[i].len;
        refs[i].vptr = v->var_v[i].ptr;
        refs[i].vlen = v->var_v[i].len;
    }
    char buf[256];
    for (int i = 0; i < v->npvar; i++) {
        size_t wn = 0;
        CCSlice raw = v->pvar_raw[i];
        if (!cssval_subst(raw.ptr, raw.len, refs, v->nvar, buf, sizeof buf, &wn))
            continue;
        CssDecl d;
        memset(&d, 0, sizeof d);
        d.prop = v->pvar_prop[i];
        if (!Engine_fill_cell(e, (int)d.prop, cc_slice_from_buffer(buf, wn), &d))
            continue;
        Sty_apply(&n->sty, &n->own, e->fpool, slot, &d);
        PS_SET(n->specified, d.prop);
    }
}

static int node_refresh_vars(Engine* e, Node* n, NodeVars* v, const NodeVars* from, int slot) {
    CCSlice old_n[CSS_MAX_VARS], old_v[CSS_MAX_VARS];
    int old = v->nvar;
    for (int i = 0; i < old; i++) { old_n[i] = v->var_n[i]; old_v[i] = v->var_v[i]; }
    node_merge_vars(v, from);
    node_apply_pending(e, n, v, slot);
    return !node_vars_eq(v, old_n, old_v, old);
}

static void Engine_inherit_one(Engine* e, int i) {
    Node* n = &e->nodes[i];
    if (n->dead) return;
    const Node* pn = n->parent >= 0 ? &e->nodes[n->parent] : 0;
    const StyRefs* par = pn ? &pn->sty : &STY_INIT_REFS;
    if (e->vtab) {
        NodeVars* v = &e->vtab[i];
        const NodeVars* pv = n->parent >= 0 ? &e->vtab[n->parent] : 0;
        v->changed = node_refresh_vars(e, n, v, pv, i);
    }
    if (!PS_HAS(n->specified, P_display) && slices_eq(&n->tag, &e->ident_div)) {
        if (n->own & (1u << FAM_box)) ((Sty_box*)n->sty.box)->display = A_block;
        else n->sty.box = &e->box_block;
    }
    Sty_inherit_all(&n->sty, par, n->own, n->specified);
    float parent_fs = par->font->font_size.px;
    float root_fs = e->nodes[e->root].sty.font->font_size.px;
    if (n->parent < 0) root_fs = parent_fs;
    Sty_resolve_all(&n->sty, n->own, parent_fs, root_fs);
    for (int p = 0; p < 2; p++)
        if (e->pseudo_live(i, p)) e->inherit_pseudo(i, p);
}

/* A pseudo box inherits from its element, not the element's parent; its
 * display defaults to inline and it never carries an inline style. */
static void Engine_inherit_pseudo(Engine* e, int i, int p) {
    Node* el = &e->nodes[i];
    Node* n = &e->pnodes[2 * i + p];
    int slot = e->cap_nodes + 2 * i + p;
    if (e->vtab)
        node_refresh_vars(e, n, &e->vtab[slot], &e->vtab[i], slot);
    Sty_inherit_all(&n->sty, &el->sty, n->own, n->specified);
    float parent_fs = el->sty.font->font_size.px;
    float root_fs = e->nodes[e->root].sty.font->font_size.px;
    Sty_resolve_all(&n->sty, n->own, parent_fs, root_fs);
}

/* The children of a node whose inherited structs changed: re-inherit. */
static void Engine_mark_children(Engine* e, int i) {
    for (int c = e->nodes[i].first_child; c >= 0; c = e->nodes[c].next_sib)
        if (!e->nodes[c].dead) e->nodes[c].inh_dirty = 1;
}

static uint64_t node_share_hash(const Node* n) {
    uint64_t h = (uint64_t)(uint32_t)n->parent * 0x9E3779B97F4A7C15ULL;
    h ^= (uint64_t)(uintptr_t)n->tag.ptr;
    h ^= (uint64_t)(uintptr_t)n->dom_id.ptr;
    h ^= (uint64_t)(uint32_t)n->nclass << 32;
    h ^= (uint64_t)(uint32_t)n->nattr;
    for (int i = 0; i < n->nclass; i++)
        h = h * 0x9E3779B97F4A7C15ULL + (uint64_t)(uintptr_t)n->classes[i].ptr;
    for (int i = 0; i < n->nattr; i++) {
        h = h * 0x9E3779B97F4A7C15ULL + (uint64_t)(uintptr_t)n->attrs[i].name.ptr;
        h ^= (uint64_t)(uintptr_t)n->attrs[i].value.ptr;
    }
    h ^= (uint64_t)(uint32_t)n->sib_n << 40;
    h ^= (uint64_t)n->pos << 48;
    for (int i = 0; i < n->sib_n; i++)
        h = h * 0x9E3779B97F4A7C15ULL + (uint64_t)(uint32_t)n->sib_hit[i];
    return h;
}

static int node_share_eq(const Node* a, const Node* b) {
    if (a->parent != b->parent) return 0;
    if (a->tag.ptr != b->tag.ptr) return 0;
    if (a->dom_id.ptr != b->dom_id.ptr) return 0;
    if (a->pos != b->pos) return 0;
    if (a->nclass != b->nclass || a->nattr != b->nattr) return 0;
    if (a->sib_n < 0 || b->sib_n < 0 || a->sib_n != b->sib_n) return 0;
    for (int i = 0; i < a->nclass; i++)
        if (a->classes[i].ptr != b->classes[i].ptr) return 0;
    for (int i = 0; i < a->nattr; i++) {
        if (a->attrs[i].name.ptr != b->attrs[i].name.ptr) return 0;
        if (a->attrs[i].value.ptr != b->attrs[i].value.ptr) return 0;
    }
    for (int i = 0; i < a->sib_n; i++)
        if (a->sib_hit[i] != b->sib_hit[i]) return 0;
    return 1;
}

static int share_ent_cmp(const void* a, const void* b) {
    const ShareEnt* x = (const ShareEnt*)a;
    const ShareEnt* y = (const ShareEnt*)b;
    if (x->h < y->h) return -1;
    if (x->h > y->h) return 1;
    return 0;
}

static void Engine_build_share(Engine* e) {
    int nent = 0;
    for (int i = 0; i < e->nnodes; i++) {
        e->share_of[i] = i;
        if (e->nodes[i].dead) continue;
        e->share_ents[nent].h = node_share_hash(&e->nodes[i]);
        e->share_ents[nent].i = i;
        nent++;
    }
    qsort(e->share_ents, (size_t)nent, sizeof(ShareEnt), share_ent_cmp);
    int ncanon = 0;
    int k = 0;
    while (k < nent) {
        uint64_t h = e->share_ents[k].h;
        int run = k + 1;
        while (run < nent && e->share_ents[run].h == h)
            run++;
        for (int i = k; i < run; i++) {
            int id = e->share_ents[i].i;
            int canon = id;
            for (int j = k; j < i; j++) {
                int cj = e->share_ents[j].i;
                if (e->share_of[cj] == cj && node_share_eq(&e->nodes[id], &e->nodes[cj])) {
                    canon = cj;
                    break;
                }
            }
            e->share_of[id] = canon;
        }
        k = run;
    }
    ncanon = 0;
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead) continue;
        if (e->share_of[i] == i)
            e->share_ents[ncanon++].i = i;
    }
    e->ncanon = ncanon;
}

/* Dirty nodes only. Same parent is the share key, so the sibling
 * list is the group. Prefer a clean twin (already styled). */
static int Engine_share_canon(Engine* e, int d) {
    Node* nd = &e->nodes[d];
    int p = nd->parent;
    if (p < 0) return d;
    int clean = -1;
    int dirty_id = d;
    for (int s = e->nodes[p].first_child; s >= 0; s = e->nodes[s].next_sib) {
        if (e->nodes[s].dead) continue;
        if (!node_share_eq(nd, &e->nodes[s])) continue;
        if (!e->nodes[s].dirty) {
            if (clean < 0 || s < clean) clean = s;
        } else if (s < dirty_id) {
            dirty_id = s;
        }
    }
    return clean >= 0 ? clean : dirty_id;
}

static void Engine_rebuild_share_dirty(Engine* e) {
    int ncanon = 0;
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead || !e->nodes[i].dirty) continue;
        int c = e->share_canon(i);
        e->share_of[i] = c;
        if (c == i)
            e->share_ents[ncanon++].i = i;
    }
    e->ncanon = ncanon;
}

static void Engine_log_change(Engine* e, int node, int how, CCSlice atom, CCSlice prev, CCSlice next) {
    if (e->nchanges >= e->cap_changes || !e->changes) return;
    e->changes[e->nchanges].node = node;
    e->changes[e->nchanges].how = how;
    e->changes[e->nchanges].atom = atom;
    e->changes[e->nchanges].prev = prev;
    e->changes[e->nchanges].next = next;
    e->changes[e->nchanges].idx = 0;
    e->nchanges++;
}

/* Insert A at slot idx (clamped), shifting the tail up. */
static int Engine_tmp_add_class(Engine* e, Node* n, CCSlice A, int idx) {
    if (!e->ensure_class_cap(n, n->nclass + 1)) return 0;
    if (idx < 0) idx = 0;
    if (idx > n->nclass) idx = n->nclass;
    for (int j = n->nclass; j > idx; j--)
        n->classes[j] = n->classes[j - 1];
    n->classes[idx] = A;
    n->nclass++;
    return 1;
}

/* Remove the copy of A at slot idx if it is there, else the first copy. */
static void Engine_tmp_del_one_class(Node* n, CCSlice A, int idx) {
    int i = idx;
    if (i < 0 || i >= n->nclass || n->classes[i].ptr != A.ptr) {
        i = -1;
        for (int q = 0; q < n->nclass; q++)
            if (n->classes[q].ptr == A.ptr) { i = q; break; }
        if (i < 0) return;
    }
    for (int j = i + 1; j < n->nclass; j++)
        n->classes[j - 1] = n->classes[j];
    n->nclass--;
}

/* Insert an attribute at slot idx (clamped), shifting the tail up. */
static int Engine_tmp_ins_attr(Engine* e, Node* n, CCSlice name, CCSlice val, int idx) {
    if (!e->ensure_attr_cap(n, n->nattr + 1)) return 0;
    if (idx < 0 || idx > n->nattr) idx = n->nattr;
    for (int j = n->nattr; j > idx; j--)
        n->attrs[j] = n->attrs[j - 1];
    n->attrs[idx].name = name;
    n->attrs[idx].value = val;
    n->nattr++;
    return 1;
}

/* Remove the attribute at slot idx if it carries the name, else the last
 * entry with that name (the appended one, under LIFO undo). */
static void Engine_tmp_rm_attr(Node* n, CCSlice name, int idx) {
    int i = idx;
    if (i < 0 || i >= n->nattr || n->attrs[i].name.ptr != name.ptr) {
        i = -1;
        for (int q = n->nattr - 1; q >= 0; q--)
            if (n->attrs[q].name.ptr == name.ptr) { i = q; break; }
        if (i < 0) return;
    }
    for (int j = i + 1; j < n->nattr; j++)
        n->attrs[j - 1] = n->attrs[j];
    n->nattr--;
}

/* Set the value at slot idx if it carries the name, else the first entry
 * with that name (apply_mut's rule). */
static void Engine_tmp_val_attr(Node* n, CCSlice name, CCSlice val, int idx) {
    if (idx >= 0 && idx < n->nattr && n->attrs[idx].name.ptr == name.ptr) {
        n->attrs[idx].value = val;
        return;
    }
    for (int q = 0; q < n->nattr; q++)
        if (n->attrs[q].name.ptr == name.ptr) { n->attrs[q].value = val; return; }
}

/* Inverse of apply_mut for this atom. One instance, not all copies. */
static void Engine_change_undo(Engine* e, Change* ch) {
    Node* n = &e->nodes[ch->node];
    if (ch->how == CH_ADD_CLASS) Engine_tmp_del_one_class(n, ch->atom, ch->idx);
    else if (ch->how == CH_DEL_CLASS) e->tmp_add_class(n, ch->atom, ch->idx);
    else if (ch->how == CH_SET_ATTR) {
        /* idx < 0: the set appended a new entry, so undo removes it. */
        if (ch->idx < 0) Engine_tmp_rm_attr(n, ch->atom, n->nattr - 1);
        else Engine_tmp_val_attr(n, ch->atom, ch->prev, ch->idx);
    } else if (ch->how == CH_DEL_ATTR) {
        e->tmp_ins_attr(n, ch->atom, ch->prev, ch->idx);
    } else if (ch->how == CH_POS) {
        n->pos = ch->pos_prev;
    }
}

static void Engine_change_redo(Engine* e, Change* ch) {
    Node* n = &e->nodes[ch->node];
    if (ch->how == CH_ADD_CLASS) e->tmp_add_class(n, ch->atom, ch->idx);
    else if (ch->how == CH_DEL_CLASS) Engine_tmp_del_one_class(n, ch->atom, ch->idx);
    else if (ch->how == CH_SET_ATTR) {
        if (ch->idx < 0) e->tmp_ins_attr(n, ch->atom, ch->next, -1);
        else Engine_tmp_val_attr(n, ch->atom, ch->next, ch->idx);
    } else if (ch->how == CH_DEL_ATTR) Engine_tmp_rm_attr(n, ch->atom, ch->idx);
    else if (ch->how == CH_POS) n->pos = ch->pos_next;
}

static void Engine_push_inv(Engine* e, int d, int* nc) {
    if (d < 0 || d >= e->nnodes) return;
    if (e->nodes[d].dead) return;
    if (e->nodes[d].inv_gen == e->inv_stamp) return;
    if (*nc >= e->cap_nodes) return;
    e->nodes[d].inv_gen = e->inv_stamp;
    e->inv_ids[(*nc)++] = d;
}

static void Engine_dirty_following(Engine* e, int src) {
    if (src < 0 || src >= e->nnodes) return;
    for (int s = e->nodes[src].next_sib; s >= 0; s = e->nodes[s].next_sib) {
        if (e->nodes[s].dead) continue;
        e->nodes[s].dirty = 1;
        e->dirty_desc(s);
    }
}

static void Engine_undo_all(Engine* e) {
    for (int i = e->nchanges - 1; i >= 0; i--)
        e->change_undo(&e->changes[i]);
}

static void Engine_redo_all(Engine* e) {
    for (int i = 0; i < e->nchanges; i++)
        e->change_redo(&e->changes[i]);
}

/* Where a rule can reach from src, given which of its compounds src
 * matched: `X > S` reaches children, `X S` descendants, `X + S` / `X ~ S`
 * following siblings, anything longer with a sibling hop is wide. */
enum { GRP_CHILD = 1, GRP_DESC = 2, GRP_FOLLOW = 4, GRP_WIDE = 8 };
enum { KIND_CHILD = 0, KIND_DEEP = 1, KIND_FOLLOW = 2, KIND_FDESC = 3 };
static const int KIND_MASK[4] = {
    GRP_CHILD | GRP_DESC | GRP_WIDE,
    GRP_DESC | GRP_WIDE,
    GRP_FOLLOW | GRP_WIDE,
    GRP_WIDE,
};

static int rule_reach(const Rule* r, int ci) {
    if (ci == r->n - 2) {
        Comb c = r->comb[ci];
        if (c == COMB_CHILD) return GRP_CHILD;
        if (c == COMB_DESC) return GRP_DESC;
        return GRP_FOLLOW;
    }
    for (int j = ci; j + 1 < r->n; j++)
        if (r->comb[j] == COMB_NEXT || r->comb[j] == COMB_SUBSEQ) return GRP_WIDE;
    return GRP_DESC;
}

/* A change's atom can only be on src in one state: an added class in the
 * applied state, a removed one in the undone state. A set attribute keeps
 * its name in both; a position flip may have the bit in either. */
static int change_in_state(const Change* ch, int undone) {
    switch (ch->how) {
    case CH_ADD_CLASS: return !undone;
    case CH_DEL_CLASS: return undone;
    case CH_DEL_ATTR: return undone;
    case CH_SET_ATTR: return ch->idx >= 0 || !undone;
    default: return 1;
    }
}

/* Rules whose left compound holding one of src's changed atoms matches
 * src in the given state. The compound holding the atom cannot match
 * while src lacks the atom, so each bucket is visited in the state where
 * src has it. Deduped by rule_gen; the reach mask accumulates. */
static int Engine_rules_for_src_state(Engine* e, int src, int lo, int hi, InvRule* out, int n, int undone) {
    for (int o = lo; o < hi; o++) {
        Change* ch = &e->changes[CHG_IDX(e->chg_order[o])];
        if (!ch->atom.len || !e->left_rules) continue;
        if (!change_in_state(ch, undone)) continue;
        Vec::[int]* rs = e->left_rules->get_ptr(ch->atom);
        if (!rs || !rs->data) continue;
        Vec::[int] rules = *rs;
        @for (kc in rules) {
            int k = kc >> LEFT_SHIFT, ci = kc & LEFT_MASK;
            Rule* r = &e->rules[k];
            if (!hop_compound(e, src, &r->c[ci])) continue;
            int grp = rule_reach(r, ci);
            if (e->rule_gen[k] == e->inv_stamp) {
                out[e->rule_slot[k]].grp |= grp;
                continue;
            }
            if (n >= e->cap_rules) continue;
            e->rule_gen[k] = e->inv_stamp;
            e->rule_slot[k] = n;
            out[n].key = compound_key(&r->c[r->n - 1]).ptr;
            out[n].k = k;
            out[n].grp = grp;
            n++;
        }
    }
    return n;
}

/* Only src's own changes decide whether its compounds match, so the
 * undone-state rule pass flips just those: chg_order[lo..hi), in log order. */
static void Engine_undo_src(Engine* e, int lo, int hi) {
    for (int o = hi - 1; o >= lo; o--) e->change_undo(&e->changes[CHG_IDX(e->chg_order[o])]);
}

static void Engine_redo_src(Engine* e, int lo, int hi) {
    for (int o = lo; o < hi; o++) e->change_redo(&e->changes[CHG_IDX(e->chg_order[o])]);
}

/* Group the log by node, log order within a node, so a source's changes
 * are one run: chg_order holds (node << 32 | log index), sorted. */
#define CHG_IDX(k) ((int)((k) & 0xffffffffu))
static int u64_cmp(const void* a, const void* b) {
    uint64_t x = *(const uint64_t*)a, y = *(const uint64_t*)b;
    return x < y ? -1 : x > y;
}

static int inv_rule_cmp(const void* a, const void* b) {
    const InvRule* x = (const InvRule*)a;
    const InvRule* y = (const InvRule*)b;
    if (x->key < y->key) return -1;
    if (x->key > y->key) return 1;
    return x->k - y->k;
}

/* First entry with this key in the sorted table, or -1. */
static int inv_rule_find(const InvRule* t, int n, const char* key) {
    int lo = 0, hi = n;
    while (lo < hi) {
        int mid = (lo + hi) >> 1;
        if (t[mid].key < key) lo = mid + 1;
        else hi = mid;
    }
    return lo < n && t[lo].key == key ? lo : -1;
}

static void Engine_sig_run(Engine* e, int d, const InvRule* t, int n, int at, int mask,
                           uint64_t* sig) {
    const char* key = t[at].key;
    for (; at < n && t[at].key == key; at++) {
        if (!(t[at].grp & mask)) continue;
        Rule* r = &e->rules[t[at].k];
        if (r->off) continue;
        /* Blooms are a superset of both states (paint_blooms_dirty), so
         * the pruned walk cannot miss in either. */
        if (e->match_from(d, r, r->n - 1))
        {            *sig ^= ((uint64_t)(t[at].k + 1) * 0x9E3779B97F4A7C15ULL) ^ (uint64_t)t[at].k << 17;}
    }
}

/* Signature of the subset of the table that d matches right now, over
 * rules that reach d's kind: the keyless run, then d's own atoms. */
static uint64_t Engine_match_sig(Engine* e, int d, const InvRule* t, int n, int nopen, int kind) {
    uint64_t sig = 0;
    int mask = KIND_MASK[kind];
    Node* nd = &e->nodes[d];
    if (nopen)
        Engine_sig_run(e, d, t, nopen, 0, mask, &sig);
    int at;
    if ((at = inv_rule_find(t, n, nd->tag.ptr)) >= 0)
        Engine_sig_run(e, d, t, n, at, mask, &sig);
    if (nd->dom_id.len && (at = inv_rule_find(t, n, nd->dom_id.ptr)) >= 0)
        Engine_sig_run(e, d, t, n, at, mask, &sig);
    for (int c = 0; c < nd->nclass; c++) {
        /* A node may carry a class twice; visiting its run twice would
         * cancel the XOR. */
        int dup = 0;
        for (int p = 0; p < c && !dup; p++)
            dup = nd->classes[p].ptr == nd->classes[c].ptr;
        if (dup) continue;
        if ((at = inv_rule_find(t, n, nd->classes[c].ptr)) >= 0)
            Engine_sig_run(e, d, t, n, at, mask, &sig);
    }
    return sig;
}

static void Engine_collect_kind(Engine* e, int src, int kind, int deep_kind, int with_desc, int* nc) {
    for (int c = e->nodes[src].first_child; c >= 0; c = e->nodes[c].next_sib) {
        if (e->nodes[c].dead) continue;
        int before = *nc;
        e->push_inv(c, nc);
        if (*nc > before) e->inv_off[before] = kind;
        if (with_desc)
            e->collect_kind(c, deep_kind, deep_kind, 1, nc);
    }
}

/* Staging is serial; the two signature passes run in parallel over all
 * candidates of all sources, since neither pass mutates the tree. */
/* Rule table and candidate list for one source. Returns 0 when the shared
 * scratch is full, so the caller can fall back to the serial path. */
static int Engine_stage_src(Engine* e, int src, int lo, int hi) {
    if (src < 0 || src >= e->nnodes || e->nodes[src].dead) return 1;
    /* A left compound reaches down, or (with + / ~ in the sheet) across.
     * No live child and no sibling combinator: nothing can flip below src. */
    if (!e->has_sib_comb) {
        int kid = e->nodes[src].first_child;
        while (kid >= 0 && e->nodes[kid].dead) kid = e->nodes[kid].next_sib;
        if (kid < 0) return 1;
    }
    if (e->fo_njobs >= e->fo_jcap || e->fo_rn + e->cap_rules > e->fo_rcap) return 0;
    e->inv_stamp++;
    InvRule* t = e->fo_rules + e->fo_rn;
    int nr = Engine_rules_for_src_state(e, src, lo, hi, t, 0, 0);
    e->undo_src(lo, hi);
    nr = Engine_rules_for_src_state(e, src, lo, hi, t, nr, 1);
    e->redo_src(lo, hi);
    if (!nr) { e->cnt_src++; return 1; }
    int grp = 0;
    for (int i = 0; i < nr; i++) grp |= t[i].grp;
    qsort(t, (size_t)nr, sizeof(InvRule), inv_rule_cmp);
    int nopen = 0;
    while (nopen < nr && !t[nopen].key) nopen++;
    int nc = 0;
    if (grp & (GRP_CHILD | GRP_DESC | GRP_WIDE))
        e->collect_kind(src, KIND_CHILD, KIND_DEEP, (grp & (GRP_DESC | GRP_WIDE)) != 0, &nc);
    if (grp & (GRP_FOLLOW | GRP_WIDE)) {
        for (int s = e->nodes[src].next_sib; s >= 0; s = e->nodes[s].next_sib) {
            if (e->nodes[s].dead) continue;
            int before = nc;
            e->push_inv(s, &nc);
            if (nc > before) e->inv_off[before] = KIND_FOLLOW;
            if (grp & GRP_WIDE)
                e->collect_kind(s, KIND_FDESC, KIND_FDESC, 1, &nc);
        }
    }
    if (e->fo_n + nc > e->fo_cap) return 0;
    e->cnt_src++;
    e->cnt_rules += nr;
    e->cnt_cand += nc;
    if (!nc) return 1;
    int job = e->fo_njobs++;
    e->fo_jobs[job].rb = e->fo_rn;
    e->fo_jobs[job].re = e->fo_rn + nr;
    e->fo_jobs[job].nopen = nopen;
    e->fo_rn += nr;
    for (int i = 0; i < nc; i++) {
        int d = e->inv_ids[i];
        e->fo_ids[e->fo_n] = d;
        e->fo_off[e->fo_n] = e->inv_off[i];
        e->fo_job[e->fo_n] = job;
        e->fo_n++;
    }
    return 1;
}

/* Signature pass over a run of staged candidates. pre == 0 records the
 * applied-state signature; pre == 1 compares the undone state against it
 * and dirties on a flip. Reads the tree only; dirty is write-once. */
static void Engine_fo_arm(Engine* e, int n, int arm, int sz, int pre) {
    int lo = arm * sz;
    int hi = lo + sz < n ? lo + sz : n;
    for (int k = lo; k < hi; k++) {
        int d = e->fo_ids[k];
        if (e->nodes[d].dirty) {
            if (!pre) e->fo_sig[k] = 0;
            continue;
        }
        const SrcJob* j = &e->fo_jobs[e->fo_job[k]];
        uint64_t sig = Engine_match_sig(e, d, e->fo_rules + j->rb, j->re - j->rb,
                                        j->nopen, e->fo_off[k]);
        if (!pre) e->fo_sig[k] = sig;
        else if (sig != e->fo_sig[k]) e->nodes[d].dirty = 1;
    }
}

/* Serial form for a source the staging scratch could not hold. */
static void Engine_dirty_desc(Engine* e, int src) {
    for (int c = e->nodes[src].first_child; c >= 0; c = e->nodes[c].next_sib) {
        if (e->nodes[c].dead) continue;
        e->nodes[c].dirty = 1;
        e->dirty_desc(c);
    }
}

/* Dirty N. Join flip is the batch (all changes vs all undone), walked
 * from each changed node once; the log is grouped by node first. */
static int arm_size(int n);
static int arm_count(int n);
static void Engine_fo_flush(Engine* eng) {
    int nc = eng->fo_n;
    if (nc) {
        int na = arm_count(nc);
        int sz = arm_size(nc);
        if (na <= 1) {
            Engine_fo_arm(eng, nc, 0, sz, 0);
        } else {
            @parallel for (a in 0..na) {
                Engine_fo_arm(eng, nc, a, sz, 0);
            } !>.wait()!>;
        }
        eng->undo_all();
        if (na <= 1) {
            Engine_fo_arm(eng, nc, 0, sz, 1);
        } else {
            @parallel for (a in 0..na) {
                Engine_fo_arm(eng, nc, a, sz, 1);
            } !>.wait()!>;
        }
        eng->redo_all();
    }
    eng->fo_n = 0;
    eng->fo_rn = 0;
    eng->fo_njobs = 0;
}

/* Every changed node is dirty itself. Then each unique changed node is
 * staged (rule table + candidates, serial), and the staged batch runs its
 * two signature passes in parallel; a full scratch flushes early and the
 * source is staged again into the empty one. */
static void Engine_fanout_dirty(Engine* e) {
    int n = e->nnodes;
    for (int i = 0; i < e->nchanges; i++) {
        Change* ch = &e->changes[i];
        int id = ch->node;
        if (id < 0 || id >= n) continue;
        if (e->nodes[id].dead) continue;
        e->nodes[id].dirty = 1;
    }
    e->fo_n = 0;
    e->fo_rn = 0;
    e->fo_njobs = 0;
    for (int i = 0; i < e->nchanges; i++)
        e->chg_order[i] = ((uint64_t)(uint32_t)e->changes[i].node << 32) | (uint32_t)i;
    qsort(e->chg_order, (size_t)e->nchanges, sizeof(uint64_t), u64_cmp);
    for (int lo = 0; lo < e->nchanges;) {
        int id = e->changes[CHG_IDX(e->chg_order[lo])].node;
        int hi = lo + 1;
        while (hi < e->nchanges && (int)(e->chg_order[hi] >> 32) == id) hi++;
        if (id >= 0 && id < n && !e->nodes[id].dead) {
            if (!Engine_stage_src(e, id, lo, hi)) {
                Engine_fo_flush(e);
                Engine_stage_src(e, id, lo, hi);
            }
        }
        lo = hi;
    }
    Engine_fo_flush(e);
    e->nchanges = 0;
}

/* Viewport moved. The fact is per rule — its media row flipped — and the
 * nodes it touches are exactly the ones that match it, on or off. So:
 * table of flipped rules (keyed by subject like a staged batch), one
 * signature pass over every live node with those rules forced on, dirty
 * on any hit, then the rules take their new state. */
static void Engine_mq_arm(Engine* e, int n, int arm, int sz, int nt, int nopen) {
    int lo = arm * sz;
    int hi = lo + sz < n ? lo + sz : n;
    for (int d = lo; d < hi; d++) {
        if (e->nodes[d].dead || e->nodes[d].dirty) continue;
        if (Engine_match_sig(e, d, e->fo_rules, nt, nopen, KIND_CHILD))
            e->nodes[d].dirty = 1;
    }
}

static void Engine_media_dirty(Engine* eng) {
    eng->resized = 0;
    int nt = 0;
    InvRule* t = eng->fo_rules;
    for (int k = 0; k < eng->nrules && nt < eng->fo_rcap; k++) {
        Rule* r = &eng->rules[k];
        if (r->mq < 0 || !r->n) continue;
        int off = !eng->mq_on(r->mq);
        if (off == r->off) continue;
        r->off = 0;
        t[nt].key = compound_key(&r->c[r->n - 1]).ptr;
        t[nt].k = k;
        t[nt].grp = GRP_CHILD | GRP_DESC | GRP_FOLLOW | GRP_WIDE;
        nt++;
    }
    if (!nt) return;
    qsort(t, (size_t)nt, sizeof(InvRule), inv_rule_cmp);
    int nopen = 0;
    while (nopen < nt && !t[nopen].key) nopen++;
    int nn = eng->nnodes;
    int na = arm_count(nn);
    int sz = arm_size(nn);
    if (na <= 1) {
        Engine_mq_arm(eng, nn, 0, sz, nt, nopen);
    } else {
        @parallel for (a in 0..na) {
            Engine_mq_arm(eng, nn, a, sz, nt, nopen);
        } !>.wait()!>;
    }
    for (int i = 0; i < nt; i++) {
        Rule* r = &eng->rules[t[i].k];
        r->off = !eng->mq_on(r->mq);
    }
    eng->cnt_rules += nt;
}

static void Engine_clear_dirty(Engine* e) {
    for (int i = 0; i < e->nnodes; i++) {
        e->nodes[i].dirty = 0;
        e->nodes[i].inh_dirty = 0;
    }
}

/* Dirty nodes start over. Their inherited structs are snapshotted first:
 * after the restyle, a node whose inherited values came out different
 * sends its clean children through inherit again. */
static void Engine_reset_dirty(Engine* e) {
    int k = 0;
    for (int i = 0; i < e->nnodes; i++) {
        Node* n = &e->nodes[i];
        if (!n->dirty) continue;
        Sty_snap(&n->sty, n->own, &e->snaps[k]);
        e->snap_of[i] = k++;
        Node_reset_style(n);
        nv_reset_spec(nv_at(e, i));
        e->reset_pseudo(i);
    }
}

/* A sharer takes the canon's owned structs by value into its own slots
 * and its views by pointer. Clone, not alias: incremental inherit is
 * dirty-only, and a dirty node writing into a struct a clean twin still
 * views would change the twin's computed style. Stylo pays an Arc here. */
static void Engine_copy_specified(Engine* e, int dst, int src) {
    Node* d = &e->nodes[dst];
    Node* s = &e->nodes[src];
    Sty_clone(&d->sty, &s->sty, s->own, e->fpool, dst);
    d->own = s->own;
    memcpy(d->specified, s->specified, sizeof(d->specified));
    if (e->vtab) {
        NodeVars* dv = &e->vtab[dst];
        NodeVars* sv = &e->vtab[src];
        dv->nvar_spec = sv->nvar_spec;
        dv->npvar = sv->npvar;
        for (int k = 0; k < sv->nvar_spec; k++) {
            dv->var_spec_n[k] = sv->var_spec_n[k];
            dv->var_spec_v[k] = sv->var_spec_v[k];
        }
        for (int k = 0; k < sv->npvar; k++) {
            dv->pvar_prop[k] = sv->pvar_prop[k];
            dv->pvar_raw[k] = sv->pvar_raw[k];
        }
    }
    for (int p = 0; p < 2; p++) {
        Node* dp = &e->pnodes[2 * dst + p];
        Node* sp = &e->pnodes[2 * src + p];
        int dslot = e->cap_nodes + 2 * dst + p;
        int sslot = e->cap_nodes + 2 * src + p;
        Sty_clone(&dp->sty, &sp->sty, sp->own, e->fpool, dslot);
        dp->own = sp->own;
        memcpy(dp->specified, sp->specified, sizeof(dp->specified));
        if (e->vtab) {
            NodeVars* dv = &e->vtab[dslot];
            NodeVars* sv = &e->vtab[sslot];
            dv->nvar_spec = sv->nvar_spec;
            dv->npvar = sv->npvar;
            for (int k = 0; k < sv->nvar_spec; k++) {
                dv->var_spec_n[k] = sv->var_spec_n[k];
                dv->var_spec_v[k] = sv->var_spec_v[k];
            }
            for (int k = 0; k < sv->npvar; k++) {
                dv->pvar_prop[k] = sv->pvar_prop[k];
                dv->pvar_raw[k] = sv->pvar_raw[k];
            }
        }
    }
}


static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

/* One arm is a run of nodes, not a node. The runtime gates spawn on
 * leaf-arm cost (CC_PAR_CHURN_NS, 8us): a one-node arm sits on that
 * line and the verdict flips per run. ARM_MIN nodes is unambiguous;
 * above that, enough arms to feed every worker a few times over. */
#define ARM_MIN 32
static int arm_size(int n) {
    size_t w = cc_sched_get_num_workers();
    int target = (int)(w ? w * 4 : 16);
    int sz = n / target;
    return sz < ARM_MIN ? ARM_MIN : sz;
}

static int arm_count(int n) {
    int sz = arm_size(n);
    return n > 0 ? (n + sz - 1) / sz : 0;
}

static void Engine_sig_arm(Engine* e, const int* ids, int n, int arm) {
    int sz = arm_size(n);
    int lo = arm * sz;
    int hi = lo + sz < n ? lo + sz : n;
    for (int k = lo; k < hi; k++)
        Engine_sib_sig(e, ids ? ids[k] : k);
}

/* One hit list per arm. The worker count is only known once the
 * scheduler runs, so the scratch grows to the arm count at the call. */
static int Engine_ensure_hits(Engine* e, int na) {
    if (na <= e->max_arms) return 1;
    Hit* scratch = (Hit*)cc_arena_alloc(e->store, sizeof(Hit) * (size_t)na * 3 * HIT_CAP, 16);
    if (!scratch) return 0;
    e->hit_scratch = scratch;
    e->max_arms = na;
    return 1;
}

static void Engine_style_arm(Engine* e, int n, int arm, int dirty_only) {
    int sz = arm_size(n);
    int lo = arm * sz;
    int hi = lo + sz < n ? lo + sz : n;
    Hits hs;
    for (int t = 0; t < 3; t++) {
        hs.h[t] = e->hit_scratch + ((size_t)arm * 3 + (size_t)t) * HIT_CAP;
        hs.n[t] = 0;
    }
    hs.dropped = 0;
    for (int k = lo; k < hi; k++) {
        int i = e->share_ents[k].i;
        if (!dirty_only || e->nodes[i].dirty)
            e->style_one(i, &hs);
    }
    if (hs.dropped) e->cnt_hits_dropped += hs.dropped;
}

static void !>(CCError) Engine_style_all(Engine* eng) {
    EngineMatch m = eng;
    double t0 = now_ms();
    m->paint_levels();
    int nn = eng->nnodes;
    int na = arm_count(nn);
    if (eng->pseudo_used) {
        int sz = arm_size(nn);
        @parallel for (a in 0..na) {
            Engine_pos_arm(eng, nn, a, sz);
        } !>.wait()!>;
    }
    eng->t_levels = now_ms() - t0;
    t0 = now_ms();
    @parallel for (a in 0..na) {
        Engine_sig_arm(eng, 0, nn, a);
    } !>.wait()!>;
    eng->build_share();
    eng->t_share = now_ms() - t0;
    int nc = eng->ncanon;
    t0 = now_ms();
    na = arm_count(nc);
    if (!Engine_ensure_hits(eng, na)) return cc_err(CC_ERR_OUT_OF_MEMORY, "hit scratch");
    @parallel for (a in 0..na) {
        Engine_style_arm(eng, nc, a, 0);
    } !>.wait()!>;
    for (int i = 0; i < eng->nnodes; i++) {
        if (eng->share_of[i] != i)
            m->copy_specified(i, eng->share_of[i]);
    }
    eng->t_match = now_ms() - t0;
    t0 = now_ms();
    int maxd = eng->max_depth;
    int hi = (maxd + 1 < 64) ? eng->level_off[maxd + 1] : 0;
    for (int k = 0; k < hi; k++)
        m->inherit_one(eng->level_ids[k]);
    eng->t_inherit = now_ms() - t0;
    return cc_ok();
}

static void !>(CCError) Engine_style_dirty(Engine* eng) {
    EngineMatch m = eng;
    double t0 = now_ms();
    if (eng->levels_stale) {
        m->paint_levels();
        eng->levels_stale = 0;
    }
    eng->t_levels = now_ms() - t0;
    t0 = now_ms();
    int nd = 0;
    for (int i = 0; i < eng->nnodes; i++)
        if (eng->nodes[i].dirty && !eng->nodes[i].dead)
            eng->inv_ids[nd++] = i;
    int na = arm_count(nd);
    if (na <= 1) {
        Engine_sig_arm(eng, eng->inv_ids, nd, 0);
    } else {
        @parallel for (a in 0..na) {
            Engine_sig_arm(eng, eng->inv_ids, nd, a);
        } !>.wait()!>;
    }
    eng->last_dirty = nd;
    eng->sum_sig += now_ms() - t0;
    double t1 = now_ms();
    eng->rebuild_share_dirty();
    eng->sum_canon += now_ms() - t1;
    eng->t_share = now_ms() - t0;
    int nc = eng->ncanon;
    t0 = now_ms();
    na = arm_count(nc);
    if (!Engine_ensure_hits(eng, na)) return cc_err(CC_ERR_OUT_OF_MEMORY, "hit scratch");
    @parallel for (a in 0..na) {
        Engine_style_arm(eng, nc, a, 1);
    } !>.wait()!>;
    eng->sum_match += now_ms() - t0;
    t1 = now_ms();
    for (int i = 0; i < eng->nnodes; i++) {
        if (!eng->nodes[i].dirty) continue;
        if (eng->share_of[i] != i)
            m->copy_specified(i, eng->share_of[i]);
    }
    eng->sum_copy += now_ms() - t1;
    eng->t_match = now_ms() - t0;
    t0 = now_ms();
    /* Top-down. A dirty node re-inherits after its match; a clean node
     * re-inherits when its parent's inherited structs came out changed
     * (inh_dirty). A node that views an inherited family through its
     * parent changed with it; one that owns the family compares values.
     * Either way, a change here marks the children before their level. */
    int maxd = eng->max_depth;
    int hi = (maxd + 1 < 64) ? eng->level_off[maxd + 1] : 0;
    for (int k = 0; k < hi; k++) {
        int i = eng->level_ids[k];
        Node* n = &eng->nodes[i];
        if (!n->dirty && !n->inh_dirty) continue;
        StySnap before;
        const StySnap* snap = &before;
        if (n->dirty) snap = &eng->snaps[eng->snap_of[i]];
        else Sty_snap(&n->sty, n->own, &before);
        m->inherit_one(i);
        int views = (n->inh_dirty && (~n->own & INH_FAM_MASK)) != 0;
        if (views || Sty_snap_differs(&n->sty, snap) || (eng->vtab && eng->vtab[i].changed))
            m->mark_children(i);
    }
    eng->t_inherit = now_ms() - t0;
    eng->sum_inherit += eng->t_inherit;
    return cc_ok();
}

static int slice_eq_lit(CCSlice s, const char* lit) {
    return s.eq_cstr(lit);
}

static int parse_int_slice(CCSlice s) {
    return (int)(s.to_i64() ?> 0);
}

static void !>(CCError) Engine_ingest_muts(Engine* e, char[:] text) {
    size_t pos = 0;
    while (ingest_skip_blank(text, &pos, 0)) {
        CCSlice line = ingest_take_line(text, &pos);
        if (!line.len) continue;
        if (e->nmuts >= e->cap_muts)
            return cc_err(CC_ERR_INVALID_ARG, "too many muts");
        MutOp* m = &e->muts[e->nmuts];
        memset(m, 0, sizeof(*m));
        if (slice_eq_lit(line, "restyle")) {
            m->kind = MUT_RESTYLE;
            e->nmuts++;
            continue;
        }
        CCSlice cols[8];
        int nc = split_tabs(line, cols, 8);
        if (slice_eq_lit(cols[0], "+class") && nc >= 3) {
            m->kind = MUT_ADD_CLASS;
            m->id = parse_int_slice(cols[1]);
            m->a = cols[2];
        } else if (slice_eq_lit(cols[0], "-class") && nc >= 2) {
            m->kind = MUT_REMOVE_CLASS;
            m->id = parse_int_slice(cols[1]);
        } else if (slice_eq_lit(cols[0], "+attr") && nc >= 3) {
            m->kind = MUT_SET_ATTR;
            m->id = parse_int_slice(cols[1]);
            split_eq(cols[2], &m->a, &m->b);
        } else if (slice_eq_lit(cols[0], "-attr") && nc >= 3) {
            m->kind = MUT_REMOVE_ATTR;
            m->id = parse_int_slice(cols[1]);
            m->a = cols[2];
        } else if (slice_eq_lit(cols[0], "+leaf") && nc >= 6) {
            m->kind = MUT_ADD_LEAF;
            m->id = parse_int_slice(cols[1]);
            m->parent = parse_int_slice(cols[2]);
            m->at = parse_int_slice(cols[3]);
            m->a = cols[4];
            m->b = cols[5];
            m->classes = nc > 6 ? cols[6] : cc_slice_empty();
            m->attrs = nc > 7 ? cols[7] : cc_slice_empty();
        } else if (slice_eq_lit(cols[0], "-leaf") && nc >= 2) {
            m->kind = MUT_REMOVE_LEAF;
            m->id = parse_int_slice(cols[1]);
        } else if (slice_eq_lit(cols[0], "resize") && nc >= 2) {
            m->kind = MUT_RESIZE;
            m->id = parse_int_slice(cols[1]);
        } else {
            return cc_err(CC_ERR_PARSE, "mut line");
        }
        e->nmuts++;
    }
    return cc_ok();
}

static int Engine_ensure_class_cap(Engine* e, Node* n, int need) {
    if (n->cap_class >= need) return 1;
    int cap = n->cap_class ? n->cap_class * 2 : MAX_CLASS;
    while (cap < need) cap *= 2;
    CCSlice* p = e->store.allocT::[CCSlice](cap);
    if (!p) return 0;
    if (n->classes && n->nclass && !copy_ccslice_arr(p, n->classes, n->nclass)) return 0;
    n->classes = p;
    n->cap_class = cap;
    return 1;
}

static int Engine_ensure_attr_cap(Engine* e, Node* n, int need) {
    if (n->cap_attr >= need) return 1;
    int cap = n->cap_attr ? n->cap_attr * 2 : MAX_ATTR;
    while (cap < need) cap *= 2;
    Attr* p = e->store.allocT::[Attr](cap);
    if (!p) return 0;
    if (n->attrs && n->nattr)
        memcpy(p, n->attrs, sizeof(Attr) * (size_t)n->nattr);
    n->attrs = p;
    n->cap_attr = cap;
    return 1;
}

static void Engine_apply_mut(Engine* e, MutOp* m) {
    if (m->kind == MUT_RESIZE) {
        if (m->id != e->viewport_w) e->resized = 1;
        e->viewport_w = m->id;
        return;
    }
    if (m->kind == MUT_ADD_LEAF) {
        if (m->id != e->nnodes || e->nnodes >= e->cap_nodes) return;
        Node* nd = &e->nodes[e->nnodes];
        e->fill_node(nd, -1, m->a, m->b, m->classes, m->attrs);
        e->insert_child(m->parent, m->at, e->nnodes);
        nd->dirty = 1;
        e->levels_stale = 1;
        e->nnodes++;
        nd->pos = Engine_pos_of(e, m->id);
        e->repos_family(m->parent);
        e->note_leaf_op(m->id, m->parent);
        if (e->has_sib_comb)
            e->dirty_following(m->id);
        return;
    }
    if (m->id < 0 || m->id >= e->nnodes) return;
    Node* n = &e->nodes[m->id];
    if (m->kind == MUT_REMOVE_LEAF) {
        if (e->has_sib_comb)
            e->dirty_following(m->id);
        int p = n->parent;
        int prev = n->prev_sib;
        int next = n->next_sib;
        if (prev >= 0)
            e->nodes[prev].next_sib = next;
        else if (p >= 0)
            e->nodes[p].first_child = next;
        if (next >= 0)
            e->nodes[next].prev_sib = prev;
        else if (p >= 0)
            e->nodes[p].last_child = prev;
        n->next_sib = -1;
        n->prev_sib = -1;
        n->dead = 1;
        n->parent = -1;
        e->repos_family(p);
        e->note_leaf_op(m->id, p);
        return;
    }
    if (n->dead) return;
    if (m->kind == MUT_ADD_CLASS) {
        CCSlice c = e->intern(m->a);
        if (n->has_class(&c)) return;
        if (!e->ensure_class_cap(n, n->nclass + 1)) return;
        n->classes[n->nclass++] = c;
        n->dirty = 1;
        e->log_change(m->id, CH_ADD_CLASS, c, cc_slice_empty(), cc_slice_empty());
        if (e->nchanges) e->changes[e->nchanges - 1].idx = n->nclass - 1;
    } else if (m->kind == MUT_REMOVE_CLASS) {
        if (n->nclass <= 0) return;
        CCSlice gone = n->classes[0];
        for (int i = 1; i < n->nclass; i++)
            n->classes[i - 1] = n->classes[i];
        n->nclass--;
        n->dirty = 1;
        e->log_change(m->id, CH_DEL_CLASS, gone, cc_slice_empty(), cc_slice_empty());
    } else if (m->kind == MUT_SET_ATTR) {
        CCSlice name = e->intern(m->a);
        CCSlice val = e->intern(m->b);
        /* First entry with the name is replaced; a duplicate later in the
         * list stays (fixtures carry them, Stylo's host keeps them too).
         * The slot goes in the log so undo restores exactly that entry. */
        for (int i = 0; i < n->nattr; i++) {
            if (slices_eq(&n->attrs[i].name, &name)) {
                CCSlice old = n->attrs[i].value;
                n->attrs[i].value = val;
                n->dirty = 1;
                e->log_change(m->id, CH_SET_ATTR, name, old, val);
                if (e->nchanges) e->changes[e->nchanges - 1].idx = i;
                if (name.eq_cstr("style")) e->set_inline_rule(n);
                return;
            }
        }
        if (!e->ensure_attr_cap(n, n->nattr + 1)) return;
        n->attrs[n->nattr].name = name;
        n->attrs[n->nattr].value = val;
        n->nattr++;
        n->dirty = 1;
        e->log_change(m->id, CH_SET_ATTR, name, cc_slice_empty(), val);
        if (e->nchanges) e->changes[e->nchanges - 1].idx = -1;
        if (name.eq_cstr("style")) e->set_inline_rule(n);
    } else if (m->kind == MUT_REMOVE_ATTR) {
        /* Every entry with the name goes. One log record per entry, in
         * decreasing slot order: redo (forward) removes from the top so
         * lower slots hold, undo (reverse) re-inserts bottom-up. */
        CCSlice name = e->intern(m->a);
        int any = 0;
        for (int i = n->nattr - 1; i >= 0; i--) {
            if (!slices_eq(&n->attrs[i].name, &name)) continue;
            e->log_change(m->id, CH_DEL_ATTR, name, n->attrs[i].value, cc_slice_empty());
            if (e->nchanges) e->changes[e->nchanges - 1].idx = i;
            any = 1;
        }
        if (!any) return;
        int w = 0;
        for (int i = 0; i < n->nattr; i++) {
            if (slices_eq(&n->attrs[i].name, &name)) continue;
            n->attrs[w++] = n->attrs[i];
        }
        n->nattr = w;
        n->dirty = 1;
        if (name.eq_cstr("style")) e->set_inline_rule(n);
    }
}

static size_t unique_node_shards(CCShardMask mask, const int* ids, int nids,
                                uint64_t* names, size_t cap) {
    size_t n = 0;
    for (int i = 0; i < nids; i++) {
        uint64_t si = (uint64_t)mask.index((uint64_t)(uint32_t)ids[i]);
        int seen = 0;
        for (size_t j = 0; j < n; j++)
            if (names[j] == si) { seen = 1; break; }
        if (!seen && n < cap) names[n++] = si;
    }
    return n;
}

static void !>(CCError) Engine_run_mutations(Engine* e, CCShardDomain* domain, double* mut_ms) {
    int start = 0;
    *mut_ms = 0;
    while (start < e->nmuts) {
        int end = start;
        while (end < e->nmuts && e->muts[end].kind != MUT_RESTYLE)
            end++;
        int ids[256];
        int nids = 0;
        for (int i = start; i < end; i++) {
            MutOp* m = &e->muts[i];
            if (m->kind == MUT_ADD_LEAF) {
                if (nids < 256) ids[nids++] = m->parent;
                if (nids < 256) ids[nids++] = m->id;
            } else if (m->kind != MUT_RESTYLE && m->kind != MUT_RESIZE) {
                if (nids < 256) ids[nids++] = m->id;
            }
        }
        if (end > start) {
            uint64_t names[MAX_SHARDS];
            size_t nnames = unique_node_shards(domain->mask, ids, nids, names, MAX_SHARDS);
            CCShardHold hold = nnames
                ? domain->hold_sorted(names, nnames)
                : domain->hold_all();
            @defer hold.release();
            if (!hold.held())
                return cc_err(CC_ERR_INVALID_ARG, "shard admission failed");
            EngineMut mut = e;
            for (int i = start; i < end; i++)
                mut->apply_mut(&e->muts[i]);
        }
        if (end < e->nmuts && e->muts[end].kind == MUT_RESTYLE) {
            /* Invalidation is on the clock, as Stylo's invalidator is
             * inside traverse_dom. Only the DOM edits above are not. */
            double t0 = now_ms();
            e->paint_blooms_dirty();
            e->sum_blooms += now_ms() - t0;
            double tf = now_ms();
            e->fanout_dirty();
            if (e->resized) e->media_dirty();
            e->sum_fanout += now_ms() - tf;
            e->reset_dirty();
            e->style_dirty() !>;
            *mut_ms += now_ms() - t0;
            e->sum_dirty += e->last_dirty;
            e->clear_dirty();
            start = end + 1;
        } else {
            start = end;
        }
    }
    return cc_ok();
}

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    CCArena store = cc_arena_heap(megabytes(128)) @destroy;
    CCStdio io = cc_stdio_create(store);
    char[:] path = argc > 1
        ? cc_slice_cstr(argv[1])
        : @slice("fixtures/tiny.stylebench");
    char[:] text = path.read_path(store) !>;

    /* Pool size, like Stylo's STYLE_THREAD_POOL cap. Unset = every core. */
    const char* wenv = getenv("CC_STYLE_WORKERS");
    if (wenv && atoi(wenv) > 0)
        cc_sched_set_num_workers((size_t)atoi(wenv));

    Engine eng = {0};
    eng.store = store;
    eng.load_fixture(text) !>;

    double t0 = now_ms();
    eng.style_all() !>;
    double ms = now_ms() - t0;
    CCSchedulerStats st0 = {0};
    cc_scheduler_stats(&st0);
    eng.t0_levels = eng.t_levels;
    eng.t0_share = eng.t_share;
    eng.t0_match = eng.t_match;
    eng.t0_inherit = eng.t_inherit;
    int ncanon0 = eng.ncanon;

    CCArena excl_arena = cc_arena_heap(megabytes(2)) @destroy;
    CCShardMask mask = cc_shard_mask_auto(MAX_SHARDS);
    if (!mask.count) mask = cc_shard_mask_make(1u);
    CCExclusive excl = cc_exclusive_create(excl_arena, mask.count * 2u) !> @destroy;
    CCShardDomain domain = cc_shard_domain(excl, mask);
    double mut_ms = 0;
    eng.run_mutations(&domain, &mut_ms) !>;
    CCSchedulerStats st1 = {0};
    cc_scheduler_stats(&st1);

    int live = 0;
    for (int i = 0; i < eng.nnodes; i++)
        if (!eng.nodes[i].dead) live++;

    io.println(@string(`# runner=cc fixture=${path}`, @scratch));
    io.println(@string(`# TIME_MS=${ms} TIME_MUT_MS=${mut_ms} elements=${live} TIME_LEVELS=${eng.t0_levels} TIME_SHARE=${eng.t0_share} TIME_MATCH=${eng.t0_match} TIME_INHERIT=${eng.t0_inherit} LAST_MATCH=${eng.t_match} LAST_SHARE=${eng.t_share} LAST_INHERIT=${eng.t_inherit} LAST_DIRTY=${eng.last_dirty} SUM_DIRTY=${eng.sum_dirty} WORKERS=${st0.workers}/${st1.workers} MUT_FANOUT=${eng.sum_fanout} SRC=${eng.cnt_src} CAND=${eng.cnt_cand} RULES=${eng.cnt_rules} MUT_BLOOMS=${eng.sum_blooms} MUT_SIG=${eng.sum_sig} MUT_CANON=${eng.sum_canon} MUT_MATCH=${eng.sum_match} MUT_COPY=${eng.sum_copy} MUT_INHERIT=${eng.sum_inherit} canons=${ncanon0} depth=${eng.max_depth} rules=${eng.nrules} univ=${eng.universal.len} hits_dropped=${eng.cnt_hits_dropped}`, @scratch));
    /* One row per live element, then its live pseudo boxes: Stylo's
     * `name=value` for every content longhand, in Stylo's id order. */
    static char linebuf[1 << 16];
    for (int i = 0; i < eng.nnodes; i++) {
        Node* n = &eng.nodes[i];
        if (n->dead) continue;
        CCSlice id = n->dom_id.len ? n->dom_id : @slice("-");
        for (int t = 0; t < 3; t++) {
            const Node* q = t == 0 ? n : &eng.pnodes[2 * i + t - 1];
            if (t && !eng.pseudo_live(i, t - 1)) continue;
            CCSlice tag = t == 0 ? n->tag : t == 1 ? @slice("::before") : @slice("::after");
            CssOut o = { linebuf, 0, sizeof linebuf };
            int hn = snprintf(linebuf, sizeof linebuf, "%d\t%.*s\tid=%.*s", i,
                              (int)tag.len, tag.ptr, (int)id.len, id.ptr);
            o.n = hn > 0 ? (size_t)hn : 0;
            Sty_dump(&q->sty, eng.atoms, &o);
            css_out_str(&o, "\n");
            io.write_all(cc_slice_from_buffer(linebuf, o.n)) !>;
        }
    }
    return 0;
}
