#!ccc ccs
/*
 * StyleBench restyle. Same fixture as stylo-runner.
 * Frame: @grammar + arena views. Packed compounds; subject maps;
 * tokens interned at fill (owned pool, pointer eq); ancestor bloom +
 * inverted parent>* and (subject, left) pair maps; match_from on the join.
 * Specified props match in @parallel for on share canons (same parent +
 * interned tag / id / classes / attrs). Dirty restyle re-resolves share
 * from the sibling list only. Inherited font-size / line-height /
 * font-weight / visibility / color hop the parent in one serial depth walk.
 * Mutations: redis_idiomatic hold_sorted on node shards; change log at
 * apply_mut; fan-out from the left atom through pair / parent maps.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/stdio.cch>
#include <ccc/script/file.cch>
#include <ccc/cc_exclusive.cch>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_CLASS   32
#define MAX_ATTR    16
#define MAX_SELCOMP 16
#define MAX_SHARDS  64
#define PX_AUTO   (-1)
#define PX_NORMAL (-2)
#define INIT_FS_PX 16
#define INIT_FW    400
#define UNIT_PX    0
#define UNIT_EM    1
#define UNIT_PCT   2
#define UNIT_REM   3

/* Specified values live on the rule. Used on the node is proto pointers
 * (initial / parent / this node's slot). Miss: inherit → parent struct,
 * reset → initial. fill_rule / inherit_one / dump stay handwritten. */
typedef struct {
    int r;
    int g;
    int b;
    int a;
} CssRgba;

typedef struct {
    int r;
    int g;
    int b;
} CssRgb;

typedef struct {
    CssRgba bg;
} StyBg;

typedef struct {
    int height_px;
    int minw_px;
    int width_px;
    CCSlice display;
    CCSlice position;
} StyBox;

typedef struct {
    int fs_px;
    int lh_px;
    int fw;
    CssRgb color;
    CCSlice visibility;
} StyFont;

typedef struct {
    StyBg bg;
    StyBox box;
    StyFont font;
} Specified;

typedef struct {
    StyBg* bg;
    StyBox* box;
    StyFont* font;
} Used;

/* P_* by group so N_BG / N_BOX / N_FONT are counts. String reflect —
 * type_of in @comptime { } still fails in this TU. */
@comptime {
    const char* groups[3] = { "StyBg", "StyBox", "StyFont" };
    const char* nnames[3] = { "N_BG", "N_BOX", "N_FONT" };
    int idx = 0;
    cc_emit_format(CC_EMIT_AFTER_PRELUDE, "enum {\n");
    for (int g = 0; g < 3; g++) {
        int n = cc_reflect_field_count(groups[g]);
        for (int i = 0; i < n; i++) {
            char nm[128];
            cc_reflect_field_name(groups[g], i, nm, sizeof(nm));
            cc_emit_format(CC_EMIT_AFTER_PRELUDE, "    P_%s = %d,\n", nm, idx);
            idx++;
        }
        cc_emit_format(CC_EMIT_AFTER_PRELUDE, "    %s = %d,\n", nnames[g], n);
    }
    cc_emit_format(CC_EMIT_AFTER_PRELUDE, "    NPROP = %d\n};\n", idx);
}

static const Specified SPEC_INIT = {
    .bg = {{0, 0, 0, 0}},
    .box = {PX_AUTO, PX_AUTO, PX_AUTO, {0}, {0}},
    .font = {INIT_FS_PX, PX_NORMAL, INIT_FW, {0, 0, 0}, {0}},
};

@grammar(rules) Css {~~~~
    top: stylesheet
    stylesheet: collect [any [comment | some wschar | rule]]

    wschar: charset [#' ' #'\t' #'\r' #'\n' #'\x0C']
    ws:     any wschar

    hexa:     charset [#'0' - #'9' #'a' - #'f' #'A' - #'F']
    notesc:   complement charset [#'0' - #'9' #'a' - #'f' #'A' - #'F' #'\t' #'\n' #'\r' #'\x0C']
    escape:   [#'\\' [notesc | hexa opt hexa opt hexa opt hexa opt hexa opt hexa]]
    nonascii: complement charset [#'\0' - #'\x7F']

    nmstart: charset [#'_' #'a' - #'z' #'A' - #'Z']
    nmchar:  charset [#'_' #'a' - #'z' #'A' - #'Z' #'0' - #'9' #'-']
    ident:   [opt #'-' nmstart any [nmchar | nonascii | escape]]
    name:    some [nmchar | nonascii | escape]
    digit:   charset [#'0' - #'9']
    number:  keep [opt [#'+' | #'-'] some digit]

    comment: [block_comment | html_comment]
    block_comment: ["/*" any [not "*/" skip] "*/"]
    html_comment:  ["<!--" any [not "-->" skip] "-->"]

    dstr: complement charset [#'"' #'\n' #'\r']
    sstr: complement charset [#'\'' #'\n' #'\r']
    string: [[#'"' keep [any [dstr | nonascii | escape]] #'"']
            | [#'\'' keep [any [sstr | nonascii | escape]] #'\'']]

    type_sel:   keep ident
    universal:  keep #'*'
    hash:       [#'#' keep name]
    class:      [#'.' keep ident]
    attr:       collect [#'[' ws keep ident ws opt [#'=' ws attr_val] ws #']']
    attr_val:   [string | keep ident]

    compound: collect [
          [type_sel | universal] any [hash | class | attr]
        | some [hash | class | attr]
    ]
    combinator: keep [any wschar #'>' any wschar | some wschar]
    selector:   collect [compound any [combinator compound]]

    prop:      keep ident
    other_val: keep [some complement charset [#';' #'}' #'!']]
    rgb:       collect ["rgb" ws #'(' ws number ws #',' ws number ws #',' ws number ws #')']
    decl_val:  other_val
    important: collect [#'!' ws "important"]
    ; pad lives on decls — a leading ws on decl is hoisted out of FIRST,
    ; so `any decl` would miss a space after `{`.
    decl:      collect [prop ws #':' ws decl_val ws opt important ws opt #';']
    decls:     collect [ws any [decl ws]]
    rule:      collect [selector ws #'{' decls #'}']
~~~~}

@grammar(rules) Fixture {~~~~
    top: collect [preamble base_sec css_sec tree_sec opt mut_sec]
    preamble: any [file_comment | blank]
    file_comment: [#'#' charset [#' ' #'\t'] any complement charset [#'\n'] #'\n']
    blank: [any charset [#' ' #'\t'] #'\n']
    base_sec: ["---base---" opt #'\n' keep [any [not "---" skip]]]
    css_sec:  ["---css---"  opt #'\n' keep [any [not "---" skip]]]
    tree_sec: ["---tree---" opt #'\n' keep [any [not "---" skip]]]
    mut_sec:  ["---mut---"  opt #'\n' keep [any skip]]
~~~~}

@grammar(schema) TreeRow {~~~~
    rules [
        digit: charset [#'0' - #'9']
        num:   keep [opt #'-' some digit]
        cell:  keep [any complement charset [#'\t' #'\n']]
        nl:    opt #'\n'
    ]
    idx:     int num #'\t'
    parent:  int num #'\t'
    tag:     cell #'\t'
    dom_id:  cell #'\t'
    classes: cell #'\t'
    attrs:   cell
    nl
~~~~}

typedef struct {
    CCSlice name;
    CCSlice value;
    int equals;
} Attr;

typedef enum {
    MUT_ADD_CLASS = 0,
    MUT_REMOVE_CLASS,
    MUT_SET_ATTR,
    MUT_REMOVE_ATTR,
    MUT_ADD_LEAF,
    MUT_REMOVE_LEAF,
    MUT_RESTYLE
} MutKind;

typedef struct {
    MutKind kind;
    int id, parent, at;
    CCSlice a, b;
    CCSlice classes, attrs;
} MutOp;

typedef struct {
    int parent;
    int nclass, nattr;
    int cap_class, cap_attr;
    int dead;
    int dirty;
    int first_child, next_sib;
    int depth;
    unsigned specified;
    int spec_a[NPROP];
    int spec_b[NPROP];
    int spec_c[NPROP];
    int win_order[NPROP];
    int win_rank[NPROP];
    int fs_spec;
    int fs_unit;
    int bg_current;
    Used used;
    CCSlice tag;
    CCSlice dom_id;
    CCSlice* classes;
    Attr* attrs;
    uint64_t self, anc;
} Node;

typedef struct {
    int star, nclass, nattr;
    int sa, sb, sc;
    CCSlice type;
    CCSlice id;
    CCSlice* classes;
    CCSlice* attr_n;
    CCSlice* attr_v;
    int* attr_eq;
} Compound;

typedef struct {
    int star, nclass, nattr;
    int sa, sb, sc;
    CCSlice type;
    CCSlice id;
    CCSlice classes[MAX_CLASS];
    CCSlice attr_n[MAX_ATTR];
    CCSlice attr_v[MAX_ATTR];
    int attr_eq[MAX_ATTR];
} CompoundScratch;

typedef enum { COMB_DESC, COMB_CHILD } Comb;

typedef struct {
    char* subj;
    char* left;
} AtomPair;

static size_t cc_map_key_hash_AtomPair(AtomPair k) {
    uint64_t a = (uint64_t)(uintptr_t)k.subj;
    uint64_t b = (uint64_t)(uintptr_t)k.left;
    uint64_t h = a * 0x9E3779B97F4A7C15ULL ^ b;
    h ^= h >> 33;
    return (size_t)h;
}

static int cc_map_key_eq_AtomPair(AtomPair a, AtomPair b) {
    return a.subj == b.subj && a.left == b.left;
}

enum { ORIGIN_UA = 0, ORIGIN_AUTHOR = 1, ORIGIN_STYLE = 2 };

typedef struct {
    int n, sa, sb, sc, order, origin;
    unsigned props;
    unsigned imp;
    int fs_unit;
    int bg_current;
    Specified spec;
    Compound* c;
    Comb* comb;
} Rule;

typedef struct {
    uint64_t h;
    int i;
} ShareEnt;

/* Smallest fact from apply_mut: this interned atom changed on this node. */
enum { CH_ADD_CLASS = 0, CH_DEL_CLASS = 1, CH_SET_ATTR = 2, CH_DEL_ATTR = 3 };
typedef struct {
    int node;
    int how;
    CCSlice atom;
    CCSlice prev;
    CCSlice next;
} Change;

typedef struct {
    CCArena store;
    Node* nodes;
    int nnodes, cap_nodes;
    Rule* rules;
    int nrules, cap_rules;
    Map::[CCSlice, CCSlice] pool;
    Map::[CCSlice, Vec::[int]] by_id;
    Map::[CCSlice, Vec::[int]] by_class;
    Map::[CCSlice, Vec::[int]] by_type;
    Map::[CCSlice, Vec::[int]] by_parent_id;
    Map::[CCSlice, Vec::[int]] by_parent_class;
    Map::[CCSlice, Vec::[int]] by_parent_type;
    Map::[AtomPair, Vec::[int]] child_pairs;
    Map::[AtomPair, Vec::[int]] desc_pairs;
    Map::[CCSlice, Vec::[CCSlice]] child_from_left;
    Map::[CCSlice, Vec::[CCSlice]] desc_from_left;
    Map::[CCSlice, Vec::[int]] left_rules;
    Map::[CCSlice, Vec::[int]] live_id;
    Map::[CCSlice, Vec::[int]] live_class;
    Map::[CCSlice, Vec::[int]] live_type;
    Vec::[int] universal;
    Change* changes;
    int nchanges, cap_changes;
    int* inv_ids;
    int* inv_off;
    MutOp* muts;
    int nmuts, cap_muts;
    int* level_ids;
    int* level_off;
    int max_depth;
    int levels_stale;
    int* share_of;
    ShareEnt* share_ents;
    int ncanon;
    CCSlice ident_inline, ident_block, ident_div, ident_static, ident_visible;
    StyBg bg_init;
    StyBox box_init, box_block, box_inline;
    StyFont font_init;
    StyBg* bg_pool;
    StyBox* box_pool;
    StyFont* font_pool;
    double t_levels, t_share, t_match, t_inherit;
    double t0_levels, t0_share, t0_match, t0_inherit;
} Engine;

/* Redis Encode shape: restyle cannot mutate the tree; mut under hold
 * cannot restyle. Same object, narrower names.
 * https://github.com/sreekotay/concurrent-c/blob/main/docs/typehooks-typeviews.md */
@typeview Match on Engine {
    r: intern, match_from, apply_rule, apply_specified, apply_bucket, apply_pair,
       apply_pairs, apply_pairs_other, style_one, inherit_one, paint_levels,
       paint_blooms, copy_specified, own_bg, own_box, own_font, seal_box,
       ident_inline, ident_block, ident_div, ident_static, ident_visible,
       bg_init, box_init, font_init, box_block, box_inline,
       bg_pool, box_pool, font_pool,
       nnodes, nrules, rules, share_of,
       by_id, by_class, by_type, by_parent_id, by_parent_class, by_parent_type,
       child_pairs, desc_pairs, universal, level_ids, level_off, max_depth;
    rw: nodes;
};

@typeview Mutate on Engine {
    r: intern, fill_node, ensure_class_cap, ensure_attr_cap, apply_mut,
       log_change, note_live, forget_live, push_bucket, store, cap_nodes,
       cap_changes, live_class;
    rw: nodes, nnodes, nchanges, changes, levels_stale;
};

typedef @typeview(Match) Engine* EngineMatch;
typedef @typeview(Mutate) Engine* EngineMut;

static void !>(CCError) Engine_ingest_muts(Engine* e, char[:] text);
static int Node_match_compound(Node* n, const Compound* c);
static void Engine_note_live(Engine* e, int id);
static int Engine_ensure_class_cap(Engine* e, Node* n, int need);
static int Engine_ensure_attr_cap(Engine* e, Node* n, int need);

static CCSlice !>(CCError) CCSlice_read_path(CCSlice* path, CCArena arena) {
    return cc_file_read_path(*path, arena);
}

static CCSlice CssNode_span(CssNode* nd) {
    CCSlice v = cc_slice_empty();
    if (nd) nd->slice(&v);
    return v;
}

static int slice_has_gt(CCSlice s) {
    @for (ch in s)
        if (ch == '>') return 1;
    return 0;
}

static int split_commas(CCSlice cell, CCSlice* out, int cap) {
    int n = 0;
    size_t i = 0;
    while (i < cell.len && n < cap) {
        size_t j = i;
        while (j < cell.len && cell.ptr[j] != ',') j++;
        if (j > i) {
            out[n] = cell.sub(i, j);
            n++;
        }
        i = j < cell.len ? j + 1 : j;
    }
    return n;
}

static CCSlice Engine_intern(Engine* e, CCSlice src) {
    if (!src.len || !src.ptr) return cc_slice_empty();
    CCSlice* hit = e->pool->get_ptr(src);
    if (hit) return *hit;
    CCSlice owned = src.clone_into(e->store) !>(err) { return cc_slice_empty(); };
    if (e->pool->insert(owned, owned) != 0) return cc_slice_empty();
    return owned;
}

static int fill_attr(Engine* e, CssNode* nd, CompoundScratch* c) {
    if (c->nattr >= MAX_ATTR) return 0;
    CssNode* name = nd->first();
    if (!name) return 0;
    CCSlice raw_n = name->span();
    c->attr_n[c->nattr] = e->intern(raw_n);
    CssNode* val = name->next(nd);
    if (val) {
        CCSlice raw_v = val->span();
        c->attr_v[c->nattr] = e->intern(raw_v);
        c->attr_eq[c->nattr] = 1;
    } else {
        c->attr_v[c->nattr] = cc_slice_empty();
        c->attr_eq[c->nattr] = 0;
    }
    c->nattr++;
    c->sb++;
    return 1;
}

static int fill_compound(Engine* e, CssNode* nd, CompoundScratch* c) {
    memset(c, 0, sizeof(*c));
    if (!nd || !nd->is_list()) return 0;
    CssNode* ch = nd->first();
    while (ch) {
        int id = ch->id();
        if (ch->is_list()) {
            if (id == Css_KEEP_attr && !fill_attr(e, ch, c)) return 0;
        } else {
            CCSlice raw = ch->span();
            CCSlice s = e->intern(raw);
            if (id == Css_KEEP_type_sel) {
                c->type = s;
                c->sc++;
            } else if (id == Css_KEEP_universal) {
                c->star = 1;
            } else if (id == Css_KEEP_hash) {
                c->id = s;
                c->sa++;
            } else if (id == Css_KEEP_class) {
                if (c->nclass >= MAX_CLASS) return 0;
                c->classes[c->nclass++] = s;
                c->sb++;
            }
        }
        ch = ch->next(nd);
    }
    return c->star || c->type.len || c->id.len || c->nclass || c->nattr;
}

static int pack_compound(CCArena store, CompoundScratch* s, Compound* d) {
    d->star = s->star;
    d->nclass = s->nclass;
    d->nattr = s->nattr;
    d->sa = s->sa;
    d->sb = s->sb;
    d->sc = s->sc;
    d->type = s->type;
    d->id = s->id;
    d->classes = 0;
    d->attr_n = 0;
    d->attr_v = 0;
    d->attr_eq = 0;
    if (s->nclass) {
        d->classes = store.allocT::[CCSlice](s->nclass);
        if (!d->classes) return 0;
        memcpy(d->classes, s->classes, sizeof(CCSlice) * (size_t)s->nclass);
    }
    if (s->nattr) {
        d->attr_n = store.allocT::[CCSlice](s->nattr);
        d->attr_v = store.allocT::[CCSlice](s->nattr);
        d->attr_eq = store.allocT::[int](s->nattr);
        if (!d->attr_n || !d->attr_v || !d->attr_eq) return 0;
        memcpy(d->attr_n, s->attr_n, sizeof(CCSlice) * (size_t)s->nattr);
        memcpy(d->attr_v, s->attr_v, sizeof(CCSlice) * (size_t)s->nattr);
        memcpy(d->attr_eq, s->attr_eq, sizeof(int) * (size_t)s->nattr);
    }
    return 1;
}

static int fill_selector(Engine* e, CssNode* nd, Rule* r) {
    CompoundScratch tmpc[MAX_SELCOMP];
    Comb tmpcomb[MAX_SELCOMP];
    r->n = 0;
    r->sa = r->sb = r->sc = 0;
    r->c = 0;
    r->comb = 0;
    if (!nd || !nd->is_list()) return 0;
    Comb pending = COMB_DESC;
    int have_comb = 0;
    CssNode* ch = nd->first();
    while (ch) {
        int id = ch->id();
        if (ch->is_list() && id == Css_KEEP_compound) {
            if (r->n >= MAX_SELCOMP) return 0;
            if (r->n > 0)
                tmpcomb[r->n - 1] = have_comb ? pending : COMB_DESC;
            if (!fill_compound(e, ch, &tmpc[r->n])) return 0;
            r->sa += tmpc[r->n].sa;
            r->sb += tmpc[r->n].sb;
            r->sc += tmpc[r->n].sc;
            r->n++;
            have_comb = 0;
        } else if (id == Css_KEEP_combinator) {
            pending = slice_has_gt(ch->span()) ? COMB_CHILD : COMB_DESC;
            have_comb = 1;
        }
        ch = ch->next(nd);
    }
    if (r->n <= 0) return 0;
    r->c = e->store.allocT::[Compound](r->n);
    if (!r->c) return 0;
    if (r->n > 1) {
        r->comb = e->store.allocT::[Comb](r->n - 1);
        if (!r->comb) return 0;
        memcpy(r->comb, tmpcomb, sizeof(Comb) * (size_t)(r->n - 1));
    }
    for (int i = 0; i < r->n; i++)
        if (!pack_compound(e->store, &tmpc[i], &r->c[i])) return 0;
    return 1;
}

static int take_rgb(CssNode* rgb, Rule* r) {
    CssNode* a = rgb ? rgb->first() : 0;
    CssNode* b = a ? a->next(rgb) : 0;
    CssNode* c = b ? b->next(rgb) : 0;
    if (!a || !b || !c) return 0;
    CCSlice sa = a->span();
    CCSlice sg = b->span();
    CCSlice sb = c->span();
    r->bg_current = 0;
    r->spec.bg.bg.r = (int)(sa.to_i64() ?> 0);
    r->spec.bg.bg.g = (int)(sg.to_i64() ?> 0);
    r->spec.bg.bg.b = (int)(sb.to_i64() ?> 0);
    r->spec.bg.bg.a = 255;
    r->props |= (1u << P_bg);
    return 1;
}

static int take_color(CssNode* rgb, Rule* r) {
    CssNode* a = rgb ? rgb->first() : 0;
    CssNode* b = a ? a->next(rgb) : 0;
    CssNode* c = b ? b->next(rgb) : 0;
    if (!a || !b || !c) return 0;
    CCSlice sa = a->span();
    CCSlice sg = b->span();
    CCSlice sb = c->span();
    r->spec.font.color.r = (int)(sa.to_i64() ?> 0);
    r->spec.font.color.g = (int)(sg.to_i64() ?> 0);
    r->spec.font.color.b = (int)(sb.to_i64() ?> 0);
    r->props |= (1u << P_color);
    return 1;
}

static CCSlice trim_slice(CCSlice s) {
    return s.trim();
}

static int parse_px_or_kw(CCSlice s, int* out) {
    s = trim_slice(s);
    if (s.eq_cstr("auto")) {
        *out = PX_AUTO;
        return 1;
    }
    if (s.eq_cstr("normal")) {
        *out = PX_NORMAL;
        return 1;
    }
    int v = 0, i = 0, sign = 1;
    if (s.len && s.ptr[0] == '-') { sign = -1; i = 1; }
    if (i >= (int)s.len || s.ptr[i] < '0' || s.ptr[i] > '9') return 0;
    for (; i < (int)s.len && s.ptr[i] >= '0' && s.ptr[i] <= '9'; i++)
        v = v * 10 + (s.ptr[i] - '0');
    if (i + 2 <= (int)s.len && s.ptr[i] == 'p' && s.ptr[i + 1] == 'x') {
        *out = v * sign;
        return 1;
    }
    return 0;
}

static int parse_fs(CCSlice s, int* out, int* unit) {
    s = trim_slice(s);
    int v = 0, i = 0, sign = 1;
    if (s.len && s.ptr[0] == '-') { sign = -1; i = 1; }
    if (i >= (int)s.len || s.ptr[i] < '0' || s.ptr[i] > '9') return 0;
    for (; i < (int)s.len && s.ptr[i] >= '0' && s.ptr[i] <= '9'; i++)
        v = v * 10 + (s.ptr[i] - '0');
    if (i + 2 <= (int)s.len && s.ptr[i] == 'p' && s.ptr[i + 1] == 'x') {
        *out = v * sign;
        *unit = UNIT_PX;
        return 1;
    }
    if (i + 3 <= (int)s.len && s.ptr[i] == 'r' && s.ptr[i + 1] == 'e' &&
        s.ptr[i + 2] == 'm') {
        *out = v * sign;
        *unit = UNIT_REM;
        return 1;
    }
    if (i + 2 <= (int)s.len && s.ptr[i] == 'e' && s.ptr[i + 1] == 'm') {
        *out = v * sign;
        *unit = UNIT_EM;
        return 1;
    }
    if (i < (int)s.len && s.ptr[i] == 37) {
        *out = v * sign;
        *unit = UNIT_PCT;
        return 1;
    }
    return 0;
}

static int hex_digit(char c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

static int parse_hex_rgb(CCSlice s, int* r, int* g, int* b);

static int ident_at(CCSlice s, size_t i, const char* w, size_t wlen) {
    if (i + wlen > s.len || !s.ptr) return 0;
    {
        char[:] sub = cc_slice_from_buffer(s.ptr + i, wlen);
        char[:] word = cc_slice_from_buffer((void *)w, wlen);
        if (!sub.eq(word)) return 0;
    }
    if (i + wlen < s.len) {
        char c = s.ptr[i + wlen];
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
            (c >= '0' && c <= '9') || c == '-' || c == '_')
            return 0;
    }
    return 1;
}

static int parse_rgb_at(CCSlice s, size_t i, int* r, int* g, int* b, size_t* used) {
    if (!s.ptr || i + 4 > s.len) return 0;
    if (s.ptr[i] != 'r' || s.ptr[i + 1] != 'g' || s.ptr[i + 2] != 'b') return 0;
    size_t k = i + 3;
    while (k < s.len && (s.ptr[k] == ' ' || s.ptr[k] == '\t')) k++;
    if (k >= s.len || s.ptr[k] != '(') return 0;
    k++;
    int vals[3] = {0, 0, 0};
    for (int n = 0; n < 3; n++) {
        while (k < s.len && (s.ptr[k] == ' ' || s.ptr[k] == '\t')) k++;
        if (k >= s.len || s.ptr[k] < '0' || s.ptr[k] > '9') return 0;
        int v = 0;
        while (k < s.len && s.ptr[k] >= '0' && s.ptr[k] <= '9') {
            v = v * 10 + (s.ptr[k] - '0');
            k++;
        }
        vals[n] = v;
        while (k < s.len && (s.ptr[k] == ' ' || s.ptr[k] == '\t')) k++;
        if (n < 2) {
            if (k >= s.len || s.ptr[k] != ',') return 0;
            k++;
        }
    }
    while (k < s.len && (s.ptr[k] == ' ' || s.ptr[k] == '\t')) k++;
    if (k >= s.len || s.ptr[k] != ')') return 0;
    k++;
    *r = vals[0];
    *g = vals[1];
    *b = vals[2];
    *used = k - i;
    return 1;
}

static int parse_hex_at(CCSlice s, size_t i, int* r, int* g, int* b, size_t* used) {
    if (!s.ptr || i >= s.len || s.ptr[i] != '#') return 0;
    size_t rest = s.len - i;
    if (rest >= 7) {
        CCSlice h = cc_slice_from_buffer(s.ptr + i, 7);
        if (parse_hex_rgb(h, r, g, b)) {
            if (i + 7 == s.len || s.ptr[i + 7] == ' ' || s.ptr[i + 7] == '\t' ||
                s.ptr[i + 7] == '\n') {
                *used = 7;
                return 1;
            }
        }
    }
    if (rest >= 4) {
        CCSlice h = cc_slice_from_buffer(s.ptr + i, 4);
        if (parse_hex_rgb(h, r, g, b)) {
            char next = i + 4 < s.len ? s.ptr[i + 4] : ' ';
            if (!((next >= '0' && next <= '9') || (next >= 'a' && next <= 'f') ||
                  (next >= 'A' && next <= 'F'))) {
                *used = 4;
                return 1;
            }
        }
    }
    return 0;
}

/* First color token in a background value (hex / rgb() / currentColor /
 * transparent). none / url(...) / repeat are not colors. */
static int scan_bg_color(CCSlice s, int* r, int* g, int* b, int* a, int* current) {
    s = trim_slice(s);
    *current = 0;
    *a = 255;
    if (!s.ptr) return 0;
    size_t i = 0;
    int found = 0;
    while (i < s.len) {
        while (i < s.len && (s.ptr[i] == ' ' || s.ptr[i] == '\t' || s.ptr[i] == '\n'))
            i++;
        if (i >= s.len) break;
        size_t used = 0;
        int cr = 0, cg = 0, cb = 0;
        if (ident_at(s, i, "currentColor", 12) || ident_at(s, i, "currentcolor", 12)) {
            *current = 1;
            *a = 255;
            found = 1;
            i += 12;
            continue;
        }
        if (ident_at(s, i, "transparent", 11)) {
            *current = 0;
            *r = 0;
            *g = 0;
            *b = 0;
            *a = 0;
            found = 1;
            i += 11;
            continue;
        }
        if (parse_hex_at(s, i, &cr, &cg, &cb, &used)) {
            *current = 0;
            *r = cr;
            *g = cg;
            *b = cb;
            *a = 255;
            found = 1;
            i += used;
            continue;
        }
        if (parse_rgb_at(s, i, &cr, &cg, &cb, &used)) {
            *current = 0;
            *r = cr;
            *g = cg;
            *b = cb;
            *a = 255;
            found = 1;
            i += used;
            continue;
        }
        if (i + 3 <= s.len && s.ptr[i] == 'u' && s.ptr[i + 1] == 'r' &&
            s.ptr[i + 2] == 'l') {
            i += 3;
            while (i < s.len && s.ptr[i] != ')') i++;
            if (i < s.len) i++;
            continue;
        }
        while (i < s.len && s.ptr[i] != ' ' && s.ptr[i] != '\t' && s.ptr[i] != '\n')
            i++;
    }
    return found;
}

static int parse_hex_rgb(CCSlice s, int* r, int* g, int* b) {
    s = trim_slice(s);
    if (!s.len || !s.ptr || s.ptr[0] != '#') return 0;
    if (s.len == 4) {
        int r1 = hex_digit(s.ptr[1]);
        int g1 = hex_digit(s.ptr[2]);
        int b1 = hex_digit(s.ptr[3]);
        if (r1 < 0 || g1 < 0 || b1 < 0) return 0;
        *r = r1 * 16 + r1;
        *g = g1 * 16 + g1;
        *b = b1 * 16 + b1;
        return 1;
    }
    if (s.len == 7) {
        int r1 = hex_digit(s.ptr[1]);
        int r2 = hex_digit(s.ptr[2]);
        int g1 = hex_digit(s.ptr[3]);
        int g2 = hex_digit(s.ptr[4]);
        int b1 = hex_digit(s.ptr[5]);
        int b2 = hex_digit(s.ptr[6]);
        if (r1 < 0 || r2 < 0 || g1 < 0 || g2 < 0 || b1 < 0 || b2 < 0) return 0;
        *r = r1 * 16 + r2;
        *g = g1 * 16 + g2;
        *b = b1 * 16 + b2;
        return 1;
    }
    return 0;
}

static int parse_fw(CCSlice s, int* out) {
    s = trim_slice(s);
    if (s.eq_cstr("normal")) {
        *out = 400;
        return 1;
    }
    if (s.eq_cstr("bold")) {
        *out = 700;
        return 1;
    }
    int v = 0, i = 0;
    if (!s.len || s.ptr[0] < '0' || s.ptr[0] > '9') return 0;
    for (; i < (int)s.len && s.ptr[i] >= '0' && s.ptr[i] <= '9'; i++)
        v = v * 10 + (s.ptr[i] - '0');
    if (i != (int)s.len || v < 1 || v > 1000) return 0;
    *out = v;
    return 1;
}

static int cascade_rank(int origin, int imp) {
    if (imp) {
        if (origin == ORIGIN_UA) return 5;
        if (origin == ORIGIN_STYLE) return 4;
        return 3;
    }
    if (origin == ORIGIN_UA) return 0;
    if (origin == ORIGIN_STYLE) return 2;
    return 1;
}

static int decl_important(CssNode* d, CssNode* val) {
    CssNode* n = val ? val->next(d) : 0;
    if (!n) return 0;
    if (n->is_list() && n->id() == Css_KEEP_important) return 1;
    CCSlice s = trim_slice(n->span());
    return s.eq_cstr("important") || s.eq_cstr("!important");
}

static int fill_rule(Engine* e, CssNode* nd, Rule* r) {
    memset(r, 0, sizeof(*r));
    r->spec = SPEC_INIT;
    if (!nd || !nd->is_list()) return 0;
    CssNode* sel = nd->first();
    CssNode* decls = sel ? sel->next(nd) : 0;
    if (!fill_selector(e, sel, r)) return 0;
    if (decls && decls->is_list()) {
    CssNode* d = decls->first();
    while (d) {
            if (d->is_list()) {
                CssNode* prop = d->first();
                CssNode* val = prop ? prop->next(d) : 0;
                if (prop && val) {
                    int imp = decl_important(d, val);
                    CCSlice name = trim_slice(prop->span());
                    unsigned bit = 0;
                    if (name.eq_cstr("background-color") || name.eq_cstr("background")) {
                        int shorthand = name.eq_cstr("background");
                        int hr = 0, hg = 0, hb = 0, ha = 255, cur = 0;
                        CCSlice raw = trim_slice(val->span());
                        if (val->is_list() && val->id() == Css_KEEP_rgb) {
                            take_rgb(val, r);
                            bit = 1u << P_bg;
                        } else if (scan_bg_color(raw, &hr, &hg, &hb, &ha, &cur)) {
                            r->bg_current = cur;
                            if (!cur) {
                                r->spec.bg.bg.r = hr;
                                r->spec.bg.bg.g = hg;
                                r->spec.bg.bg.b = hb;
                                r->spec.bg.bg.a = ha;
                            }
                            bit = 1u << P_bg;
                            r->props |= bit;
                        } else if (shorthand) {
                            /* Omitted color resets to initial (transparent). */
                            r->bg_current = 0;
                            r->spec.bg.bg.r = 0;
                            r->spec.bg.bg.g = 0;
                            r->spec.bg.bg.b = 0;
                            r->spec.bg.bg.a = 0;
                            bit = 1u << P_bg;
                            r->props |= bit;
                        }
                    } else if (name.eq_cstr("color")) {
                        int hr = 0, hg = 0, hb = 0;
                        size_t used = 0;
                        CCSlice raw = trim_slice(val->span());
                        if (val->is_list() && val->id() == Css_KEEP_rgb) {
                            take_color(val, r);
                            bit = 1u << P_color;
                        } else if (parse_hex_rgb(raw, &hr, &hg, &hb)) {
                            r->spec.font.color.r = hr;
                            r->spec.font.color.g = hg;
                            r->spec.font.color.b = hb;
                            bit = 1u << P_color;
                            r->props |= bit;
                        } else if (parse_rgb_at(raw, 0, &hr, &hg, &hb, &used)) {
                            r->spec.font.color.r = hr;
                            r->spec.font.color.g = hg;
                            r->spec.font.color.b = hb;
                            bit = 1u << P_color;
                            r->props |= bit;
                        }
                    } else {
                        CCSlice raw = trim_slice(val->span());
                        int px = 0, fw = 0, unit = UNIT_PX;
                        if (name.eq_cstr("display")) {
                            r->spec.box.display = e->intern(raw);
                            bit = 1u << P_display;
                            r->props |= bit;
                        } else if (name.eq_cstr("position")) {
                            r->spec.box.position = e->intern(raw);
                            bit = 1u << P_position;
                            r->props |= bit;
                        } else if (name.eq_cstr("visibility")) {
                            r->spec.font.visibility = e->intern(raw);
                            bit = 1u << P_visibility;
                            r->props |= bit;
                        } else if (name.eq_cstr("height") && parse_px_or_kw(raw, &px)) {
                            r->spec.box.height_px = px;
                            bit = 1u << P_height_px;
                            r->props |= bit;
                        } else if (name.eq_cstr("width") && parse_px_or_kw(raw, &px)) {
                            r->spec.box.width_px = px;
                            bit = 1u << P_width_px;
                            r->props |= bit;
                        } else if (name.eq_cstr("min-width") && parse_px_or_kw(raw, &px)) {
                            r->spec.box.minw_px = px;
                            bit = 1u << P_minw_px;
                            r->props |= bit;
                        } else if (name.eq_cstr("font-size") && parse_fs(raw, &px, &unit)) {
                            r->spec.font.fs_px = px;
                            r->fs_unit = unit;
                            bit = 1u << P_fs_px;
                            r->props |= bit;
                        } else if (name.eq_cstr("line-height") && parse_px_or_kw(raw, &px)) {
                            r->spec.font.lh_px = px;
                            bit = 1u << P_lh_px;
                            r->props |= bit;
                        } else if (name.eq_cstr("font-weight") && parse_fw(raw, &fw)) {
                            r->spec.font.fw = fw;
                            bit = 1u << P_fw;
                            r->props |= bit;
                        }
                    }
                    if (bit && imp) r->imp |= bit;
                }
            }
            d = d->next(decls);
        }
    }
    return r->props != 0;
}

static int count_char(char[:] s, char c) {
    int n = 0;
    @for (ch in s)
        if (ch == c) n++;
    return n;
}

static void !>(CCError) Engine_ingest_css(Engine* e, char[:] css, int origin) {
    if (!css.len) return cc_ok();
    CssNode* root = Css.parse(css.ptr, css.len, e->store);
    if (!root) {
        return cc_err(CC_ERR_PARSE, "css grammar");
    }
    CssNode* sheet = root->first();
    if (sheet && sheet->is_list() && sheet->id() == Css_KEEP_stylesheet)
        root = sheet;
    if (!root->is_list()) return cc_ok();
    CssNode* ch = root->first();
    while (ch) {
        if (ch->is_list() && ch->id() == Css_KEEP_rule) {
            if (e->nrules >= e->cap_rules)
                return cc_err(CC_ERR_INVALID_ARG, "too many rules");
            Rule* r = &e->rules[e->nrules];
            if (fill_rule(e, ch, r)) {
                r->origin = origin;
                r->order = e->nrules;
                e->nrules++;
            }
        }
        ch = ch->next(root);
    }
    return cc_ok();
}

static int Engine_fill_node(Engine* e, Node* nd, int parent, CCSlice tag, CCSlice dom_id,
                            CCSlice classes, CCSlice attrs) {
    memset(nd, 0, sizeof(*nd));
    nd->parent = parent;
    nd->tag = e->intern(tag);
    if (!(dom_id.len == 1 && dom_id.eq_cstr("-")))
        nd->dom_id = e->intern(dom_id);
    CCSlice class_buf[MAX_CLASS];
    int nc = split_commas(classes, class_buf, MAX_CLASS);
    nd->cap_class = nc > MAX_CLASS ? nc : MAX_CLASS;
    nd->classes = e->store.allocT::[CCSlice](nd->cap_class);
    if (nd->classes) {
        for (int i = 0; i < nc; i++)
            nd->classes[i] = e->intern(class_buf[i]);
        nd->nclass = nc;
    }
    CCSlice attr_buf[MAX_ATTR];
    int na = split_commas(attrs, attr_buf, MAX_ATTR);
    nd->cap_attr = na > MAX_ATTR ? na : MAX_ATTR;
    nd->attrs = e->store.allocT::[Attr](nd->cap_attr);
    if (nd->attrs) {
        for (int i = 0; i < na; i++) {
            CCSlice a = attr_buf[i];
            size_t eq = 0;
            while (eq < a.len && a.ptr[eq] != '=') eq++;
            nd->attrs[i].name = e->intern(a.sub(0, eq));
            if (eq < a.len)
                nd->attrs[i].value = e->intern(a.sub(eq + 1, a.len));
            else
                nd->attrs[i].value = cc_slice_empty();
            nd->nattr++;
        }
    }
    nd->specified = 0;
    nd->used.bg = &e->bg_init;
    nd->used.box = &e->box_init;
    nd->used.font = &e->font_init;
    for (int p = 0; p < NPROP; p++) {
        nd->spec_a[p] = nd->spec_b[p] = nd->spec_c[p] = -1;
        nd->win_order[p] = -1;
        nd->win_rank[p] = -1;
    }
    int id = (int)(nd - e->nodes);
    nd->first_child = -1;
    nd->next_sib = -1;
    if (parent >= 0) {
        nd->next_sib = e->nodes[parent].first_child;
        e->nodes[parent].first_child = id;
    }
    e->note_live(id);
    return 1;
}

static void Engine_add_tree_row(Engine* e, TreeRow* row) {
    if (e->nnodes >= e->cap_nodes) return;
    Node* nd = &e->nodes[e->nnodes];
    e->fill_node(nd, (int)row->parent, row->tag, row->dom_id, row->classes, row->attrs);
    e->nnodes++;
}

static void !>(CCError) Engine_ingest_tree(Engine* e, char[:] tree) {
    size_t pos = 0;
    while (pos < tree.len) {
        while (pos < tree.len && (tree.ptr[pos] == '\n' || tree.ptr[pos] == '\r'))
            pos++;
        if (pos >= tree.len) break;
        if (tree.ptr[pos] == '#') {
            while (pos < tree.len && tree.ptr[pos] != '\n') pos++;
            continue;
        }
        TreeRow row;
        if (!TreeRow.read(tree.ptr, tree.len, &pos, e->store, &row))
            return cc_err(CC_ERR_PARSE, "tree row");
        e->add_tree_row(&row);
    }
    return cc_ok();
}

static int Engine_push_bucket(Engine* e, Map::[CCSlice, Vec::[int]] m, CCSlice key, int rule) {
    if (!m || !key.len) return 0;
    Vec::[int]* b = m->get_ptr(key);
    if (!b) {
        Vec::[int] v = vec_new::[int](e->store);
        if (m->insert(key, v) != 0) return 0;
        b = m->get_ptr(key);
        if (!b) return 0;
    }
    return b->push(rule) == 0;
}

static int compound_open(const Compound* s) {
    return !s->id.len && !s->nclass && !s->type.len && !s->nattr;
}

static int Engine_push_keyed(Engine* e, Compound* s, int k,
                             Map::[CCSlice, Vec::[int]] ids,
                             Map::[CCSlice, Vec::[int]] classes,
                             Map::[CCSlice, Vec::[int]] types) {
    if (s->id.len) return e->push_bucket(ids, s->id, k);
    if (s->nclass) {
        CCSlice cls = s->classes[0];
        return e->push_bucket(classes, cls, k);
    }
    if (s->type.len) return e->push_bucket(types, s->type, k);
    return 0;
}

static CCSlice compound_key(const Compound* s) {
    if (s->id.len) return s->id;
    if (s->nclass) return s->classes[0];
    return s->type;
}

static int Engine_push_left_rule(Engine* e, CCSlice a, int k) {
    return e->push_bucket(e->left_rules, a, k);
}

/* Atoms the pair / parent maps do not key: earlier compounds, and
 * extra classes / attrs on the last left (compound_key is one atom). */
static void Engine_note_left_extra(Engine* e, const Compound* c, int k, int all) {
    CCSlice skip = all ? cc_slice_empty() : compound_key(c);
    if (c->type.len && (all || c->type.ptr != skip.ptr))
        e->push_left_rule(c->type, k);
    if (c->id.len && (all || c->id.ptr != skip.ptr))
        e->push_left_rule(c->id, k);
    if (c->classes) {
        for (int i = 0; i < c->nclass; i++)
            if (all || c->classes[i].ptr != skip.ptr)
                e->push_left_rule(c->classes[i], k);
    }
    if (c->attr_n) {
        for (int i = 0; i < c->nattr; i++)
            e->push_left_rule(c->attr_n[i], k);
    }
}

static int compound_has_atom(const Compound* c, CCSlice a) {
    if (!a.ptr || !c) return 0;
    if (c->type.ptr == a.ptr) return 1;
    if (c->id.ptr == a.ptr) return 1;
    if (c->classes) {
        for (int i = 0; i < c->nclass; i++)
            if (c->classes[i].ptr == a.ptr) return 1;
    }
    if (c->attr_n) {
        for (int i = 0; i < c->nattr; i++)
            if (c->attr_n[i].ptr == a.ptr) return 1;
    }
    return 0;
}

static int Engine_note_left_subj(Engine* e, Map::[CCSlice, Vec::[CCSlice]] m,
                                 CCSlice left, CCSlice subj) {
    if (!m || !left.len || !subj.len) return 0;
    Vec::[CCSlice]* b = m->get_ptr(left);
    if (!b) {
        Vec::[CCSlice] v = vec_new::[CCSlice](e->store);
        if (m->insert(left, v) != 0) return 0;
        b = m->get_ptr(left);
        if (!b) return 0;
    }
    if (b->data) {
        Vec::[CCSlice] cur = *b;
        @for (s in cur)
            if (s.ptr == subj.ptr) return 1;
    }
    return b->push(subj) == 0;
}

static void Engine_note_live(Engine* e, int id) {
    if (id < 0 || id >= e->cap_nodes) return;
    Node* n = &e->nodes[id];
    e->push_bucket(e->live_id, n->dom_id, id);
    e->push_bucket(e->live_type, n->tag, id);
    for (int c = 0; c < n->nclass; c++)
        e->push_bucket(e->live_class, n->classes[c], id);
}

static void Engine_forget_live(Engine* e, Map::[CCSlice, Vec::[int]] m, CCSlice key, int id) {
    if (!m || !key.len) return;
    Vec::[int]* b = m->get_ptr(key);
    if (!b || !b->data) return;
    for (size_t i = 0; i < b->len; i++) {
        if (b->data[i] == id) {
            b->data[i] = b->data[b->len - 1];
            int dump;
            b->pop(&dump);
            return;
        }
    }
}

static int Engine_push_pair(Engine* e, Map::[AtomPair, Vec::[int]] m, CCSlice subj, CCSlice left, int rule) {
    if (!m || !subj.ptr || !left.ptr) return 0;
    AtomPair key;
    key.subj = subj.ptr;
    key.left = left.ptr;
    Vec::[int]* b = m->get_ptr(key);
    if (!b) {
        Vec::[int] v = vec_new::[int](e->store);
        if (m->insert(key, v) != 0) return 0;
        b = m->get_ptr(key);
        if (!b) return 0;
    }
    return b->push(rule) == 0;
}

static void !>(CCError) Engine_index_rules(Engine* e) {
    for (int k = 0; k < e->nrules; k++) {
        Rule* r = &e->rules[k];
        if (!r->n || !r->c)
            continue;
        for (int ci = 0; ci + 1 < r->n; ci++)
            e->note_left_extra(&r->c[ci], k, 1);
        Compound* s = &r->c[r->n - 1];
        int ok = 0;
        int child_star = compound_open(s) && r->n >= 2 &&
                         r->comb[r->n - 2] == COMB_CHILD;
        if (child_star) {
            Compound* left = &r->c[r->n - 2];
            ok = e->push_keyed(left, k, e->by_parent_id, e->by_parent_class, e->by_parent_type);
        } else if (compound_open(s)) {
            ok = 0;
        } else if (r->n == 1 || compound_open(&r->c[r->n - 2])) {
            ok = e->push_keyed(s, k, e->by_id, e->by_class, e->by_type);
        } else {
            CCSlice sk = compound_key(s);
            CCSlice lk = compound_key(&r->c[r->n - 2]);
            if (!sk.len || !lk.len) {
                ok = e->push_keyed(s, k, e->by_id, e->by_class, e->by_type);
            } else if (r->comb[r->n - 2] == COMB_CHILD) {
                ok = e->push_pair(e->child_pairs, sk, lk, k);
                if (ok) e->note_left_subj(e->child_from_left, lk, sk);
            } else {
                ok = e->push_pair(e->desc_pairs, sk, lk, k);
                if (ok) e->note_left_subj(e->desc_from_left, lk, sk);
            }
        }
        if (!ok) {
            Vec::[int]* u = &e->universal;
            ok = u->push(k) == 0;
        }
        if (!ok) return cc_err(CC_ERR_OUT_OF_MEMORY, "index rule");
    }
    return cc_ok();
}

static uint64_t atom_bits(CCSlice s) {
    if (!s.ptr || !s.len) return 0;
    uint64_t h = (uint64_t)(uintptr_t)s.ptr;
    h ^= h >> 30;
    h *= 0xbf58476d1ce4e5b9ULL;
    h ^= h >> 27;
    return (1ULL << (h & 63)) | (1ULL << ((h >> 6) & 63));
}

static uint64_t compound_need(const Compound* c) {
    uint64_t n = atom_bits(c->type) | atom_bits(c->id);
    for (int i = 0; i < c->nclass; i++)
        n |= atom_bits(c->classes[i]);
    for (int i = 0; i < c->nattr; i++)
        n |= atom_bits(c->attr_n[i]);
    return n;
}

static void Engine_paint_blooms(Engine* e) {
    for (int i = 0; i < e->nnodes; i++) {
        Node* n = &e->nodes[i];
        if (n->dead) continue;
        uint64_t self = atom_bits(n->tag) | atom_bits(n->dom_id);
        for (int c = 0; c < n->nclass; c++)
            self |= atom_bits(n->classes[c]);
        for (int a = 0; a < n->nattr; a++)
            self |= atom_bits(n->attrs[a].name);
        n->self = self;
    }
    for (int i = 0; i < e->nnodes; i++) {
        Node* n = &e->nodes[i];
        n->anc = 0;
        if (n->dead) continue;
        int p = n->parent;
        while (p >= 0) {
            if (!e->nodes[p].dead)
                n->anc |= e->nodes[p].self;
            p = e->nodes[p].parent;
        }
    }
}

static void !>(CCError) Engine_load_fixture(Engine* e, char[:] text) {
    FixtureNode* root = Fixture.parse(text.ptr, text.len, e->store);
    if (!root || !root->is_list())
        return cc_err(CC_ERR_PARSE, "fixture");
    FixtureNode* file = root->first();
    if (file && file->is_list())
        root = file;
    FixtureNode* base = root->first();
    FixtureNode* css = base ? base->next(root) : 0;
    FixtureNode* tree = css ? css->next(root) : 0;
    FixtureNode* mut = tree ? tree->next(root) : 0;
    if (!base || !css || !tree)
        return cc_err(CC_ERR_PARSE, "fixture sections");
    CCSlice base_s, css_s, tree_s, mut_s = cc_slice_empty();
    base->slice(&base_s);
    css->slice(&css_s);
    tree->slice(&tree_s);
    if (mut) mut->slice(&mut_s);

    size_t nlines = 1;
    @for (ch in tree_s)
        if (ch == '\n') nlines++;
    int extra = 0;
    for (size_t i = 0; i + 5 < mut_s.len; i++)
        if ((i == 0 || mut_s.ptr[i - 1] == '\n') && mut_s.ptr[i] == '+' &&
            mut_s.ptr[i + 1] == 'l')
            extra++;
    e->cap_nodes = (int)nlines + extra + 8;
    e->cap_rules = count_char(base_s, '{') + count_char(css_s, '{') + 8;
    e->nodes = e->store.allocT::[Node](e->cap_nodes);
    e->rules = e->store.allocT::[Rule](e->cap_rules);
    e->pool = map_new::[CCSlice, CCSlice](e->store);
    e->by_id = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_class = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_type = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_parent_id = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_parent_class = map_new::[CCSlice, Vec::[int]](e->store);
    e->by_parent_type = map_new::[CCSlice, Vec::[int]](e->store);
    e->child_pairs = map_new::[AtomPair, Vec::[int]](e->store);
    e->desc_pairs = map_new::[AtomPair, Vec::[int]](e->store);
    e->child_from_left = map_new::[CCSlice, Vec::[CCSlice]](e->store);
    e->desc_from_left = map_new::[CCSlice, Vec::[CCSlice]](e->store);
    e->left_rules = map_new::[CCSlice, Vec::[int]](e->store);
    e->live_id = map_new::[CCSlice, Vec::[int]](e->store);
    e->live_class = map_new::[CCSlice, Vec::[int]](e->store);
    e->live_type = map_new::[CCSlice, Vec::[int]](e->store);
    e->universal = vec_new::[int](e->store);
    size_t mut_lines = 1;
    @for (ch in mut_s)
        if (ch == '\n') mut_lines++;
    e->cap_muts = (int)mut_lines + 8;
    e->muts = e->store.allocT::[MutOp](e->cap_muts);
    e->cap_changes = e->cap_muts;
    e->changes = e->store.allocT::[Change](e->cap_changes);
    e->nchanges = 0;
    e->inv_ids = e->store.allocT::[int](e->cap_nodes);
    e->inv_off = e->store.allocT::[int](e->cap_nodes);
    e->level_ids = e->store.allocT::[int](e->cap_nodes);
    e->level_off = e->store.allocT::[int](64);
    e->share_of = e->store.allocT::[int](e->cap_nodes);
    e->share_ents = e->store.allocT::[ShareEnt](e->cap_nodes);
    e->bg_pool = e->store.allocT::[StyBg](e->cap_nodes);
    e->box_pool = e->store.allocT::[StyBox](e->cap_nodes);
    e->font_pool = e->store.allocT::[StyFont](e->cap_nodes);
    if (!e->nodes || !e->rules || !e->pool || !e->by_id || !e->by_class || !e->by_type ||
        !e->by_parent_id || !e->by_parent_class || !e->by_parent_type ||
        !e->child_pairs || !e->desc_pairs || !e->child_from_left ||
        !e->desc_from_left || !e->left_rules || !e->live_id || !e->live_class ||
        !e->live_type || !e->muts || !e->changes || !e->inv_ids || !e->inv_off ||
        !e->level_ids || !e->level_off ||
        !e->share_of || !e->share_ents || !e->bg_pool || !e->box_pool || !e->font_pool)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "engine tables");
    e->bg_init = SPEC_INIT.bg;
    e->box_init = SPEC_INIT.box;
    e->font_init = SPEC_INIT.font;
    e->ident_inline = e->intern(@slice("inline"));
    e->ident_block = e->intern(@slice("block"));
    e->ident_div = e->intern(@slice("div"));
    e->ident_static = e->intern(@slice("static"));
    e->ident_visible = e->intern(@slice("visible"));
    e->box_block = e->box_init;
    e->box_block.display = e->ident_block;
    e->box_block.position = e->ident_static;
    e->box_inline = e->box_init;
    e->box_inline.display = e->ident_inline;
    e->box_inline.position = e->ident_static;
    e->font_init.visibility = e->ident_visible;

    e->ingest_css(base_s, ORIGIN_UA) !>(err) { return cc_err(err); };
    e->ingest_css(css_s, ORIGIN_AUTHOR) !>(err) { return cc_err(err); };
    e->index_rules() !>(err) { return cc_err(err); };
    e->ingest_tree(tree_s) !>(err) { return cc_err(err); };
    if (mut_s.len) e->ingest_muts(mut_s) !>(err) { return cc_err(err); };
    e->paint_blooms();
    return cc_ok();
}

static int slices_eq(const CCSlice* a, const CCSlice* b) {
    return a->ptr == b->ptr;
}

static int Node_has_class(Node* n, const CCSlice* c) {
    for (int i = 0; i < n->nclass; i++)
        if (slices_eq(&n->classes[i], c)) return 1;
    return 0;
}

static int Node_has_attr(Node* n, const CCSlice* name, const CCSlice* val, int equals) {
    for (int i = 0; i < n->nattr; i++) {
        if (!slices_eq(&n->attrs[i].name, name)) continue;
        if (!equals) return 1;
        if (slices_eq(&n->attrs[i].value, val)) return 1;
    }
    return 0;
}

static int Node_match_compound(Node* n, const Compound* c) {
    if (c->type.len && !slices_eq(&n->tag, &c->type))
        return 0;
    if (c->id.len) {
        if (!n->dom_id.len || !slices_eq(&n->dom_id, &c->id))
            return 0;
    }
    for (int i = 0; i < c->nclass; i++)
        if (!n->has_class(&c->classes[i]))
            return 0;
    for (int i = 0; i < c->nattr; i++)
        if (!n->has_attr(&c->attr_n[i], &c->attr_v[i], c->attr_eq[i]))
            return 0;
    return 1;
}

static int Engine_match_from(Engine* e, int idx, const Rule* r, int ci) {
    if (idx < 0) return 0;
    Node* n = &e->nodes[idx];
    if (!n->match_compound(&r->c[ci]))
        return 0;
    if (ci == 0)
        return 1;
    Comb comb = r->comb[ci - 1];
    uint64_t need = compound_need(&r->c[ci - 1]);
    int p = e->nodes[idx].parent;
    if (comb == COMB_CHILD) {
        if (p < 0) return 0;
        if (need && (e->nodes[p].self & need) != need)
            return 0;
        return e->match_from(p, r, ci - 1);
    }
    if (need && (n->anc & need) != need)
        return 0;
    while (p >= 0) {
        if (e->match_from(p, r, ci - 1))
            return 1;
        p = e->nodes[p].parent;
    }
    return 0;
}

static int Engine_match_from_join(Engine* e, int idx, const Rule* r, int ci) {
    if (idx < 0) return 0;
    Node* n = &e->nodes[idx];
    if (!n->match_compound(&r->c[ci]))
        return 0;
    if (ci == 0)
        return 1;
    Comb comb = r->comb[ci - 1];
    int p = e->nodes[idx].parent;
    if (comb == COMB_CHILD) {
        if (p < 0) return 0;
        return e->match_from_join(p, r, ci - 1);
    }
    while (p >= 0) {
        if (e->match_from_join(p, r, ci - 1))
            return 1;
        p = e->nodes[p].parent;
    }
    return 0;
}

static int better_prop(const Rule* r, const Node* n, int p) {
    if (n->spec_a[p] < 0) return 1;
    int nr = cascade_rank(r->origin, (int)((r->imp >> p) & 1u));
    if (nr != n->win_rank[p]) return nr > n->win_rank[p];
    if (r->sa != n->spec_a[p]) return r->sa > n->spec_a[p];
    if (r->sb != n->spec_b[p]) return r->sb > n->spec_b[p];
    if (r->sc != n->spec_c[p]) return r->sc > n->spec_c[p];
    return r->order >= n->win_order[p];
}

static void Node_win_prop(Node* n, const Rule* r, int p) {
    n->spec_a[p] = r->sa;
    n->spec_b[p] = r->sb;
    n->spec_c[p] = r->sc;
    n->win_order[p] = r->order;
    n->win_rank[p] = cascade_rank(r->origin, (int)((r->imp >> p) & 1u));
    n->specified |= (1u << p);
    if (p == P_fs_px) {
        n->fs_spec = r->spec.font.fs_px;
        n->fs_unit = r->fs_unit;
    }
    if (p == P_bg)
        n->bg_current = r->bg_current;
}

/* Smallest fact: this node owns a unique slot. Do not copy the proto —
 * specified fields are written here; holes are sealed from initial. */
static void Engine_own_bg(Engine* e, Node* n, int i) {
    if (n->used.bg != &e->bg_pool[i])
        n->used.bg = &e->bg_pool[i];
}

static void Engine_own_box(Engine* e, Node* n, int i) {
    if (n->used.box != &e->box_pool[i])
        n->used.box = &e->box_pool[i];
}

static void Engine_own_font(Engine* e, Node* n, int i) {
    if (n->used.font != &e->font_pool[i])
        n->used.font = &e->font_pool[i];
}

static void Engine_seal_box(Engine* e, Node* n, int i) {
    if (n->used.box != &e->box_pool[i]) return;
    StyBox* b = n->used.box;
    if (!(n->specified & (1u << P_height_px))) b->height_px = PX_AUTO;
    if (!(n->specified & (1u << P_minw_px))) b->minw_px = PX_AUTO;
    if (!(n->specified & (1u << P_width_px))) b->width_px = PX_AUTO;
    if (!(n->specified & (1u << P_display))) b->display = cc_slice_empty();
    if (!(n->specified & (1u << P_position))) b->position = cc_slice_empty();
}

static void Engine_apply_specified(Engine* e, int i, Node* n, Rule* r) {
    @comptime for (f in type_of(StyBg).fields) {
        if ((r->props & (1u << f.index)) && better_prop(r, n, (int)f.index)) {
            e->own_bg(n, i);
            n->used.bg->f = r->spec.bg.f;
            n->win_prop(r, (int)f.index);
        }
    }
    @comptime for (f in type_of(StyBox).fields) {
        if ((r->props & (1u << (N_BG + (int)f.index))) &&
            better_prop(r, n, N_BG + (int)f.index)) {
            e->own_box(n, i);
            n->used.box->f = r->spec.box.f;
            n->win_prop(r, N_BG + (int)f.index);
        }
    }
    @comptime for (f in type_of(StyFont).fields) {
        if ((r->props & (1u << (N_BG + N_BOX + (int)f.index))) &&
            better_prop(r, n, N_BG + N_BOX + (int)f.index)) {
            e->own_font(n, i);
            n->used.font->f = r->spec.font.f;
            n->win_prop(r, N_BG + N_BOX + (int)f.index);
        }
    }
}

static void Engine_apply_rule(Engine* e, int i, Node* n, int k) {
    Rule* r = &e->rules[k];
    if (!r->n || !r->props || !e->match_from(i, r, r->n - 1))
        return;
    e->apply_specified(i, n, r);
}

static int parse_style_decls(Engine* e, Node* n, Rule* r) {
    CCSlice style = cc_slice_empty();
    for (int a = 0; a < n->nattr; a++) {
        if (n->attrs[a].name.eq_cstr("style")) {
            style = n->attrs[a].value;
            break;
        }
    }
    if (!style.len) return 0;
    CCSlice wrap = e->store.alloc_slice_bytes(style.len + 3);
    if (!wrap.ptr) return 0;
    CCSlice head = wrap.sub(0, 2);
    CCSlice mid = wrap.sub(2, 2 + style.len);
    CCSlice tail = wrap.sub(2 + style.len, wrap.len);
    head.copy(@slice("x{")) !>(err) { return 0; };
    mid.copy(style) !>(err) { return 0; };
    tail.copy(@slice("}")) !>(err) { return 0; };
    CssNode* root = Css.parse(wrap.ptr, wrap.len, e->store);
    if (!root) return 0;
    CssNode* sheet = root->first();
    if (sheet && sheet->is_list() && sheet->id() == Css_KEEP_stylesheet)
        root = sheet;
    if (!root->is_list()) return 0;
    CssNode* ch = root->first();
    while (ch) {
        if (ch->is_list() && ch->id() == Css_KEEP_rule) {
            if (!fill_rule(e, ch, r)) return 0;
            r->origin = ORIGIN_STYLE;
            r->sa = 1;
            r->sb = 0;
            r->sc = 0;
            r->n = 0;
            r->order = 1 << 20;
            return 1;
        }
        ch = ch->next(root);
    }
    return 0;
}

static void Engine_apply_bucket(Engine* e, int i, Node* n, Map::[CCSlice, Vec::[int]] m, CCSlice key) {
    if (!m || !key.len) return;
    Vec::[int]* b = m->get_ptr(key);
    if (!b || !b->data) return;
    Vec::[int] rules = *b;
    @for (rule_idx in rules)
        e->apply_rule(i, n, rule_idx);
}

static void Engine_apply_pair(Engine* e, int i, Node* n, Map::[AtomPair, Vec::[int]] m, CCSlice subj, CCSlice left) {
    if (!m || !subj.ptr || !left.ptr) return;
    AtomPair key;
    key.subj = subj.ptr;
    key.left = left.ptr;
    Vec::[int]* b = m->get_ptr(key);
    if (!b || !b->data) return;
    Vec::[int] rules = *b;
    @for (rule_idx in rules)
        e->apply_rule(i, n, rule_idx);
}

static void Engine_apply_pairs_other(Engine* e, int i, Node* n, Map::[AtomPair, Vec::[int]] m, CCSlice subj, Node* other) {
    if (!subj.len) return;
    if (other->dom_id.len)
        e->apply_pair(i, n, m, subj, other->dom_id);
    for (int c = 0; c < other->nclass; c++)
        e->apply_pair(i, n, m, subj, other->classes[c]);
    e->apply_pair(i, n, m, subj, other->tag);
}

static void Engine_apply_pairs(Engine* e, int i, Node* n, Map::[AtomPair, Vec::[int]] m, Node* other) {
    if (n->dom_id.len)
        e->apply_pairs_other(i, n, m, n->dom_id, other);
    for (int c = 0; c < n->nclass; c++)
        e->apply_pairs_other(i, n, m, n->classes[c], other);
    e->apply_pairs_other(i, n, m, n->tag, other);
}

static void Engine_style_one(Engine* e, int i) {
    Node* n = &e->nodes[i];
    if (n->dead) return;
    if (n->dom_id.len)
        e->apply_bucket(i, n, e->by_id, n->dom_id);
    for (int c = 0; c < n->nclass; c++)
        e->apply_bucket(i, n, e->by_class, n->classes[c]);
    e->apply_bucket(i, n, e->by_type, n->tag);
    if (n->parent >= 0) {
        Node* par = &e->nodes[n->parent];
        if (par->dom_id.len)
            e->apply_bucket(i, n, e->by_parent_id, par->dom_id);
        for (int c = 0; c < par->nclass; c++)
            e->apply_bucket(i, n, e->by_parent_class, par->classes[c]);
        e->apply_bucket(i, n, e->by_parent_type, par->tag);
        e->apply_pairs(i, n, e->child_pairs, par);
        int p = par->parent;
        while (p >= 0) {
            e->apply_pairs(i, n, e->desc_pairs, &e->nodes[p]);
            p = e->nodes[p].parent;
        }
        e->apply_pairs(i, n, e->desc_pairs, par);
    }
    Vec::[int]* u = &e->universal;
    if (u->data) {
        Vec::[int] rules = *u;
        @for (rule_idx in rules)
            e->apply_rule(i, n, rule_idx);
    }
    e->seal_box(n, i);
}

static void Engine_paint_levels(Engine* e) {
    int maxd = 0;
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead) {
            e->nodes[i].depth = -1;
            continue;
        }
        int d = 0, p = e->nodes[i].parent;
        while (p >= 0) {
            d++;
            p = e->nodes[p].parent;
        }
        e->nodes[i].depth = d;
        if (d > maxd) maxd = d;
    }
    e->max_depth = maxd;
    for (int d = 0; d <= maxd + 1 && d < 64; d++)
        e->level_off[d] = 0;
    for (int i = 0; i < e->nnodes; i++)
        if (!e->nodes[i].dead && e->nodes[i].depth + 1 < 64)
            e->level_off[e->nodes[i].depth + 1]++;
    for (int d = 0; d <= maxd && d + 1 < 64; d++)
        e->level_off[d + 1] += e->level_off[d];
    int cur[64];
    for (int d = 0; d <= maxd && d < 64; d++)
        cur[d] = e->level_off[d];
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead) continue;
        int d = e->nodes[i].depth;
        if (d < 0 || d >= 64) continue;
        e->level_ids[cur[d]++] = i;
    }
}

static void Engine_inherit_one(Engine* e, int i) {
    Node* n = &e->nodes[i];
    if (n->dead) return;
    unsigned box_bits = ((1u << N_BOX) - 1u) << N_BG;
    unsigned font_bits = ((1u << N_FONT) - 1u) << (N_BG + N_BOX);
    if (!(n->specified & (1u << P_display)) || !n->used.box->display.len) {
        if (!(n->specified & box_bits)) {
            n->used.box = slices_eq(&n->tag, &e->ident_div) ? &e->box_block : &e->box_inline;
        } else {
            n->used.box->display = slices_eq(&n->tag, &e->ident_div) ? e->ident_block : e->ident_inline;
        }
    }
    if ((!(n->specified & (1u << P_position)) || !n->used.box->position.len) &&
        n->used.box != &e->box_init && n->used.box != &e->box_block &&
        n->used.box != &e->box_inline)
        n->used.box->position = e->ident_static;
    StyFont* src = n->parent >= 0 ? e->nodes[n->parent].used.font : &e->font_init;
    if (!(n->specified & font_bits))
        n->used.font = src;
    else {
        if (!(n->specified & (1u << P_fs_px)))
            n->used.font->fs_px = src->fs_px;
        else if (n->fs_unit == UNIT_EM)
            n->used.font->fs_px = src->fs_px * n->fs_spec;
        else if (n->fs_unit == UNIT_PCT)
            n->used.font->fs_px = src->fs_px * n->fs_spec / 100;
        else if (n->fs_unit == UNIT_REM) {
            int base = INIT_FS_PX;
            if (n->parent >= 0) {
                int ri = n->parent;
                while (e->nodes[ri].parent >= 0)
                    ri = e->nodes[ri].parent;
                base = e->nodes[ri].used.font->fs_px;
            }
            n->used.font->fs_px = base * n->fs_spec;
        }
        if (!(n->specified & (1u << P_lh_px)))
            n->used.font->lh_px = src->lh_px;
        if (!(n->specified & (1u << P_fw)))
            n->used.font->fw = src->fw;
        if (!(n->specified & (1u << P_visibility)))
            n->used.font->visibility = src->visibility;
        if (!(n->specified & (1u << P_color)))
            n->used.font->color = src->color;
    }
    if ((n->specified & (1u << P_bg)) && n->bg_current) {
        e->own_bg(n, i);
        n->used.bg->bg.r = n->used.font->color.r;
        n->used.bg->bg.g = n->used.font->color.g;
        n->used.bg->bg.b = n->used.font->color.b;
        n->used.bg->bg.a = 255;
    }
}

static uint64_t node_share_hash(const Node* n) {
    uint64_t h = (uint64_t)(uint32_t)n->parent * 0x9E3779B97F4A7C15ULL;
    h ^= (uint64_t)(uintptr_t)n->tag.ptr;
    h ^= (uint64_t)(uintptr_t)n->dom_id.ptr;
    h ^= (uint64_t)(uint32_t)n->nclass << 32;
    h ^= (uint64_t)(uint32_t)n->nattr;
    for (int i = 0; i < n->nclass; i++)
        h = h * 0x9E3779B97F4A7C15ULL + (uint64_t)(uintptr_t)n->classes[i].ptr;
    for (int i = 0; i < n->nattr; i++) {
        h = h * 0x9E3779B97F4A7C15ULL + (uint64_t)(uintptr_t)n->attrs[i].name.ptr;
        h ^= (uint64_t)(uintptr_t)n->attrs[i].value.ptr;
    }
    return h;
}

static int node_share_eq(const Node* a, const Node* b) {
    if (a->parent != b->parent) return 0;
    if (a->tag.ptr != b->tag.ptr) return 0;
    if (a->dom_id.ptr != b->dom_id.ptr) return 0;
    if (a->nclass != b->nclass || a->nattr != b->nattr) return 0;
    for (int i = 0; i < a->nclass; i++)
        if (a->classes[i].ptr != b->classes[i].ptr) return 0;
    for (int i = 0; i < a->nattr; i++) {
        if (a->attrs[i].name.ptr != b->attrs[i].name.ptr) return 0;
        if (a->attrs[i].value.ptr != b->attrs[i].value.ptr) return 0;
    }
    return 1;
}

static int share_ent_cmp(const void* a, const void* b) {
    const ShareEnt* x = (const ShareEnt*)a;
    const ShareEnt* y = (const ShareEnt*)b;
    if (x->h < y->h) return -1;
    if (x->h > y->h) return 1;
    return 0;
}

static void Engine_build_share(Engine* e) {
    int nent = 0;
    for (int i = 0; i < e->nnodes; i++) {
        e->share_of[i] = i;
        if (e->nodes[i].dead) continue;
        e->share_ents[nent].h = node_share_hash(&e->nodes[i]);
        e->share_ents[nent].i = i;
        nent++;
    }
    qsort(e->share_ents, (size_t)nent, sizeof(ShareEnt), share_ent_cmp);
    int ncanon = 0;
    int k = 0;
    while (k < nent) {
        uint64_t h = e->share_ents[k].h;
        int run = k + 1;
        while (run < nent && e->share_ents[run].h == h)
            run++;
        for (int i = k; i < run; i++) {
            int id = e->share_ents[i].i;
            int canon = id;
            for (int j = k; j < i; j++) {
                int cj = e->share_ents[j].i;
                if (e->share_of[cj] == cj && node_share_eq(&e->nodes[id], &e->nodes[cj])) {
                    canon = cj;
                    break;
                }
            }
            e->share_of[id] = canon;
        }
        k = run;
    }
    ncanon = 0;
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead) continue;
        if (e->share_of[i] == i)
            e->share_ents[ncanon++].i = i;
    }
    e->ncanon = ncanon;
}

/* Dirty nodes only. Same parent is the share key, so the sibling
 * list is the group. Prefer a clean twin (already styled). */
static int Engine_share_canon(Engine* e, int d) {
    Node* nd = &e->nodes[d];
    int p = nd->parent;
    if (p < 0) return d;
    int clean = -1;
    int dirty_id = d;
    for (int s = e->nodes[p].first_child; s >= 0; s = e->nodes[s].next_sib) {
        if (e->nodes[s].dead) continue;
        if (!node_share_eq(nd, &e->nodes[s])) continue;
        if (!e->nodes[s].dirty) {
            if (clean < 0 || s < clean) clean = s;
        } else if (s < dirty_id) {
            dirty_id = s;
        }
    }
    return clean >= 0 ? clean : dirty_id;
}

static void Engine_rebuild_share_dirty(Engine* e) {
    int ncanon = 0;
    for (int i = 0; i < e->nnodes; i++) {
        if (e->nodes[i].dead || !e->nodes[i].dirty) continue;
        int c = e->share_canon(i);
        e->share_of[i] = c;
        if (c == i)
            e->share_ents[ncanon++].i = i;
    }
    e->ncanon = ncanon;
}

static void Engine_log_change(Engine* e, int node, int how, CCSlice atom, CCSlice prev, CCSlice next) {
    if (e->nchanges >= e->cap_changes || !e->changes) return;
    e->changes[e->nchanges].node = node;
    e->changes[e->nchanges].how = how;
    e->changes[e->nchanges].atom = atom;
    e->changes[e->nchanges].prev = prev;
    e->changes[e->nchanges].next = next;
    e->nchanges++;
}

static int node_under(Engine* e, int d, int src, int child_only) {
    if (d == src) return 0;
    if (child_only) return e->nodes[d].parent == src;
    int p = e->nodes[d].parent;
    while (p >= 0) {
        if (p == src) return 1;
        p = e->nodes[p].parent;
    }
    return 0;
}

static int Engine_tmp_add_class(Engine* e, Node* n, CCSlice A) {
    if (!e->ensure_class_cap(n, n->nclass + 1)) return 0;
    n->classes[n->nclass++] = A;
    return 1;
}

static void Engine_tmp_del_one_class(Node* n, CCSlice A) {
    for (int i = 0; i < n->nclass; i++) {
        if (n->classes[i].ptr != A.ptr) continue;
        for (int j = i + 1; j < n->nclass; j++)
            n->classes[j - 1] = n->classes[j];
        n->nclass--;
        return;
    }
}

static int Engine_tmp_set_attr(Engine* e, Node* n, CCSlice name, CCSlice val) {
    for (int i = 0; i < n->nattr; i++) {
        if (n->attrs[i].name.ptr == name.ptr) {
            n->attrs[i].value = val;
            return 1;
        }
    }
    if (!e->ensure_attr_cap(n, n->nattr + 1)) return 0;
    n->attrs[n->nattr].name = name;
    n->attrs[n->nattr].value = val;
    n->nattr++;
    return 1;
}

static void Engine_tmp_del_attr(Node* n, CCSlice name) {
    int w = 0;
    for (int i = 0; i < n->nattr; i++)
        if (n->attrs[i].name.ptr != name.ptr)
            n->attrs[w++] = n->attrs[i];
    n->nattr = w;
}

/* Inverse of apply_mut for this atom. One instance, not all copies. */
static void Engine_change_undo(Engine* e, Change* ch) {
    Node* n = &e->nodes[ch->node];
    if (ch->how == CH_ADD_CLASS) Engine_tmp_del_one_class(n, ch->atom);
    else if (ch->how == CH_DEL_CLASS) e->tmp_add_class(n, ch->atom);
    else if (ch->how == CH_SET_ATTR) {
        if (!ch->prev.ptr) Engine_tmp_del_attr(n, ch->atom);
        else e->tmp_set_attr(n, ch->atom, ch->prev);
    } else if (ch->how == CH_DEL_ATTR) {
        e->tmp_set_attr(n, ch->atom, ch->prev);
    }
}

static void Engine_change_redo(Engine* e, Change* ch) {
    Node* n = &e->nodes[ch->node];
    if (ch->how == CH_ADD_CLASS) e->tmp_add_class(n, ch->atom);
    else if (ch->how == CH_DEL_CLASS) Engine_tmp_del_one_class(n, ch->atom);
    else if (ch->how == CH_SET_ATTR) e->tmp_set_attr(n, ch->atom, ch->next);
    else if (ch->how == CH_DEL_ATTR) Engine_tmp_del_attr(n, ch->atom);
}

static int Engine_left_matches(Engine* e, int src, const Rule* r, CCSlice A) {
    for (int ci = 0; ci + 1 < r->n; ci++)
        if (compound_has_atom(&r->c[ci], A) &&
            e->nodes[src].match_compound(&r->c[ci]))
            return 1;
    return 0;
}

static void Engine_collect_desc(Engine* e, int src, int child_only, const Compound* S, int* nc) {
    for (int c = e->nodes[src].first_child; c >= 0; c = e->nodes[c].next_sib) {
        if (e->nodes[c].dead) continue;
        if (!S || compound_open(S) || e->nodes[c].match_compound(S)) {
            if (*nc < e->cap_nodes) e->inv_ids[(*nc)++] = c;
        }
        if (!child_only)
            e->collect_desc(c, 0, S, nc);
    }
}

static void Engine_dirty_rule_flip(Engine* e, Change* ch, int k) {
    Rule* r = &e->rules[k];
    if (!r->n || !r->c) return;
    int src = ch->node;
    int after_left = e->left_matches(src, r, ch->atom);
    e->change_undo(ch);
    int before_left = e->left_matches(src, r, ch->atom);
    e->change_redo(ch);
    if (!after_left && !before_left) return;
    int earlier = 0;
    for (int ci = 0; ci + 2 < r->n; ci++)
        if (compound_has_atom(&r->c[ci], ch->atom)) earlier = 1;
    int child_only = !earlier && r->n >= 2 && r->comb[r->n - 2] == COMB_CHILD;
    int nc = 0;
    e->collect_desc(src, child_only, &r->c[r->n - 1], &nc);
    for (int i = 0; i < nc; i++)
        e->inv_off[i] = e->match_from_join(e->inv_ids[i], r, r->n - 1);
    e->change_undo(ch);
    for (int i = 0; i < nc; i++) {
        int d = e->inv_ids[i];
        if (e->match_from_join(d, r, r->n - 1) != e->inv_off[i])
            e->nodes[d].dirty = 1;
    }
    e->change_redo(ch);
}

static void Engine_dirty_bucket_under(Engine* e, Map::[CCSlice, Vec::[int]] m,
                                      CCSlice S, int src, int child_only,
                                      const Compound* match) {
    if (!m || !S.len) return;
    Vec::[int]* b = m->get_ptr(S);
    if (!b || !b->data) return;
    Vec::[int] ids = *b;
    @for (d in ids) {
        if (d < 0 || d >= e->nnodes) continue;
        Node* nd = &e->nodes[d];
        if (nd->dead) continue;
        if (!node_under(e, d, src, child_only)) continue;
        if (match && !compound_open(match) && !nd->match_compound(match))
            continue;
        nd->dirty = 1;
    }
}

static void Engine_dirty_atom_under(Engine* e, CCSlice S, int src, int child_only,
                                    const Compound* match) {
    e->dirty_bucket_under(e->live_id, S, src, child_only, match);
    e->dirty_bucket_under(e->live_class, S, src, child_only, match);
    e->dirty_bucket_under(e->live_type, S, src, child_only, match);
}

static void Engine_dirty_left_subjs(Engine* e, Map::[CCSlice, Vec::[CCSlice]] m,
                                    CCSlice A, int src, int child_only) {
    if (!m || !A.len) return;
    Vec::[CCSlice]* b = m->get_ptr(A);
    if (!b || !b->data) return;
    Vec::[CCSlice] subjs = *b;
    @for (S in subjs)
        e->dirty_atom_under(S, src, child_only, 0);
}

static void Engine_dirty_desc(Engine* e, int src) {
    for (int c = e->nodes[src].first_child; c >= 0; c = e->nodes[c].next_sib) {
        if (e->nodes[c].dead) continue;
        e->nodes[c].dirty = 1;
        e->dirty_desc(c);
    }
}

static void Engine_dirty_desc_match(Engine* e, int src, const Compound* S, int child_only) {
    for (int c = e->nodes[src].first_child; c >= 0; c = e->nodes[c].next_sib) {
        if (e->nodes[c].dead) continue;
        if (!child_only || e->nodes[c].parent == src) {
            if (compound_open(S) || e->nodes[c].match_compound(S))
                e->nodes[c].dirty = 1;
        }
        if (!child_only)
            e->dirty_desc_match(c, S, 0);
    }
}

static void Engine_dirty_parent_rules(Engine* e, int src, Map::[CCSlice, Vec::[int]] m, CCSlice A) {
    if (!m || !A.len) return;
    Vec::[int]* b = m->get_ptr(A);
    if (!b || !b->data) return;
    Vec::[int] rules = *b;
    @for (k in rules) {
        Rule* r = &e->rules[k];
        if (!r->n || !r->c) continue;
        Compound* S = &r->c[r->n - 1];
        if (compound_open(S)) {
            for (int c = e->nodes[src].first_child; c >= 0; c = e->nodes[c].next_sib)
                if (!e->nodes[c].dead) e->nodes[c].dirty = 1;
        } else {
            CCSlice sk = compound_key(S);
            if (sk.len)
                e->dirty_atom_under(sk, src, 1, S);
            else
                e->dirty_desc_match(src, S, 1);
        }
    }
}

static void Engine_dirty_parent_join(Engine* e, int src, CCSlice A) {
    e->dirty_parent_rules(src, e->by_parent_id, A);
    e->dirty_parent_rules(src, e->by_parent_class, A);
    e->dirty_parent_rules(src, e->by_parent_type, A);
}

static void Engine_dirty_left_extra(Engine* e, int src, CCSlice A) {
    if (!e->left_rules || !A.len) return;
    Vec::[int]* rs = e->left_rules->get_ptr(A);
    if (!rs || !rs->data) return;
    Vec::[int] rules = *rs;
    @for (k in rules) {
        Rule* r = &e->rules[k];
        if (!r->n || !r->c) continue;
        int earlier = 0;
        for (int ci = 0; ci + 2 < r->n; ci++)
            if (compound_has_atom(&r->c[ci], A)) earlier = 1;
        int child_only = !earlier && r->n >= 2 && r->comb[r->n - 2] == COMB_CHILD;
        Compound* S = &r->c[r->n - 1];
        if (compound_open(S)) {
            if (child_only) {
                for (int c = e->nodes[src].first_child; c >= 0; c = e->nodes[c].next_sib)
                    if (!e->nodes[c].dead) e->nodes[c].dirty = 1;
            } else {
                e->dirty_desc(src);
            }
            continue;
        }
        CCSlice sk = compound_key(S);
        if (sk.len)
            e->dirty_atom_under(sk, src, child_only, S);
        else
            e->dirty_desc_match(src, S, child_only);
    }
}

/* Dirty N. Descendants only if match_from flips with vs without the atom. */
static void Engine_fanout_dirty(Engine* e) {
    int n = e->nnodes;
    for (int i = 0; i < e->nchanges; i++) {
        Change* ch = &e->changes[i];
        int id = ch->node;
        if (id < 0 || id >= n) continue;
        if (e->nodes[id].dead) continue;
        e->nodes[id].dirty = 1;
        if (!e->left_rules || !ch->atom.len) continue;
        Vec::[int]* rs = e->left_rules->get_ptr(ch->atom);
        if (!rs || !rs->data) continue;
        Vec::[int] rules = *rs;
        @for (k in rules)
            e->dirty_rule_flip(ch, k);
    }
    e->nchanges = 0;
}

static void Engine_clear_dirty(Engine* e) {
    for (int i = 0; i < e->nnodes; i++)
        e->nodes[i].dirty = 0;
}

static void Engine_reset_dirty(Engine* e) {
    for (int i = 0; i < e->nnodes; i++) {
        Node* n = &e->nodes[i];
        if (!n->dirty) continue;
        n->specified = 0;
        n->fs_spec = 0;
        n->fs_unit = 0;
        n->bg_current = 0;
        n->used.bg = &e->bg_init;
        n->used.box = &e->box_init;
        n->used.font = &e->font_init;
        for (int p = 0; p < NPROP; p++) {
            n->spec_a[p] = n->spec_b[p] = n->spec_c[p] = -1;
            n->win_order[p] = -1;
            n->win_rank[p] = -1;
        }
    }
}

static void Engine_copy_specified(Engine* e, int dst, int src) {
    /* Clone into dst's pool. Pointer-sharing is fine on a full restyle
     * (every sharer inherits and writes the same values). Incremental
     * inherit is dirty-only: a dirty copy writing through a clean
     * canon's StyBg / StyBox / StyFont corrupts the clean dump. */
    e->bg_pool[dst] = *e->nodes[src].used.bg;
    e->box_pool[dst] = *e->nodes[src].used.box;
    e->font_pool[dst] = *e->nodes[src].used.font;
    e->nodes[dst].used.bg = &e->bg_pool[dst];
    e->nodes[dst].used.box = &e->box_pool[dst];
    e->nodes[dst].used.font = &e->font_pool[dst];
    e->nodes[dst].specified = e->nodes[src].specified;
    e->nodes[dst].fs_spec = e->nodes[src].fs_spec;
    e->nodes[dst].fs_unit = e->nodes[src].fs_unit;
    e->nodes[dst].bg_current = e->nodes[src].bg_current;
}

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

static void !>(CCError) Engine_style_all(Engine* eng) {
    EngineMatch m = eng;
    double t0 = now_ms();
    m->paint_levels();
    eng->t_levels = now_ms() - t0;
    t0 = now_ms();
    eng->build_share();
    eng->t_share = now_ms() - t0;
    int nc = eng->ncanon;
    t0 = now_ms();
    @parallel for (k in 0..nc) {
        m->style_one(eng->share_ents[k].i);
    } !>.wait()!>;
    for (int i = 0; i < eng->nnodes; i++) {
        if (eng->share_of[i] != i)
            m->copy_specified(i, eng->share_of[i]);
    }
    eng->t_match = now_ms() - t0;
    for (int si = 0; si < eng->nnodes; si++) {
        if (eng->nodes[si].dead) continue;
        Rule sr;
        if (parse_style_decls(eng, &eng->nodes[si], &sr))
            m->apply_specified(si, &eng->nodes[si], &sr);
        m->seal_box(&eng->nodes[si], si);
    }
    t0 = now_ms();
    int maxd = eng->max_depth;
    int hi = (maxd + 1 < 64) ? eng->level_off[maxd + 1] : 0;
    for (int k = 0; k < hi; k++)
        m->inherit_one(eng->level_ids[k]);
    eng->t_inherit = now_ms() - t0;
    return cc_ok();
}

static void !>(CCError) Engine_style_dirty(Engine* eng) {
    EngineMatch m = eng;
    double t0 = now_ms();
    if (eng->levels_stale) {
        m->paint_levels();
        eng->levels_stale = 0;
    }
    eng->t_levels = now_ms() - t0;
    t0 = now_ms();
    eng->rebuild_share_dirty();
    eng->t_share = now_ms() - t0;
    int nc = eng->ncanon;
    t0 = now_ms();
    @parallel for (k in 0..nc) {
        int i = eng->share_ents[k].i;
        if (eng->nodes[i].dirty)
            m->style_one(i);
    } !>.wait()!>;
    for (int i = 0; i < eng->nnodes; i++) {
        if (!eng->nodes[i].dirty) continue;
        if (eng->share_of[i] != i)
            m->copy_specified(i, eng->share_of[i]);
    }
    eng->t_match = now_ms() - t0;
    for (int si = 0; si < eng->nnodes; si++) {
        if (eng->nodes[si].dead || !eng->nodes[si].dirty) continue;
        Rule sr;
        if (parse_style_decls(eng, &eng->nodes[si], &sr))
            m->apply_specified(si, &eng->nodes[si], &sr);
        m->seal_box(&eng->nodes[si], si);
    }
    t0 = now_ms();
    int maxd = eng->max_depth;
    int hi = (maxd + 1 < 64) ? eng->level_off[maxd + 1] : 0;
    for (int k = 0; k < hi; k++) {
        int i = eng->level_ids[k];
        if (eng->nodes[i].dirty)
            m->inherit_one(i);
    }
    eng->t_inherit = now_ms() - t0;
    return cc_ok();
}

static CCSlice fmt_px(int v, CCSlice auto_s, char* buf, size_t cap) {
    if (v == PX_AUTO) return auto_s;
    if (v == PX_NORMAL) return @slice("normal");
    int n = snprintf(buf, cap, "%dpx", v);
    if (n < 0) n = 0;
    if ((size_t)n >= cap) n = (int)cap - 1;
    return cc_slice_from_buffer(buf, (size_t)n);
}

static int split_tabs(CCSlice line, CCSlice* out, int cap) {
    int n = 0;
    size_t i = 0;
    while (n < cap) {
        size_t j = i;
        while (j < line.len && line.ptr[j] != '\t') j++;
        out[n] = line.sub(i, j);
        n++;
        if (j >= line.len) break;
        i = j + 1;
    }
    return n;
}

static int slice_eq_lit(CCSlice s, const char* lit) {
    return s.eq_cstr(lit);
}

static int parse_int_slice(CCSlice s) {
    return (int)(s.to_i64() ?> 0);
}

static void !>(CCError) Engine_ingest_muts(Engine* e, char[:] text) {
    size_t pos = 0;
    while (pos < text.len) {
        while (pos < text.len && (text.ptr[pos] == '\n' || text.ptr[pos] == '\r'))
            pos++;
        if (pos >= text.len) break;
        size_t start = pos;
        while (pos < text.len && text.ptr[pos] != '\n') pos++;
        CCSlice line = text.sub(start, pos);
        if (!line.len) continue;
        if (e->nmuts >= e->cap_muts)
            return cc_err(CC_ERR_INVALID_ARG, "too many muts");
        MutOp* m = &e->muts[e->nmuts];
        memset(m, 0, sizeof(*m));
        if (slice_eq_lit(line, "restyle")) {
            m->kind = MUT_RESTYLE;
            e->nmuts++;
            continue;
        }
        CCSlice cols[8];
        int nc = split_tabs(line, cols, 8);
        if (slice_eq_lit(cols[0], "+class") && nc >= 3) {
            m->kind = MUT_ADD_CLASS;
            m->id = parse_int_slice(cols[1]);
            m->a = cols[2];
        } else if (slice_eq_lit(cols[0], "-class") && nc >= 2) {
            m->kind = MUT_REMOVE_CLASS;
            m->id = parse_int_slice(cols[1]);
        } else if (slice_eq_lit(cols[0], "+attr") && nc >= 3) {
            m->kind = MUT_SET_ATTR;
            m->id = parse_int_slice(cols[1]);
            size_t eq = 0;
            while (eq < cols[2].len && cols[2].ptr[eq] != '=') eq++;
            m->a = cols[2].sub(0, eq);
            m->b = eq < cols[2].len
                ? cols[2].sub(eq + 1, cols[2].len)
                : cc_slice_empty();
        } else if (slice_eq_lit(cols[0], "-attr") && nc >= 3) {
            m->kind = MUT_REMOVE_ATTR;
            m->id = parse_int_slice(cols[1]);
            m->a = cols[2];
        } else if (slice_eq_lit(cols[0], "+leaf") && nc >= 6) {
            m->kind = MUT_ADD_LEAF;
            m->id = parse_int_slice(cols[1]);
            m->parent = parse_int_slice(cols[2]);
            m->at = parse_int_slice(cols[3]);
            m->a = cols[4];
            m->b = cols[5];
            m->classes = nc > 6 ? cols[6] : cc_slice_empty();
            m->attrs = nc > 7 ? cols[7] : cc_slice_empty();
        } else if (slice_eq_lit(cols[0], "-leaf") && nc >= 2) {
            m->kind = MUT_REMOVE_LEAF;
            m->id = parse_int_slice(cols[1]);
        } else {
            return cc_err(CC_ERR_PARSE, "mut line");
        }
        e->nmuts++;
    }
    return cc_ok();
}

static int Engine_ensure_class_cap(Engine* e, Node* n, int need) {
    if (n->cap_class >= need) return 1;
    int cap = n->cap_class ? n->cap_class * 2 : MAX_CLASS;
    while (cap < need) cap *= 2;
    CCSlice* p = e->store.allocT::[CCSlice](cap);
    if (!p) return 0;
    if (n->classes && n->nclass)
        memcpy(p, n->classes, sizeof(CCSlice) * (size_t)n->nclass);
    n->classes = p;
    n->cap_class = cap;
    return 1;
}

static int Engine_ensure_attr_cap(Engine* e, Node* n, int need) {
    if (n->cap_attr >= need) return 1;
    int cap = n->cap_attr ? n->cap_attr * 2 : MAX_ATTR;
    while (cap < need) cap *= 2;
    Attr* p = e->store.allocT::[Attr](cap);
    if (!p) return 0;
    if (n->attrs && n->nattr)
        memcpy(p, n->attrs, sizeof(Attr) * (size_t)n->nattr);
    n->attrs = p;
    n->cap_attr = cap;
    return 1;
}

static void Engine_apply_mut(Engine* e, MutOp* m) {
    if (m->kind == MUT_ADD_LEAF) {
        if (m->id != e->nnodes || e->nnodes >= e->cap_nodes) return;
        Node* nd = &e->nodes[e->nnodes];
        e->fill_node(nd, m->parent, m->a, m->b, m->classes, m->attrs);
        nd->dirty = 1;
        e->levels_stale = 1;
        e->nnodes++;
        return;
    }
    if (m->id < 0 || m->id >= e->nnodes) return;
    Node* n = &e->nodes[m->id];
    if (m->kind == MUT_REMOVE_LEAF) {
        int p = n->parent;
        if (p >= 0) {
            int* w = &e->nodes[p].first_child;
            while (*w >= 0) {
                if (*w == m->id) {
                    *w = n->next_sib;
                    break;
                }
                w = &e->nodes[*w].next_sib;
            }
        }
        n->next_sib = -1;
        n->dead = 1;
        n->parent = -1;
        return;
    }
    if (n->dead) return;
    if (m->kind == MUT_ADD_CLASS) {
        CCSlice c = e->intern(m->a);
        if (n->has_class(&c)) return;
        if (!e->ensure_class_cap(n, n->nclass + 1)) return;
        n->classes[n->nclass++] = c;
        e->push_bucket(e->live_class, c, m->id);
        n->dirty = 1;
        e->log_change(m->id, CH_ADD_CLASS, c, cc_slice_empty(), cc_slice_empty());
    } else if (m->kind == MUT_REMOVE_CLASS) {
        if (n->nclass <= 0) return;
        CCSlice gone = n->classes[0];
        for (int i = 1; i < n->nclass; i++)
            n->classes[i - 1] = n->classes[i];
        n->nclass--;
        if (!n->has_class(&gone))
            e->forget_live(e->live_class, gone, m->id);
        n->dirty = 1;
        e->log_change(m->id, CH_DEL_CLASS, gone, cc_slice_empty(), cc_slice_empty());
    } else if (m->kind == MUT_SET_ATTR) {
        CCSlice name = e->intern(m->a);
        CCSlice val = e->intern(m->b);
        for (int i = 0; i < n->nattr; i++) {
            if (slices_eq(&n->attrs[i].name, &name)) {
                CCSlice old = n->attrs[i].value;
                n->attrs[i].value = val;
                n->dirty = 1;
                e->log_change(m->id, CH_SET_ATTR, name, old, val);
                return;
            }
        }
        if (!e->ensure_attr_cap(n, n->nattr + 1)) return;
        n->attrs[n->nattr].name = name;
        n->attrs[n->nattr].value = val;
        n->nattr++;
        n->dirty = 1;
        e->log_change(m->id, CH_SET_ATTR, name, cc_slice_empty(), val);
    } else if (m->kind == MUT_REMOVE_ATTR) {
        CCSlice name = e->intern(m->a);
        CCSlice old = cc_slice_empty();
        int w = 0;
        for (int i = 0; i < n->nattr; i++) {
            if (slices_eq(&n->attrs[i].name, &name)) {
                old = n->attrs[i].value;
                continue;
            }
            n->attrs[w++] = n->attrs[i];
        }
        if (w != n->nattr) {
            n->dirty = 1;
            e->log_change(m->id, CH_DEL_ATTR, name, old, cc_slice_empty());
        }
        n->nattr = w;
    }
}

static size_t unique_node_shards(CCShardMask mask, const int* ids, int nids,
                                uint64_t* names, size_t cap) {
    size_t n = 0;
    for (int i = 0; i < nids; i++) {
        uint64_t si = (uint64_t)mask.index((uint64_t)(uint32_t)ids[i]);
        int seen = 0;
        for (size_t j = 0; j < n; j++)
            if (names[j] == si) { seen = 1; break; }
        if (!seen && n < cap) names[n++] = si;
    }
    return n;
}

static void !>(CCError) Engine_run_mutations(Engine* e, CCShardDomain* domain, double* mut_ms) {
    int start = 0;
    *mut_ms = 0;
    while (start < e->nmuts) {
        int end = start;
        while (end < e->nmuts && e->muts[end].kind != MUT_RESTYLE)
            end++;
        int ids[256];
        int nids = 0;
        for (int i = start; i < end; i++) {
            MutOp* m = &e->muts[i];
            if (m->kind == MUT_ADD_LEAF) {
                if (nids < 256) ids[nids++] = m->parent;
                if (nids < 256) ids[nids++] = m->id;
            } else if (m->kind != MUT_RESTYLE) {
                if (nids < 256) ids[nids++] = m->id;
            }
        }
        if (nids) {
            uint64_t names[MAX_SHARDS];
            size_t nnames = unique_node_shards(domain->mask, ids, nids, names, MAX_SHARDS);
            CCShardHold hold = nnames
                ? domain->hold_sorted(names, nnames)
                : domain->hold_all();
            @defer hold.release();
            if (!hold.held())
                return cc_err(CC_ERR_INVALID_ARG, "shard admission failed");
            EngineMut mut = e;
            for (int i = start; i < end; i++)
                mut->apply_mut(&e->muts[i]);
        }
        if (end < e->nmuts && e->muts[end].kind == MUT_RESTYLE) {
            e->fanout_dirty();
            e->paint_blooms();
            e->reset_dirty();
            double t0 = now_ms();
            e->style_dirty() !>;
            *mut_ms += now_ms() - t0;
            e->clear_dirty();
            start = end + 1;
        } else {
            start = end;
        }
    }
    return cc_ok();
}

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    CCArena store = cc_arena_heap(megabytes(128)) @destroy;
    CCStdio io = cc_stdio_create(store);
    char[:] path = argc > 1
        ? cc_slice_from_buffer((void*)argv[1], strlen(argv[1]))
        : @slice("fixtures/tiny.stylebench");
    char[:] text = path.read_path(store) !>;

    Engine eng = {0};
    eng.store = store;
    eng.load_fixture(text) !>;

    double t0 = now_ms();
    eng.style_all() !>;
    double ms = now_ms() - t0;
    eng.t0_levels = eng.t_levels;
    eng.t0_share = eng.t_share;
    eng.t0_match = eng.t_match;
    eng.t0_inherit = eng.t_inherit;
    int ncanon0 = eng.ncanon;

    CCArena excl_arena = cc_arena_heap(megabytes(2)) @destroy;
    CCShardMask mask = cc_shard_mask_auto(MAX_SHARDS);
    if (!mask.count) mask = cc_shard_mask_make(1u);
    CCExclusive excl = cc_exclusive_create(excl_arena, mask.count * 2u) !> @destroy;
    CCShardDomain domain = cc_shard_domain(excl, mask);
    double mut_ms = 0;
    eng.run_mutations(&domain, &mut_ms) !>;

    int live = 0;
    for (int i = 0; i < eng.nnodes; i++)
        if (!eng.nodes[i].dead) live++;

    io.println(@string(`# runner=cc fixture=${path}`, @scratch));
    io.println(@string(`# TIME_MS=${ms} TIME_MUT_MS=${mut_ms} elements=${live} TIME_LEVELS=${eng.t0_levels} TIME_SHARE=${eng.t0_share} TIME_MATCH=${eng.t0_match} TIME_INHERIT=${eng.t0_inherit} LAST_MATCH=${eng.t_match} canons=${ncanon0} depth=${eng.max_depth} rules=${eng.nrules} univ=${eng.universal.len}`, @scratch));
    for (int i = 0; i < eng.nnodes; i++) {
        Node* n = &eng.nodes[i];
        if (n->dead) continue;
        CCSlice tag = n->tag;
        CCSlice id = n->dom_id.len ? n->dom_id : @slice("-");
        CCSlice disp = n->used.box->display.len ? n->used.box->display : @slice("inline");
        CCSlice pos = n->used.box->position.len ? n->used.box->position : @slice("static");
        CCSlice vis = n->used.font->visibility.len ? n->used.font->visibility : @slice("visible");
        char wbuf[16], hbuf[16], minwbuf[16], fsbuf[16], lhbuf[16];
        CCSlice w = fmt_px(n->used.box->width_px, @slice("auto"), wbuf, sizeof(wbuf));
        CCSlice h = fmt_px(n->used.box->height_px, @slice("auto"), hbuf, sizeof(hbuf));
        CCSlice minw = fmt_px(n->used.box->minw_px, @slice("auto"), minwbuf, sizeof(minwbuf));
        CCSlice fs = fmt_px(n->used.font->fs_px, @slice("16px"), fsbuf, sizeof(fsbuf));
        CCSlice lh = fmt_px(n->used.font->lh_px, @slice("normal"), lhbuf, sizeof(lhbuf));
        io.println(@string(`${i}\t${tag}\tid=${id}\tdisp=${disp}\tpos=${pos}\tw=${w}\th=${h}\tminw=${minw}\tfs=${fs}\tlh=${lh}\tfw=${n->used.font->fw}\tvis=${vis}\tcolor=rgb(${n->used.font->color.r}, ${n->used.font->color.g}, ${n->used.font->color.b})\tbg=${n->used.bg->bg.r},${n->used.bg->bg.g},${n->used.bg->bg.b},${n->used.bg->bg.a}`, @scratch));
    }
    return 0;
}
