# stylebench-fixture 1
# name=inherit-propagation
# An inherited value changes on an ancestor; the descendants match no new
# rule (they stay clean) yet must show the new color / re-resolved em.
---base---
#testroot {
  font-size: 10px;
  line-height: 10px;
  color: #111;
}
#testroot * {
  display: inline-block;
  height:10px;
  min-width:10px;
}
---css---
.hot { color: #c00; font-size: 20px; }
.deep { padding-left: 1em; }
#stop { color: #00f; }
---tree---
0	-1	div	testroot		
1	0	elem9	a		
2	1	elem9	b	deep	
3	2	elem9	c		
4	2	elem9	stop		
5	4	elem9	d	deep	
6	0	elem9	e		
7	6	elem9	f		
---mut---
+attr	1	class=hot
restyle
-attr	1	class
+attr	6	style=color:#0a0;font-size:2em
restyle
