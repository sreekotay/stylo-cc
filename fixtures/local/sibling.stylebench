# stylebench-fixture 1
# name=sibling-combinators
---base---
#testroot {
  font-size: 10px;
  line-height: 10px;
}
#testroot * {
  display: inline-block;
  height:10px;
  min-width:10px;
}
---css---
.left + .mid { background-color: rgb(10, 20, 30); }
.left ~ .right { background-color: rgb(40, 50, 60); }
.mid + .right { background-color: rgb(70, 80, 90); }
#testroot > .left + .mid { background-color: rgb(11, 22, 33); }
.mark + span { background-color: rgb(1, 2, 3); }
---tree---
0	-1	div	testroot		
1	0	span	-	left	
2	0	span	-	mid	
3	0	span	-	right	
4	0	span	-		
---mut---
+class	1	mark
restyle
-class	1
restyle
+leaf	5	0	1	span	-	mid	
restyle
-leaf	5
restyle
