+    /// True when the CSSOM font-size slot is already the used px length.
+    /// Overlay must not skip a real used-size change, including 16px.
+    pub(crate) fn overlay_font_size_already_used(source: &Self, font_size_px: f64) -> bool {
+        let Some(StyleValueData::Length { value, unit }) =
+            source.get(property_id::FONT_SIZE).map(RetainedStyleValueData::data)
+        else {
+            return false;
+        };
+        *unit == crate::css::style_compute::px_length_unit()
+            && crate::css::css_pixels::CssPixels::nearest_value_for(*value)
+                == crate::css::css_pixels::CssPixels::nearest_value_for(font_size_px)
+    }
+
+    /// Frozen copy with the CSSOM font-size slot set to used px.
+    /// getComputedStyle reads the longhand table, not the FontValues CssPixels prefix.
+    pub(crate) fn overlay_copy_with_used_font(source: &ComputedLonghandTable, font_size_px: f64) -> Self {
+        let px = crate::css::style_compute::px_length_unit();
+        let font_size =
+            crate::css::style_value::RetainedStyleValueData::from_owned(crate::css::style_value::StyleValueData::Length {
+                value: font_size_px,
+                unit: px,
+            });
+        let mut table = Self::new();
+        table.copy_from(source);
+        table.set(property_id::FONT_SIZE, font_size.clone(), -1);
+        table.set_inherited(property_id::FONT_SIZE, false);
+        table.inheritance_dependent.retain(|(property, _)| *property != property_id::FONT_SIZE);
+        table.rebuild_inheritance_dependent_view();
+        table.set_raw_cascaded_font_size(Some(font_size));
+        table.freeze();
+        table
+    }
+
+    fn overlay_px(px: f64) -> RetainedStyleValueData {
+        RetainedStyleValueData::from_owned(crate::css::style_value::StyleValueData::Length {
+            value: px,
+            unit: crate::css::style_compute::px_length_unit(),
+        })
+    }
+
+    /// New-leaf CSSOM table: initial non-inherited longhands, inherited from the parent,
+    /// then the used display / sizing / font that groups overlay. getComputedStyle reads
+    /// this table; leaving display as `inline` while groups say inline-block is a CSSOM lie.
+    pub(crate) fn overlay_new_leaf_used(
+        parent: &Self,
+        display: crate::css::display::FfiDisplay,
+        height_auto: bool,
+        height_px: f32,
+        min_width_auto: bool,
+        min_width_px: f32,
+        font_size_px: f64,
+        line_height_px: f64,
+    ) -> Self {
+        let source = Self::with_initial_values_and_inherited_from(parent);
+        let mut table = Self::new();
+        table.copy_from(&source);
+        table.set(
+            property_id::DISPLAY,
+            RetainedStyleValueData::from_owned(crate::css::style_value::StyleValueData::Display {
+                raw: display.encoded(),
+            }),
+            -1,
+        );
+        table.set_inherited(property_id::DISPLAY, false);
+        if !height_auto {
+            table.set(property_id::HEIGHT, Self::overlay_px(height_px as f64), -1);
+            table.set_inherited(property_id::HEIGHT, false);
+        }
+        if !min_width_auto {
+            table.set(property_id::MIN_WIDTH, Self::overlay_px(min_width_px as f64), -1);
+            table.set_inherited(property_id::MIN_WIDTH, false);
+        }
+        let font_size = Self::overlay_px(font_size_px);
+        table.set(property_id::FONT_SIZE, font_size.clone(), -1);
+        table.set_inherited(property_id::FONT_SIZE, false);
+        table.set(property_id::LINE_HEIGHT, Self::overlay_px(line_height_px), -1);
+        table.set_inherited(property_id::LINE_HEIGHT, false);
+        table.inheritance_dependent.retain(|(property, _)| {
+            *property != property_id::FONT_SIZE && *property != property_id::LINE_HEIGHT
+        });
+        table.rebuild_inheritance_dependent_view();
+        table.set_raw_cascaded_font_size(Some(font_size));
+        table.freeze();
+        table
+    }
+
+    /// Completely filled initial longhands. `new()` leaves slots null, and
+    /// `compare_style_records` dereferences every longhand pointer. The table is
+    /// thread-local because style values are not Sync.
+    fn with_initial_values_and_inherited_from(parent: &Self) -> Self {
+        thread_local! {
+            static INITIAL: ComputedLonghandTable = {
+                let mut table = ComputedLonghandTable::new();
+                for property_id in FIRST_LONGHAND_PROPERTY_ID..=LAST_LONGHAND_PROPERTY_ID {
+                    let pointer = crate::css::style_compute::initial_value_data(property_id);
+                    let value = unsafe {
+                        RetainedStyleValueData::from_retained_pointer(crate::css::style_value::retain_style_value(
+                            pointer,
+                        ))
+                    };
+                    table.set(property_id, value, -1);
+                }
+                table.freeze();
+                table
+            };
+        }
+        INITIAL.with(|initial| initial.with_inherited_values_from(parent))
+    }
+
     pub(crate) fn with_inherited_values_from(&self, inherited_source: &ComputedLonghandTable) -> Self {
         self.with_inherited_values_and_flags_from(inherited_source, &self.important_bits, &self.inherited_bits)
     }
