+        sibling_index: i32,
+    ) -> i32;
+    fn stylecc_apply_feature(
+        eng: *mut StyleCC,
+        host_id: u32,
+        feature_kind: i32,
+        name_atom: u32,
+        value_atom: u32,
+        present: i32,
+    ) -> i32;
+    fn stylecc_set_viewport_width(eng: *mut StyleCC, width_px: i32);
+    fn stylecc_add_rule(
+        eng: *mut StyleCC,
+        compounds: *const StyleCCCompound,
+        ncomp: usize,
+        combs: *const u8,
+        origin: i32,
+        mq_row: i32,
+        pelem: u8,
+    ) -> i32;
+    fn stylecc_set_rule_decls(
+        eng: *mut StyleCC,
+        rule_id: i32,
+        decls: *const StyleCCDecl,
+        ndecl: usize,
+    ) -> i32;
+    fn stylecc_set_rule_host_id(eng: *mut StyleCC, rule_id: i32, host_rule_id: u32);
+    fn stylecc_index_rules(eng: *mut StyleCC) -> i32;
+    fn stylecc_style_all(eng: *mut StyleCC) -> i32;
+    fn stylecc_style_dirty(eng: *mut StyleCC) -> i32;
+    fn stylecc_mark_dirty(eng: *mut StyleCC, host_id: u32);
+    #[allow(dead_code)]
+    fn stylecc_dirty_count(eng: *mut StyleCC) -> usize;
+    #[allow(dead_code)]
+    fn stylecc_take_dirty(eng: *mut StyleCC, out: *mut u32, cap: usize) -> usize;
+    fn stylecc_used_count(eng: *mut StyleCC) -> usize;
+    fn stylecc_take_used(eng: *mut StyleCC, out: *mut u32, cap: usize) -> usize;
+    fn stylecc_consume_node_used(eng: *mut StyleCC, host_id: u32, out: *mut StyleCCUsed) -> i32;
+    fn stylecc_node_restyled(eng: *mut StyleCC, host_id: u32) -> i32;
+    fn stylecc_consume_node_matches(
+        eng: *mut StyleCC,
+        host_id: u32,
+        out: *mut StyleCCMatch,
+        cap: usize,
+    ) -> usize;
+    fn stylecc_note_drop(eng: *mut StyleCC, reason: *const c_char);
+    fn stylecc_drop_count(eng: *mut StyleCC) -> u64;
+}
+
+struct HostState {
+    cc: *mut StyleCC,
+    /// Ladybird StyleAtomID → StyleCC atom.
+    atom_map: HashMap<u32, u32>,
+    /// Parent host id → ordered element children (for sibling_index).
+    children: HashMap<u32, Vec<u32>>,
+    /// Child → parent (for disconnect cleanup).
+    parent_of: HashMap<u32, u32>,
+    live: HashSet<u32>,
+    pending_dirty: HashSet<u32>,
+    first_style: bool,
+    rules_dirty: bool,
+    /// CC rule ids belonging to each host rule (selector list → many CC rules).
+    host_to_cc_rules: HashMap<u32, Vec<i32>>,
+    /// Decls that arrived before `add_style_rule` stored a CC mapping.
+    pending_rule_decls: HashMap<u32, (Vec<u16>, Vec<bool>, Vec<String>)>,
+    deltas: Vec<FfiStyleDelta>,
+    hover_atom: u32,
+    /// Last owning take is serving CC used/match consume; overlay reads CC buckets.
+    serve_matches: bool,
+    /// Per-node digest of last CC used style. Unchanged used values are a stop.
+    last_used_digest: HashMap<u32, u64>,
+}
+
+unsafe impl Send for HostState {}
+
+static HOSTS: LazyLock<Mutex<HashMap<usize, HostState>>> = LazyLock::new(|| Mutex::new(HashMap::new()));
+static OWN_TAKE: OnceLock<bool> = OnceLock::new();
+static OWN_MODE: OnceLock<&'static str> = OnceLock::new();
+
+/// Consume/signature must not take HOSTS: StyleBench materializes thousands of nodes per step.
+static SERVE_ENGINE: AtomicUsize = AtomicUsize::new(0);
+static SERVE_CC: AtomicPtr<StyleCC> = AtomicPtr::new(std::ptr::null_mut());
+static SERVE_ON: AtomicBool = AtomicBool::new(false);
+
+fn key(engine: *mut c_void) -> usize {
+    engine as usize
+}
+
+fn own_take() -> bool {
+    *OWN_TAKE.get_or_init(|| {
+        std::env::var_os("STYLECC_OWN_TAKE").is_some() && std::env::var_os("STYLECC_FORWARD").is_none()
+    })
+}
+
+/// Bisect OWN_TAKE hang without rebuild churn:
+///   STYLECC_OWN_MODE=index      — index_rules only, keep Rust answers
+///   STYLECC_OWN_MODE=dirty      — + style_dirty/take_dirty, keep Rust answers
+///   STYLECC_OWN_MODE=full|unset — used-style overlay; skip Rust matching on that batch
+fn own_mode() -> &'static str {
+    *OWN_MODE.get_or_init(|| match std::env::var("STYLECC_OWN_MODE").ok().as_deref() {
+        Some("index") => "index",
+        Some("dirty") => "dirty",
+        _ => "full",
+    })
+}
+
+fn publish_serve(engine: *mut c_void, cc: *mut StyleCC, on: bool) {
+    let e = key(engine);
+    if on {
+        SERVE_CC.store(cc, Ordering::Release);
+        SERVE_ENGINE.store(e, Ordering::Release);
+        SERVE_ON.store(true, Ordering::Release);
+    } else if SERVE_ENGINE.load(Ordering::Acquire) == e {
+        SERVE_ON.store(false, Ordering::Release);
+    }
+}
+
+fn serve_cc(engine: *mut c_void) -> Option<*mut StyleCC> {
+    if !own_take() || !SERVE_ON.load(Ordering::Acquire) {
+        return None;
+    }
+    if SERVE_ENGINE.load(Ordering::Acquire) != key(engine) {
+        return None;
+    }
+    let cc = SERVE_CC.load(Ordering::Acquire);
+    if cc.is_null() {
+        None
+    } else {
+        Some(cc)
+    }
+}
+
+fn write_ffi_matches(node: u32, tmp: &[StyleCCMatch], out: *mut FfiRuleMatch, n: usize) {
+    for (i, m) in tmp.iter().take(n).enumerate() {
+        unsafe {
+            *out.add(i) = FfiRuleMatch {
+                node,
+                rule: m.rule_id as u32,
+                semantic_declaration: 0,
+                pseudo_element: if m.pelem == 0 { u32::MAX } else { u32::from(m.pelem) },
+                scope_host: 0,
+                scope_proximity: u32::MAX,
+            };
+        }
+    }
+}
+
+fn utf16_to_utf8(units: &[u16]) -> String {
+    String::from_utf16_lossy(units)
+}
+
+fn format_css_number(value: f64) -> String {
+    if value.is_finite() && value.fract() == 0.0 && value.abs() < 1e15 {
+        format!("{}", value as i64)
+    } else {
+        format!("{value}")
+    }
+}
+
+fn fly_raw_to_utf8(raw: usize) -> Option<String> {
+    if raw == 0 {
+        return None;
+    }
+    // SAFETY: raw is a live Utf16FlyString identity from C++ / RetainedUtf16FlyString.
+    match unsafe { ak::utf16_string_units(&raw) } {
+        ak::Utf16StringUnits::Ascii(bytes) => Some(String::from_utf8_lossy(bytes).into_owned()),
+        ak::Utf16StringUnits::Utf16(units) => Some(String::from_utf16_lossy(units)),
+    }
+}
+
+fn intern_utf8(cc: *mut StyleCC, s: &str) -> u32 {
+    if s.is_empty() {
+        return 0;
+    }
+    unsafe { stylecc_intern(cc, s.as_ptr() as *const c_char, s.len()) }
+}
+
+pub fn attach(engine: *mut c_void) {
+    let cc = unsafe { stylecc_create() };
+    if cc.is_null() {
+        eprintln!("stylecc_host: stylecc_create failed");
+        return;
+    }
+    let hover_atom = intern_utf8(cc, ":hover");
+    HOSTS.lock().unwrap().insert(
+        key(engine),
+        HostState {
+            cc,
+            atom_map: HashMap::new(),
+            children: HashMap::new(),
+            parent_of: HashMap::new(),
+            live: HashSet::new(),
+            pending_dirty: HashSet::new(),
+            first_style: true,
+            rules_dirty: false,
+            host_to_cc_rules: HashMap::new(),
+            pending_rule_decls: HashMap::new(),
+            deltas: Vec::new(),
+            hover_atom,
+            serve_matches: false,
+            last_used_digest: HashMap::new(),
+        },
+    );
+}
+
+pub fn detach(engine: *mut c_void) {
+    publish_serve(engine, std::ptr::null_mut(), false);
+    if let Some(state) = HOSTS.lock().unwrap().remove(&key(engine)) {
+        unsafe { stylecc_destroy(state.cc) };
+    }
+}
+
+/// Called from `style_engine_intern_atom` so feature deltas share real text with rules.
+pub fn register_atom(engine: *mut c_void, style_atom: u32, raw: usize) {
+    if style_atom == 0 {
+        return;
+    }
+    let mut hosts = HOSTS.lock().unwrap();
+    let Some(state) = hosts.get_mut(&key(engine)) else {
+        return;
+    };
+    if state.atom_map.contains_key(&style_atom) {
+        return;
+    }
+    let Some(text) = fly_raw_to_utf8(raw) else {
+        return;
+    };
+    let a = intern_utf8(state.cc, &text);
+    if a != 0 {
+        state.atom_map.insert(style_atom, a);
+    }
+}
+
+fn map_atom(state: &mut HostState, ladybird_atom: u32) -> u32 {
+    if ladybird_atom == 0 {
+        return 0;
+    }
+    if let Some(&a) = state.atom_map.get(&ladybird_atom) {
+        return a;
+    }
+    // Fallback only if register_atom never saw this id (should be rare).
+    let s = format!("a{ladybird_atom}");
+    let a = intern_utf8(state.cc, &s);
+    state.atom_map.insert(ladybird_atom, a);
+    a
+}
+
+fn intern_selector_units(state: &mut HostState, units: &[u16]) -> u32 {
+    let s = utf16_to_utf8(units);
+    intern_utf8(state.cc, &s)
+}
+
+fn remove_from_parent(state: &mut HostState, node: u32) {
+    if let Some(parent) = state.parent_of.remove(&node) {
+        if let Some(kids) = state.children.get_mut(&parent) {
+            kids.retain(|&n| n != node);
+        }
+    }
+}
+
+fn sibling_index_after(state: &HostState, parent: u32, prev_sib: u32) -> i32 {
+    let Some(kids) = state.children.get(&parent) else {
+        return if prev_sib == 0 { 0 } else { -1 };
+    };
+    if prev_sib == 0 {
+        return 0;
+    }
+    match kids.iter().position(|&n| n == prev_sib) {
+        Some(i) => (i + 1) as i32,
+        None => -1,
+    }
+}
+
+fn insert_child_local(state: &mut HostState, parent: u32, node: u32, prev_sib: u32) {
+    remove_from_parent(state, node);
+    let kids = state.children.entry(parent).or_default();
+    let idx = if prev_sib == 0 {
+        0
+    } else {
+        kids.iter().position(|&n| n == prev_sib).map(|i| i + 1).unwrap_or(kids.len())
+    };
+    if idx >= kids.len() {
+        kids.push(node);
+    } else {
+        kids.insert(idx, node);
+    }
+    state.parent_of.insert(node, parent);
+}
+
+pub fn mirror_apply_transaction(engine: *mut c_void, transaction: &FfiStyleInputTransaction) {
+    let mut hosts = HOSTS.lock().unwrap();
+    let Some(state) = hosts.get_mut(&key(engine)) else {
+        return;
+    };
+    let tree = unsafe {
+        if transaction.tree_delta_count == 0 {
+            &[]
+        } else {
+            std::slice::from_raw_parts(transaction.tree_deltas, transaction.tree_delta_count)
+        }
+    };
+    for d in tree {
+        if d.new_connected {
+            let parent = if d.new_relations.parent == 0 {
+                u32::MAX
+            } else {
+                d.new_relations.parent
+            };
+            let prev = d.new_relations.previous_element_sibling;
+            let sib_idx = if parent == u32::MAX {
+                -1
+            } else {
+                let idx = sibling_index_after(state, parent, prev);
+                insert_child_local(state, parent, d.node, prev);
+                idx
+            };
+            unsafe {
+                stylecc_set_connected(state.cc, d.node, 1, parent, sib_idx);
+            }
+            state.live.insert(d.node);
+            state.pending_dirty.insert(d.node);
+        } else if d.old_connected && !d.new_connected {
+            remove_from_parent(state, d.node);
+            unsafe {
+                stylecc_set_connected(state.cc, d.node, 0, u32::MAX, -1);
+            }
+            state.live.remove(&d.node);
+            state.last_used_digest.remove(&d.node);
+            state.pending_dirty.insert(d.node);
+        }
+    }
+    let feats = unsafe {
+        if transaction.local_feature_delta_count == 0 {
+            &[]
+        } else {
+            std::slice::from_raw_parts(
+                transaction.local_feature_deltas,
+                transaction.local_feature_delta_count,
+            )
+        }
+    };
+    for f in feats {
+        let kind = match f.feature_kind {
+            FfiFeatureKind::TagName | FfiFeatureKind::FoldedTagName => 0,
+            FfiFeatureKind::Id => 1,
+            FfiFeatureKind::Class => 2,
+            FfiFeatureKind::Attribute => 3,
+            FfiFeatureKind::Emptiness => continue,
+        };
+        let present = !matches!(f.new_kind, FfiFeatureValueKind::Absent);
+        let name = map_atom(state, f.name_atom);
+        let value = map_atom(state, f.new_atom);
+        unsafe {
+            stylecc_apply_feature(state.cc, f.node, kind, name, value, i32::from(present));
+            stylecc_mark_dirty(state.cc, f.node);
+        }
+        state.pending_dirty.insert(f.node);
+    }
+    let states = unsafe {
+        if transaction.state_delta_count == 0 {
+            &[]
+        } else {
+            std::slice::from_raw_parts(transaction.state_deltas, transaction.state_delta_count)
+        }
+    };
+    for s in states {
+        if s.fact != FfiStateFact::Hover {
+            continue;
+        }
+        let hover = state.hover_atom;
+        unsafe {
+            stylecc_apply_feature(
+                state.cc,
+                s.node,
+                STYLECC_FEAT_CLASS,
+                hover,
+                0,
+                i32::from(s.new_value),
+            );
+            stylecc_mark_dirty(state.cc, s.node);
+        }
+        state.pending_dirty.insert(s.node);
+    }
+    let inputs = unsafe {
+        if transaction.element_style_input_count == 0 {
+            &[]
+        } else {
+            std::slice::from_raw_parts(
+                transaction.element_style_inputs,
+                transaction.element_style_input_count,
+            )
+        }
+    };
+    for input in inputs {
+        unsafe {
+            stylecc_mark_dirty(state.cc, input.style_node);
+        }
+        state.pending_dirty.insert(input.style_node);
+    }
+}
+
+pub fn set_viewport(engine: *mut c_void, width_px: f64) {
+    let hosts = HOSTS.lock().unwrap();
+    if let Some(state) = hosts.get(&key(engine)) {
+        unsafe {
+            stylecc_set_viewport_width(state.cc, width_px as i32);
+        }
+    }
+}
+
+fn note_drop(state: &HostState, reason: &str) {
+    unsafe {
+        stylecc_note_drop(state.cc, reason.as_ptr() as *const c_char);
+    }
+}
+
+/// Translate one StyleBench-shaped selector into a StyleCC rule. Returns CC rule id or None.
+fn try_add_compiled_selector(state: &mut HostState, sel: &CompiledSelector) -> Option<i32> {
+    if sel.target_pseudo_element.is_some() {
+        note_drop(state, "pseudo-element\0");
+        return None;
+    }
+    let n = sel.compound_selectors.len();
+    if n == 0 || n > 16 {
+        note_drop(state, "compounds\0");
+        return None;
+    }
+    let mut class_storage: Vec<Vec<u32>> = Vec::with_capacity(n);
+    let mut attr_name_storage: Vec<Vec<u32>> = Vec::with_capacity(n);
+    let mut attr_value_storage: Vec<Vec<u32>> = Vec::with_capacity(n);
+    let mut attr_eq_storage: Vec<Vec<u8>> = Vec::with_capacity(n);
+    let mut compounds: Vec<StyleCCCompound> = Vec::with_capacity(n);
+    let mut combs: Vec<u8> = Vec::new();
+
+    for (i, compound) in sel.compound_selectors.iter().enumerate() {
+        if i > 0 {
+            let comb = match compound.combinator {
+                Combinator::Descendant => STYLECC_COMB_DESC,
+                Combinator::ImmediateChild => STYLECC_COMB_CHILD,
+                Combinator::NextSibling => STYLECC_COMB_NEXT,
+                Combinator::SubsequentSibling => STYLECC_COMB_SUBSEQ,
+                Combinator::None => STYLECC_COMB_DESC,
+                Combinator::Column | Combinator::PseudoElement => {
+                    note_drop(state, "combinator\0");
+                    return None;
+                }
+            };
+            combs.push(comb);
+        } else if !matches!(compound.combinator, Combinator::None) {
+            note_drop(state, "leading-combinator\0");
+            return None;
+        }
+
+        let mut type_atom = 0u32;
+        let mut id_atom = 0u32;
+        let mut classes: Vec<u32> = Vec::new();
+        let mut attr_names: Vec<u32> = Vec::new();
+        let mut attr_values: Vec<u32> = Vec::new();
+        let mut attr_eq: Vec<u8> = Vec::new();
+
+        for simple in compound.simple_selectors.iter() {
+            match simple {
+                SimpleSelector::Universal(qname) => {
+                    if !matches!(qname.namespace_type, NamespaceType::Default | NamespaceType::Any | NamespaceType::None)
+                    {
+                        note_drop(state, "ns\0");
+                        return None;
+                    }
+                }
+                SimpleSelector::TagName(qname) => {
+                    if !matches!(qname.namespace_type, NamespaceType::Default | NamespaceType::None) {
+                        note_drop(state, "ns\0");
+                        return None;
+                    }
+                    type_atom = intern_selector_units(state, &qname.lowercase_name);
+                }
+                SimpleSelector::Id(name) => {
+                    id_atom = intern_selector_units(state, &name.name);
+                }
+                SimpleSelector::Class(name) => {
+                    classes.push(intern_selector_units(state, &name.name));
+                }
+                SimpleSelector::Attribute(attr) => {
+                    if !matches!(
+                        attr.qualified_name.namespace_type,
+                        NamespaceType::Default | NamespaceType::None
+                    ) {
+                        note_drop(state, "attr-ns\0");
+                        return None;
+                    }
+                    match attr.match_type {
+                        AttributeMatchType::HasAttribute => {
+                            attr_names.push(intern_selector_units(state, &attr.qualified_name.lowercase_name));
+                            attr_values.push(0);
+                            attr_eq.push(0);
+                        }
+                        AttributeMatchType::ExactValue => {
+                            attr_names.push(intern_selector_units(state, &attr.qualified_name.lowercase_name));
+                            attr_values.push(intern_selector_units(state, &attr.value));
+                            attr_eq.push(1);
+                        }
+                        _ => {
+                            note_drop(state, "attr-op\0");
+                            return None;
+                        }
+                    }
+                }
+                SimpleSelector::PseudoClass(_)
+                | SimpleSelector::PseudoElement(_)
+                | SimpleSelector::Nesting
+                | SimpleSelector::Invalid(_) => {
+                    note_drop(state, "simple\0");
+                    return None;
+                }
+            }
+        }
+
+        class_storage.push(classes);
+        attr_name_storage.push(attr_names);
+        attr_value_storage.push(attr_values);
+        attr_eq_storage.push(attr_eq);
+        let ci = class_storage.len() - 1;
+        compounds.push(StyleCCCompound {
+            type_atom,
+            id_atom,
+            class_atoms: class_storage[ci].as_ptr(),
+            nclass: class_storage[ci].len(),
+            attr_name_atoms: attr_name_storage[ci].as_ptr(),
+            attr_value_atoms: attr_value_storage[ci].as_ptr(),
+            attr_equals: attr_eq_storage[ci].as_ptr(),
+            nattr: attr_name_storage[ci].len(),
+            pos_mask: 0,
+            pelem: STYLECC_PE_NONE,
+        });
+    }
+
+    let combs_ptr = if combs.is_empty() {
+        std::ptr::null()
+    } else {
+        combs.as_ptr()
+    };
+    let rid = unsafe {
+        stylecc_add_rule(
+            state.cc,
+            compounds.as_ptr(),
+            compounds.len(),
+            combs_ptr,
+            STYLECC_ORIGIN_AUTHOR,
+            -1,
+            STYLECC_PE_NONE,
+        )
+    };
+    if rid < 0 {
+        note_drop(state, "add_rule\0");
+        return None;
+    }
+    state.rules_dirty = true;
+    // Keep class/attr vectors alive through the FFI call — they are already consumed.
+    let _ = (class_storage, attr_name_storage, attr_value_storage, attr_eq_storage);
+    Some(rid)
+}
+
+pub fn mirror_add_style_rule(engine: *mut c_void, host_rule: u32, selectors: &[&CompiledSelector]) {
+    if host_rule == 0 || selectors.is_empty() {
+        return;
+    }
+    let mut hosts = HOSTS.lock().unwrap();
+    let Some(state) = hosts.get_mut(&key(engine)) else {
+        return;
+    };
+    let mut cc_ids = Vec::new();
+    for sel in selectors {
+        let rid = try_add_compiled_selector(state, sel);
+        if let Some(rid) = rid {
+            unsafe {
+                stylecc_set_rule_host_id(state.cc, rid, host_rule);
+            }
+            cc_ids.push(rid);
+        }
+    }
+    if !cc_ids.is_empty() {
+        state.host_to_cc_rules.insert(host_rule, cc_ids);
+        if let Some((properties, important, value_texts)) = state.pending_rule_decls.remove(&host_rule) {
+            install_cc_rule_decls(state, host_rule, &properties, &important, &value_texts);
+        }
+    }
+}
+
+/// CSS text for a specified value, as CC `take_decl` wants it: typed
+/// length/keyword cells first (same tokens StyleBench feeds), then authored
+/// source for unresolved values, otherwise serialization.
+pub fn css_text_for_style_value(value: *const c_void) -> String {
+    if value.is_null() {
+        return String::new();
+    }
+    let data = unsafe { &*value.cast::<StyleValueData>() };
+    match data {
+        StyleValueData::Length { value, unit } => {
+            let unit_name = LENGTH_UNIT_NAMES
+                .get(*unit as usize)
+                .copied()
+                .unwrap_or("px");
+            return format!("{}{unit_name}", format_css_number(*value));
+        }
+        StyleValueData::Percentage { value } => {
+            return format!("{}%", format_css_number(*value));
+        }
+        StyleValueData::Keyword { keyword: code } => {
+            if let Some(name) = keyword::NAMES.get(*code as usize) {
+                return (*name).to_string();
+            }
+        }
+        StyleValueData::Display { .. } => {
+            return crate::css::serialize::serialize_style_value_to_utf16(data)
+                .map(|units| String::from_utf16_lossy(&units))
+                .unwrap_or_default();
+        }
+        StyleValueData::Number { value } => return format_css_number(*value),
+        StyleValueData::Integer { value } => return value.to_string(),
+        StyleValueData::Unresolved { .. } => {
+            if let Some(src) = data.unresolved_authored_source() {
+                let text = match src {
+                    crate::css::css_tokenizer::TokenizerInput::Ascii(units) => {
+                        String::from_utf8_lossy(units).into_owned()
+                    }
+                    crate::css::css_tokenizer::TokenizerInput::Utf16(units) => String::from_utf16_lossy(units),
+                };
+                if !text.is_empty() {
+                    return text;
+                }
+            }
+        }
+        _ => {}
+    }
+    crate::css::serialize::serialize_style_value_to_utf16(data)
+        .map(|units| String::from_utf16_lossy(&units))
+        .unwrap_or_default()
+}
+
+fn cc_decl_text_ok(text: &str) -> bool {
+    let t = text.trim();
+    if t.is_empty() {
+        return false;
+    }
+    matches!(
+        t,
+        "auto"
+            | "normal"
+            | "none"
+            | "initial"
+            | "max-content"
+            | "min-content"
+            | "fit-content"
+            | "bolder"
+            | "lighter"
+            | "inline"
+            | "block"
+            | "inline-block"
+            | "contents"
+            | "flow-root"
+            | "flex"
+            | "grid"
+            | "list-item"
+            | "table"
+    ) || t.ends_with("px")
+        || t.ends_with("em")
+        || t.ends_with("rem")
+        || t.ends_with('%')
+        || t.bytes().all(|c| c.is_ascii_digit() || c == b'.' || c == b'-' || c == b'+')
+}
+
+/// Specified CSS text `take_decl` can parse. Prefer a typed length/keyword on
+/// either the original or canonical pointer; skip host-only keywords (`larger`).
+pub fn pick_cc_decl_text(original: *const c_void, canonical: *const c_void) -> String {
+    let orig = css_text_for_style_value(original);
+    let canon = css_text_for_style_value(canonical);
+    if cc_decl_text_ok(&orig) {
+        orig
+    } else if cc_decl_text_ok(&canon) {
+        canon
+    } else if !orig.is_empty() {
+        orig
+    } else {
+        canon
+    }
+}
+
+fn install_cc_rule_decls(
+    state: &mut HostState,
+    host_rule: u32,
+    properties: &[u16],
+    important: &[bool],
+    value_texts: &[String],
+) {
+    let Some(cc_ids) = state.host_to_cc_rules.get(&host_rule).cloned() else {
+        return;
+    };
+    let mut names: Vec<String> = Vec::with_capacity(properties.len());
+    let mut values: Vec<String> = Vec::with_capacity(properties.len());
+    let mut decls: Vec<StyleCCDecl> = Vec::with_capacity(properties.len());
+    for (i, &prop) in properties.iter().enumerate() {
+        let text = value_texts.get(i).map(String::as_str).unwrap_or("");
+        let pname = property_name(prop);
+        if text.is_empty() {
+            continue;
+        }
+        names.push(property_name(prop).to_string());
+        values.push(text.to_string());
+        let name_ref = names.last().unwrap();
+        let value_ref = values.last().unwrap();
+        decls.push(StyleCCDecl {
+            prop: name_ref.as_ptr() as *const c_char,
+            prop_len: name_ref.len(),
+            value: value_ref.as_ptr() as *const c_char,
+            value_len: value_ref.len(),
+            important: u8::from(important.get(i).copied().unwrap_or(false)),
+        });
+    }
+    if decls.is_empty() {
+        return;
+    }
+    for rid in cc_ids {
+        unsafe {
+            let _ = stylecc_set_rule_decls(state.cc, rid, decls.as_ptr(), decls.len());
+        }
+    }
+    state.rules_dirty = true;
+    let _ = (names, values);
+}
+
+/// Install specified longhands on the mirrored CC rules. Values are CSS text CC can parse.
+pub fn mirror_set_rule_declared_properties(
+    engine: *mut c_void,
+    host_rule: u32,
+    properties: &[u16],
+    important: &[bool],
+    value_texts: &[String],
+) {
+    if host_rule == 0 || properties.is_empty() {
+        return;
+    }
+    let mut hosts = HOSTS.lock().unwrap();
+    let Some(state) = hosts.get_mut(&key(engine)) else {
+        return;
+    };
+    if !state.host_to_cc_rules.contains_key(&host_rule) {
+        state.pending_rule_decls.insert(
+            host_rule,
+            (properties.to_vec(), important.to_vec(), value_texts.to_vec()),
+        );
+        return;
+    }
+    install_cc_rule_decls(state, host_rule, properties, important, value_texts);
+}
+
+pub fn owning_answers(
+    engine: *mut c_void,
+    computation_inputs: FfiDocumentStyleComputationInputs,
+) -> Option<Vec<FfiStyleDelta>> {
+    if !own_take() {
+        return None;
+    }
+    let mode = own_mode();
+    let mut hosts = HOSTS.lock().unwrap();
+    let state = hosts.get_mut(&key(engine))?;
+    state.serve_matches = false;
+    publish_serve(engine, state.cc, false);
+    let cc = state.cc;
+    unsafe {
+        stylecc_set_viewport_width(cc, computation_inputs.viewport_width as i32);
+    }
+    if state.rules_dirty {
+        // Drop HOSTS across index: if CC ever re-entered the host we would deadlock.
+        state.rules_dirty = false;
+        drop(hosts);
+        let rc = unsafe { stylecc_index_rules(cc) };
+        if rc != 0 {
+            eprintln!("stylecc_host: index_rules failed ({rc})");
+        }
+        if mode == "index" {
+            return None;
+        }
+        hosts = HOSTS.lock().unwrap();
+        let Some(state) = hosts.get_mut(&key(engine)) else {
+            return None;
+        };
+        if state.first_style {
+            state.first_style = false;
+            drop(hosts);
+            // Warm used style (match + inherit) without Install. Ladybird rematch
+            // owns this pass. style_all is serial in the host engine (no_parallel).
+            let rc = unsafe { stylecc_style_all(cc) };
+            if rc != 0 {
+                eprintln!("stylecc_host: style_all warm failed ({rc})");
+            }
+            return None;
+        }
+        let pending: Vec<u32> = state.pending_dirty.drain().collect();
+        let live_cap = state.live.len().saturating_mul(2).max(1024);
+        drop(hosts);
+        return owning_answers_dirty(engine, cc, pending, live_cap, mode);
+    }
+    if state.first_style {
+        state.first_style = false;
+        drop(hosts);
+        let rc = unsafe { stylecc_style_all(cc) };
+        if rc != 0 {
+            eprintln!("stylecc_host: style_all warm failed ({rc})");
+        }
+        return None;
+    }
+    if mode == "index" {
+        return None;
+    }
+    let pending: Vec<u32> = state.pending_dirty.drain().collect();
+    let live_cap = state.live.len().saturating_mul(2).max(1024);
+    drop(hosts);
+    owning_answers_dirty(engine, cc, pending, live_cap, mode)
+}
+
+fn owning_answers_dirty(
+    engine: *mut c_void,
+    cc: *mut StyleCC,
+    pending: Vec<u32>,
+    live_cap: usize,
+    mode: &str,
+) -> Option<Vec<FfiStyleDelta>> {
+    for n in pending {
+        unsafe {
+            stylecc_mark_dirty(cc, n);
+        }
+    }
+    let rc = unsafe { stylecc_style_dirty(cc) };
+    if rc != 0 {
+        eprintln!("stylecc_host: style_dirty failed ({rc})");
+        return None;
+    }
+    let n = unsafe { stylecc_used_count(cc) };
+    if n == 0 || n > live_cap {
+        return None;
+    }
+    let mut buf = vec![0u32; n];
+    let got = unsafe { stylecc_take_used(cc, buf.as_mut_ptr(), buf.len()) };
+    buf.truncate(got.min(buf.len()));
+    if mode == "dirty" {
+        return None;
+    }
+    let mut hosts = HOSTS.lock().unwrap();
+    let state = hosts.get_mut(&key(engine))?;
+    state.serve_matches = true;
+    publish_serve(engine, cc, true);
+    Some(materialize_deltas(state, buf))
+}
+
+fn materialize_deltas(state: &mut HostState, nodes: Vec<u32>) -> Vec<FfiStyleDelta> {
+    let mut deltas = Vec::with_capacity(nodes.len());
+    for node in nodes {
+        if node == 0 {
+            continue;
+        }
+        // Must match UpdateStyle.cpp make_materialize_gap_delta: Materialize + damage None.
+        // damage Full trips the gap contract and, with a wholesale answer replace, can leave
+        // update_style reaction passes without a PublishedStyle termination path.
+        deltas.push(FfiStyleDelta {
+            style_node: node,
+            match_answer: 0,
+            old_style_record: 0,
+            new_style_record: 0,
+            damage: FfiStyleDeltaDamage::None,
+            reaction: RECOMPUTE_STYLE,
+            inherited_style_groups: 0,
+            pseudo_kind: u8::MAX,
+            gap: FfiStyleDeltaGap::Materialize,
+        });
+    }
+    state.deltas = deltas.clone();
+    deltas
+}
+
+pub fn serves_published(engine: *mut c_void, host_id: u32) -> bool {
+    let Some(cc) = serve_cc(engine) else {
+        return false;
+    };
+    unsafe { stylecc_node_restyled(cc, host_id) != 0 }
+}
+
+pub fn pull_used_for(engine: *mut c_void, nodes: &[u32]) -> Option<Vec<(u32, StyleCCUsed)>> {
+    let cc = serve_cc(engine)?;
+    let mut out = Vec::with_capacity(nodes.len());
+    for &node in nodes {
+        if node == 0 {
+            continue;
+        }
+        let mut used = StyleCCUsed {
+            host_node: 0,
+            r: 0,
+            g: 0,
+            b: 0,
+            a: 0,
+            bgra: 0,
+            display: 0,
+            height_auto: 0,
+            min_width_auto: 0,
+            line_height_normal: 0,
+            height_px: 0.0,
+            min_width_px: 0.0,
+            font_size_px: 0.0,
+            line_height_px: 0.0,
+            digest: 0,
+        };
+        if unsafe { stylecc_consume_node_used(cc, node, &mut used) } != 0 {
+            continue;
+        }
+        used.host_node = node;
+        out.push((node, used));
+    }
+    Some(out)
+}
+
+pub fn split_used_stops(
+    engine: *mut c_void,
+    pulled: Vec<(u32, StyleCCUsed)>,
+    has_published: impl Fn(u32) -> bool,
+) -> (Vec<(u32, StyleCCUsed)>, usize, usize) {
+    let mut hosts = HOSTS.lock().unwrap();
+    let Some(state) = hosts.get_mut(&key(engine)) else {
+        return (pulled, 0, 0);
+    };
+    let mut changed = Vec::with_capacity(pulled.len());
+    let mut stopped = 0usize;
+    let mut recycled = 0usize;
+    for (node, used) in pulled {
+        let digest_matches = state.last_used_digest.get(&node) == Some(&used.digest);
+        if digest_matches && has_published(node) {
+            stopped += 1;
+            continue;
+        }
+        if digest_matches {
+            recycled += 1;
+        }
+        state.last_used_digest.insert(node, used.digest);
+        changed.push((node, used));
+    }
+    (changed, stopped, recycled)
+}
+
+pub fn stop_serving(engine: *mut c_void) {
+    publish_serve(engine, std::ptr::null_mut(), false);
+}
+
+pub struct CcOwnedPublish {
+    pub interned: bool,
+    pub deltas: Vec<FfiStyleDelta>,
+}
+
+impl CcOwnedPublish {
+    pub fn failed() -> Self {
+        Self {
+            interned: false,
+            deltas: Vec::new(),
+        }
+    }
+}
+
+pub fn consume_published(
+    engine: *mut c_void,
+    node: u32,
+    out: *mut FfiRuleMatch,
+    capacity: usize,
+) -> Option<usize> {
+    let cc = serve_cc(engine)?;
+    if unsafe { stylecc_node_restyled(cc, node) == 0 } {
+        return None;
+    }
+    const STACK: usize = 32;
+    let mut stack = [StyleCCMatch {
+        host_node: 0,
+        rule_id: 0,
+        pelem: 0,
+    }; STACK];
+    let fill_cap = capacity.min(STACK);
+    let n = unsafe { stylecc_consume_node_matches(cc, node, stack.as_mut_ptr(), fill_cap) };
+    if n > capacity {
+        return Some(n);
+    }
+    if n <= STACK {
+        write_ffi_matches(node, &stack, out, n);
+        return Some(n);
+    }
+    let mut tmp = vec![
+        StyleCCMatch {
+            host_node: 0,
+            rule_id: 0,
+            pelem: 0,
+        };
+        n
+    ];
+    let _ = unsafe { stylecc_consume_node_matches(cc, node, tmp.as_mut_ptr(), tmp.len()) };
+    write_ffi_matches(node, &tmp, out, n);
+    Some(n)
+}
+
+pub fn drop_count(engine: *mut c_void) -> u64 {
+    let hosts = HOSTS.lock().unwrap();
+    hosts
+        .get(&key(engine))
+        .map(|s| unsafe { stylecc_drop_count(s.cc) })
+        .unwrap_or(0)
+}
+
+pub fn ensure_node(engine: *mut c_void, host_id: u32) {
+    let mut hosts = HOSTS.lock().unwrap();
+    if let Some(state) = hosts.get_mut(&key(engine)) {
+        unsafe {
+            stylecc_ensure_node(state.cc, host_id);
+        }
+        state.live.insert(host_id);
+    }
+}
