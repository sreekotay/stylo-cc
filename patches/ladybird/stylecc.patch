+/*
+ * Concurrent-C StyleEngine host for Ladybird (stylo-cc seam).
+ *
+ * With feature `stylecc`, every StyleEngine owns a StyleCC mirror. Transactions
+ * and StyleBench-shaped rules update both. Default: Rust still owns take
+ * (mirror-only). Set STYLECC_OWN_TAKE=1 to let CC own cascade: skip Rust
+ * take, overlay used values onto interned style records, Install without rematch.
+ * STYLECC_FORWARD=1 forces mirror-only.
+ */
+
+use super::bridge::{
+    FfiDocumentStyleComputationInputs, FfiFeatureKind, FfiFeatureValueKind, FfiRuleMatch, FfiStateFact,
+    FfiStyleDelta, FfiStyleDeltaDamage, FfiStyleDeltaGap, FfiStyleInputTransaction,
+};
+use crate::css::css_enums::keyword;
+use crate::css::property_metadata::property_name;
+use crate::css::selector::{
+    AttributeMatchType, Combinator, CompiledSelector, NamespaceType, SimpleSelector,
+};
+use crate::css::style_compute::LENGTH_UNIT_NAMES;
+use crate::css::style_value::StyleValueData;
+use std::collections::{HashMap, HashSet};
+use std::ffi::{c_char, c_void};
+use std::sync::atomic::{AtomicBool, AtomicPtr, AtomicUsize, Ordering};
+use std::sync::{LazyLock, Mutex, OnceLock};
+
+const RECOMPUTE_STYLE: u8 = 1 << 1;
+const STYLECC_ORIGIN_AUTHOR: i32 = 1;
+const STYLECC_COMB_DESC: u8 = 0;
+const STYLECC_COMB_CHILD: u8 = 1;
+const STYLECC_COMB_NEXT: u8 = 2;
+const STYLECC_COMB_SUBSEQ: u8 = 3;
+const STYLECC_PE_NONE: u8 = 0;
+const STYLECC_FEAT_CLASS: i32 = 2;
+
+#[repr(C)]
+struct StyleCC {
+    _private: [u8; 0],
+}
+
+#[repr(C)]
+struct StyleCCCompound {
+    type_atom: u32,
+    id_atom: u32,
+    class_atoms: *const u32,
+    nclass: usize,
+    attr_name_atoms: *const u32,
+    attr_value_atoms: *const u32,
+    attr_equals: *const u8,
+    nattr: usize,
+    pos_mask: u32,
+    pelem: u8,
+}
+
+#[repr(C)]
+struct StyleCCDecl {
+    prop: *const c_char,
+    prop_len: usize,
+    value: *const c_char,
+    value_len: usize,
+    important: u8,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct StyleCCMatch {
+    host_node: u32,
+    rule_id: i32,
+    pelem: u8,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct StyleCCUsed {
+    pub host_node: u32,
+    pub r: u8,
+    pub g: u8,
+    pub b: u8,
+    pub a: u8,
+    pub bgra: u32,
+    pub display: u8,
+    pub height_auto: u8,
+    pub min_width_auto: u8,
+    pub line_height_normal: u8,
+    pub height_px: f32,
+    pub min_width_px: f32,
+    pub font_size_px: f32,
+    pub line_height_px: f32,
+    pub digest: u64,
+}
